      "id": "py-rot",
      "type": "logic_python",
      "position": { "x": 48, "y": 490 },
      "width": 208,
      "height": 180,
      "data": {
        "label": "Rotation 20° → Image 2",
        "params": {
          "color_index": 2,
          "code": "# Synthetic 20° rotation — creates a second view from img1\n# Replace src-1 + src-2 with real scene photos to test RANSAC outlier rejection\nif a is not None and isinstance(a, np.ndarray):\n    h, w = a.shape[:2]\n    M = cv2.getRotationMatrix2D((w / 2, h / 2), 20, 0.92)\n    out_a = cv2.warpAffine(a, M, (w, h), borderMode=cv2.BORDER_REFLECT)"
        }
      }
    },
