    {
      "id": "py-u",
      "type": "logic_python",
      "position": {
        "x": 620,
        "y": 100
      },
      "data": {
        "label": "dU / dt",
        "params": {
          "code": "# Gray-Scott — U channel update\n# a = U_prev, b = V_prev\nU = a.astype(np.float32) if a is not None else np.ones((256,256), dtype=np.float32)\nV = b.astype(np.float32) if b is not None else np.zeros((256,256), dtype=np.float32)\nif U.max() > 1.0: U /= 255.0\nif V.max() > 1.0: V /= 255.0\nlap = np.array([[0,1,0],[1,-4,1],[0,1,0]], np.float32)\nlapU = cv2.filter2D(U, cv2.CV_32F, lap)\nuvv = U * V * V\nDu, f = 0.16, 0.055\nout_main = np.clip(U + Du*lapU - uvv + f*(1-U), 0, 1).astype(np.float32)\nout_scalar = 0.0\nout_list = []\nout_dict = {}\nout_any = None"
        }
      }
    },
    {
      "id": "py-v",
      "type": "logic_python",
      "position": {
        "x": 620,
        "y": 380
      },
      "data": {
        "label": "dV / dt",
        "params": {
          "code": "# Gray-Scott — V channel update\n# a = U_prev, b = V_prev\nU = a.astype(np.float32) if a is not None else np.ones((256,256), dtype=np.float32)\nV = b.astype(np.float32) if b is not None else np.zeros((256,256), dtype=np.float32)\nif U.max() > 1.0: U /= 255.0\nif V.max() > 1.0: V /= 255.0\nlap = np.array([[0,1,0],[1,-4,1],[0,1,0]], np.float32)\nlapV = cv2.filter2D(V, cv2.CV_32F, lap)\nuvv = U * V * V\nDv, f, k = 0.08, 0.055, 0.062\nout_main = np.clip(V + Dv*lapV + uvv - (f+k)*V, 0, 1).astype(np.float32)\nout_scalar = 0.0\nout_list = []\nout_dict = {}\nout_any = None"
        }
      }
    },
