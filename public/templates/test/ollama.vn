    {
      "id": "node-1780605163073-kkywa255f",
      "type": "llm_inference",
      "position": {
        "x": 840,
        "y": 520
      },
      "style": {},
      "data": {
        "label": "LLM Inference",
        "params": {
          "provider": 1,
          "api_key": "1396d50b19444b32b1a5e8ec37aef3aa.amS74n7vqNtHnqkV0duenz35",
          "system_prompt": "You are a precise computer vision assistant. Your task is to analyze the provided image where objects (stones and brick fragments) have been annotated with bounding boxes and IDs.",
          "user_prompt": "Classify each detected ID into one of the following structural/geological categories based on its visual appearance: - \"river_cobble\" (rounded, smooth grey/greenish stones) - \"brick_fragment\" (red/orange terracotta pieces) - \"irregular_fieldstone\" (rough, angular masonry stones) - \"schist_stone\" (dark, layered, or flat stones)  Output ONLY a valid Python dictionary where the keys are the categories and the values are lists of integers representing the detected IDs.   Do not include any introduction, formatting code blocks (like ```python), markdown, or conversational text. Output raw text only.  Example of expected output format: {\"river_cobble\": [1, 2, 5], \"brick_fragment\": [3, 4, 7], \"irregular_fieldstone\": [6, 8], \"schist_stone\": [9]}",
          "run": 0,
          "model": "gemma4:31b",
          "max_tokens": 2112,
          "timeout": 60
        },
        "schema": {
          "type": "llm_inference",
          "label": "LLM Inference",
          "category": "logic",
          "icon": "BrainCircuit",
          "description": "Universal LLM node — connects to Ollama (local) or cloud providers (OpenAI, Anthropic, Groq, Custom OpenAI-compatible). Supports text and vision (image) inputs. JSON mode parses structured output into a dict port. API keys are persisted locally.",
          "inputs": [
            {
              "id": "image",
              "color": "image",
              "label": "Image (vision)"
            },
            {
              "id": "prompt",
              "color": "string",
              "label": "User Prompt"
            },
            {
              "id": "context",
              "color": "dict",
              "label": "Context (injected as JSON)"
            }
          ],
          "outputs": [
            {
              "id": "text",
              "color": "string",
              "label": "Response Text"
            },
            {
              "id": "json_data",
              "color": "dict",
              "label": "JSON Data"
            },
            {
              "id": "tokens",
              "color": "scalar",
              "label": "Tokens Used"
            }
          ],
          "params": [
            {
              "id": "run",
              "label": "Run",
              "type": "trigger",
              "default": false
            },
            {
              "id": "provider",
              "label": "Provider",
              "type": "enum",
              "options": [
                "Ollama (local)",
                "Ollama (cloud)",
                "OpenAI",
                "Anthropic",
                "Groq",
                "Custom"
              ],
              "default": 0
            },
            {
              "id": "model",
              "label": "Model",
              "type": "string",
              "default": "llava"
            },
            {
              "id": "api_key",
              "label": "API Key",
              "type": "string",
              "default": ""
            },
            {
              "id": "base_url",
              "label": "Custom Base URL",
              "type": "string",
              "default": ""
            },
            {
              "id": "system_prompt",
              "label": "System Prompt",
              "type": "string",
              "default": "You are a helpful vision assistant. Be concise."
            },
            {
              "id": "user_prompt",
              "label": "User Prompt (param)",
              "type": "string",
              "default": "Describe what you see."
            },
            {
              "id": "json_mode",
              "label": "JSON Mode",
              "type": "bool",
              "default": false
            },
            {
              "id": "temperature",
              "label": "Temperature",
              "type": "float",
              "default": 0.7,
              "min": 0,
              "max": 2,
              "step": 0.05
            },
            {
              "id": "max_tokens",
