    {
      "id": "logic_compression",
      "type": "logic_python",
      "position": {
        "x": 120,
        "y": 480
      },
      "width": 280,
      "height": 180,
      "data": {
        "label": "Python Node",
        "params": {
          "code": "# TD6 — Exercice 5 : Taux de compression PCA vs U-Net\n# Entrée a = meta (dict depuis geo_netcdf_reader)\n# Modifiez k_pca et latent_unet selon vos nœuds !\n\ntry:\n    meta = a\nexcept NameError:\n    meta = None\n\nk_pca = 10        # n_components PCA\nn_latent = 16     # canaux latents U-Net (base)\nn_levels = 3      # niveaux U-Net\n\nif meta is None:\n    out_dict = {'statut': 'Branchez meta depuis le lecteur NetCDF'}\nelse:\n    shape = meta.get('shape', [0, 0, 0])\n    T, H, W = shape[0], shape[1], shape[2]\n    taille_orig = T * H * W\n\n    # PCA : T*k scores + k*H*W cartes\n    taille_pca = T * k_pca + k_pca * H * W\n    ratio_pca = taille_orig / taille_pca if taille_pca > 0 else 0\n\n    # U-Net : compte les feature maps à chaque niveau (approximation)\n    params_unet = sum(n_latent * (2**i) * (H // max(1, 2**i)) * (W // max(1, 2**i)) for i in range(n_levels))\n    ratio_unet = taille_orig / params_unet if params_unet > 0 else 0\n\n    out_dict = {\n        'T_x_H_x_W': f'{T} x {H} x {W} = {taille_orig:,}',\n        'compression_PCA': f'1:{round(ratio_pca, 1)} (k={k_pca})',\n        'compression_UNet': f'~1:{round(ratio_unet, 1)} (approximation)',\n        'avantage_UNet': 'Non-lineaire — peut capturer des structures complexes',\n        'avantage_PCA': 'Interpretable — modes spatiaux explicites (EOF)',\n    }\n    out_scalar = round(ratio_pca, 2)"
        },
        "ports": [
          {
            "id": "dict__a",
            "color": "dict",
            "label": "a"
          }
        ]
      },
      "selected": false,
      "positionAbsolute": {
        "x": 120,
        "y": 480
      },
