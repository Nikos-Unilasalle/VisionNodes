    {
      "id": "llm-1",
      "type": "llm_inference",
      "position": {
        "x": 900,
        "y": 280
      },
      "data": {
        "label": "Ollama — Classification pierres",
        "params": {
          "provider": 0,
          "model": "gemma4:e4b",
          "api_key": "",
          "base_url": "",
          "system_prompt": "You are an expert petrographer. You receive an image of a stone wall where each colored region is one individual stone segmented by AI. Analyze the visible stones and classify them by type based on color, texture, and morphology. Respond ONLY with valid JSON.",
          "user_prompt": "Classify the stone types visible in this segmented wall image. For each distinct stone type you can identify, give a name, visual description, and estimated count. Return JSON: {\"stone_types\": [{\"name\": \"...\", \"description\": \"...\", \"estimated_count\": N}], \"dominant_type\": \"...\", \"wall_notes\": \"...\"}",
          "json_mode": true,
          "temperature": 0.3,
          "max_tokens": 512,
          "timeout": 60
        }
      },
      "style": {
        "width": 300
      },
      "width": 300,
      "height": 138
    },
