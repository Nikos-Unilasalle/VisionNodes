      "position": { "x": 700, "y": 300 },
      "data": {
        "label": "ACOLITE (training scene)",
        "params": {
          "band_names": "Bleu,Vert,Rouge,NIR",
          "dsf_aot_estimate": 0,
          "run": 0
        }
      },
      "width": 280,
      "height": 240
    },

    {
      "id": "gt_sampler",
      "type": "geo_ground_truth_sampler",
      "position": { "x": 300, "y": 300 },
      "data": {
        "label": "Ground Truth Sampler",
        "params": {
          "csv_path": "",
          "lat_col": "lat",
          "lon_col": "lon",
          "target_col": "label",
          "band_names": "Bleu,Vert,Rouge,NIR",
          "target_min": 0.0,
          "target_max": 500.0,
          "mask_radius": 3
        }
      },
      "width": 300,
      "height": 280
    },

    {
      "id": "gp",
      "type": "ml_symbolic_regressor",
      "position": { "x": 300, "y": 620 },
      "data": {
        "label": "GP Symbolic Regressor (N=10)",
        "params": {
          "target_column": "label",
          "feature_columns": "Bleu,Vert,Rouge,NIR",
          "n_ensemble": 10,
          "population_size": 500,
          "generations": 30,
          "parsimony": 0.01,
          "test_size": 0.2,
          "log_transform": true,
          "use_log": true,
          "use_sqrt": true,
          "use_div": true,
          "seed": 42,
          "run": 0
        }
      },
      "width": 300,
      "height": 380
    },

