          "expr2_enable": true,
          "expr2_label": "AWEIsh",
          "expr2": "BLUE + 2.5*GREEN - 1.5*(NIR + SWIR) - 0.25*B6",
          "colormap": 0,
          "clamp_min": -5,
          "clamp_max": 5,
          "node_note": "ACOLITE Rrs. Band order: B1=Blue(492) B2=Green(559) B3=Red(665) B4=NIR(833) B5=SWIR1(1610) B6=SWIR2(2186). SWIR=SWIR1(B5). Stack output = [NDWI, MNDWI, AWEInsh, AWEIsh]."
        },
        "rotated": false
      },
