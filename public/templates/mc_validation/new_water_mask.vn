    {
      "id": "node-1782710392200-fj2ugkk3u",
      "type": "logic_python",
      "position": {
        "x": 740,
        "y": 1540
      },
      "style": {},
      "data": {
        "label": "Python Node",
        "params": {
          "code": "# a = acc_mean (carte P, image 0-255)\n# b = masque \"no_bridges\"  (eau libre = référence)\n# c = masque \"with_bridges\" (eau + tabliers)\nimport numpy as np\nfrom scipy.stats import rankdata, ks_2samp\n\ndef _gray(m):                       # image/mask -> 2D bool au seuil 0.5\n    if m is None: return None\n    g = m[..., 0] if m.ndim == 3 else m\n    return g > 127\n\nP  = (a[..., 0] if a.ndim == 3 else a).astype(np.float64) / 255.0\nopen_w = _gray(b)                                   # eau libre\nbridge = _gray(c) & ~open_w                         # ponts = with - no_bridges\n\npo, pb = P[open_w], P[bridge]                        # scores P continus par classe\nn1, n0 = po.size, pb.size\nassert n1 and n0, f\"classe vide (eau={n1}, ponts={n0}) — verifie les masques\"\n\n# --- AUROC (rang de Mann-Whitney) : positif = eau libre ---\nr = rankdata(np.concatenate([po, pb]))\nauroc = (r[:n1].sum() - n1 * (n1 + 1) / 2) / (n1 * n0)\n\n# --- options de separation supplementaires ---\ndelta   = po.mean() - pb.mean()                     # ecart des moyennes\npooled  = np.sqrt(((n1-1)*po.var(ddof=1) + (n0-1)*pb.var(ddof=1)) / (n1+n0-2))\ncohen_d = delta / (pooled + 1e-12)                  # taille d'effet\nks      = float(ks_2samp(po, pb).statistic)         # ecart max des CDF\nt = 0.7\nrej = float((pb <  t).mean())                       # rejet ponts  @t\ndet = float((po >= t).mean())                       # detection eau @t\n\ndiag = np.zeros((*P.shape, 3), np.uint8)\ndiag[open_w] = (0,120,0)        # eau libre = vert sombre\ndiag[bridge] = (0,0,255)        # ponts = rouge\n\n\n'''\nout_a = float(auroc)        # AUROC  (sans seuil — la mesure forte)\nout_b = float(delta)        # Delta separation\nout_c = float(cohen_d)      # Cohen's d\nout_d = ks                  # KS statistic\nout_rej = rej                 # taux rejet ponts @0.7\nout_f = det                 # taux detection eau @0.7\n'''\nout_a = {'auroc': round(auroc,4), 'delta': round(delta,4),\n         'cohen_d': round(cohen_d,3), 'ks': round(ks,4),\n         'bridge_rej@0.7': round(rej,4), 'water_det@0.7': round(det,4),\n         'n_open': int(n1), 'n_bridge': int(n0)}\nout_img = diag                  # branche sur un display\nprint('P_bridge mean/median:', round(float(pb.mean()),3), round(float(np.median(pb)),3))",
          "color_index": 4
        },
        "ports": [
          {
            "id": "image__a",
            "color": "image",
            "label": "a"
          },
          {
            "id": "mask__b",
            "color": "mask",
            "label": "b"
          },
          {
            "id": "mask__c",
            "color": "mask",
            "label": "c"
          },
          {
            "id": "mask__d",
            "color": "mask",
            "label": "d"
          }
        ],
        "outPorts": [
          {
            "id": "any__out_a",
            "color": "any",
            "label": "out_a"
          }
        ],
        "userLabel": "AUROC"
      },
