    {
      "id": "adaptive_caps",
      "type": "logic_python",
      "position": {
        "x": 700,
        "y": 700
      },
      "width": 208,
      "height": 153,
      "data": {
        "label": "Python Node",
        "userLabel": "Adaptive Reflectance Caps (p99 consensus)",
        "params": {
          "code": "# a = base geotiff (UNPERTURBED, from stack5). Bands: blue,green,red,nir,swir1,swir2\n# Self-calibrating NIR/SWIR caps = p99 of the reflectance of consensus water pixels\n# (vote>=2). Tuning-free transfer (script design principle #2). Computed ONCE on the\n# deterministic base -> same caps every MC tick, applied to perturbed bands downstream.\nimport numpy as np\nbands = np.asarray(a['bands'], np.float32)\nblue, green, red, nir, swir1, swir2 = bands[0], bands[1], bands[2], bands[3], bands[4], bands[5]\nden = 1e-6\nndwi  = np.where(np.abs(green + nir)   > den, (green - nir)   / (green + nir),   np.nan)\nmndwi = np.where(np.abs(green + swir1) > den, (green - swir1) / (green + swir1), np.nan)\nawei  = blue + 2.5 * green - 1.5 * (nir + swir1) - 0.25 * swir2\nmbwi  = 3.0 * green - (red + nir + swir1 + swir2)\nvote  = ((np.nan_to_num(ndwi)  > 0).astype(np.uint8) +\n         (np.nan_to_num(mndwi) > 0).astype(np.uint8) +\n         (awei > 0).astype(np.uint8) +\n         (mbwi > 0).astype(np.uint8))\nvalid = np.all(np.isfinite(bands), axis=0)\ncons  = valid & (vote >= 2)\nn = int(cons.sum())\nNIR_F, S1_F, S2_F, FLOOR, PCT = 0.030, 0.018, 0.014, 2.0, 99.0\nif n >= 500:\n    nir_cap   = max(float(np.nanpercentile(nir[cons],   PCT)), NIR_F * FLOOR)\n    swir1_cap = max(float(np.nanpercentile(swir1[cons], PCT)), S1_F  * FLOOR)\n    swir2_cap = max(float(np.nanpercentile(swir2[cons], PCT)), S2_F  * FLOOR)\nelse:\n    nir_cap, swir1_cap, swir2_cap = NIR_F, S1_F, S2_F\nprint(f'Adaptive caps (p{PCT:.0f}, {n} consensus px): NIR<{nir_cap:.4f} SWIR1<{swir1_cap:.4f} SWIR2<{swir2_cap:.4f}')\nout_a = float(nir_cap)\nout_b = float(swir1_cap)\nout_c = float(swir2_cap)",
          "color_index": 1
        },
        "ports": [
          {
            "id": "geotiff__a",
            "color": "geotiff",
            "label": "base"
          }
        ],
        "outPorts": [
          {
            "id": "scalar__out_a",
            "color": "scalar",
            "label": "nir_cap"
          },
          {
            "id": "scalar__out_b",
            "color": "scalar",
            "label": "swir1_cap"
          },
          {
            "id": "scalar__out_c",
            "color": "scalar",
            "label": "swir2_cap"
          }
        ]
      },
      "selected": false,
      "dragging": false,
      "positionAbsolute": {
        "x": 700,
        "y": 700
      }
    },
    {
      "id": "gate_node",
      "type": "logic_python",
      "position": {
        "x": 1740,
        "y": 700
      },
      "width": 208,
      "height": 185,
      "data": {
        "label": "Python Node",
        "userLabel": "Reflectance Gate (adaptive caps)",
        "params": {
          "code": "# a = PERTURBED geotiff (from noise). b,c,d = nir/swir1/swir2 caps (adaptive_caps).\n# Equal-weight reflectance gate: dark in NIR & both SWIR + low-signal floor on (green+nir).\nimport numpy as np\nbands = np.asarray(a['bands'], np.float32)\ngreen, nir, swir1, swir2 = bands[1], bands[3], bands[4], bands[5]\nnir_cap   = float(b) if b is not None else 0.030\nswir1_cap = float(c) if c is not None else 0.018\nswir2_cap = float(d) if d is not None else 0.014\ngate = ((nir < nir_cap) & (swir1 < swir1_cap) & (swir2 < swir2_cap) &\n        ((green + nir) > 0.003))\nout_mask = (gate.astype(np.uint8) * 255)",
          "color_index": 1
        },
        "ports": [
          {
            "id": "geotiff__a",
            "color": "geotiff",
            "label": "perturbed"
          },
          {
            "id": "scalar__b",
            "color": "scalar",
            "label": "nir_cap"
          },
          {
            "id": "scalar__c",
            "color": "scalar",
            "label": "swir1_cap"
          },
          {
            "id": "scalar__d",
            "color": "scalar",
            "label": "swir2_cap"
          }
        ],
        "outPorts": [
          {
            "id": "mask__out_mask",
            "color": "mask",
            "label": "gate"
          }
        ]
      },
      "selected": false,
      "dragging": false,
      "positionAbsolute": {
        "x": 1740,
        "y": 700
      }
    },
