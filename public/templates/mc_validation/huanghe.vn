    {
      "id": "mc_cal",
      "type": "logic_python",
      "position": {
        "x": 3180,
        "y": 2240
      },
      "style": {},
      "data": {
        "label": "Python Node",
        "userLabel": "MC Calibration (Brier/ECE/⟨U⟩)",
        "params": {
          "code": "# MC Calibration — boundary-stratified. Brier / ECE / MCE + <sigma_P>, split into\n# CORE (far from the water/land boundary) vs BOUNDARY band, plus OVERALL.\n#   a = P (acc_mean image, 0-255)   b = truth GT (water=1)\n#   c = domain mask (opt; default whole scene)   d = sigma_P map (opt)   e = n_bins (opt, 12)\n# Rationale: on the whole scene, mass-weighted Brier/ECE are dominated by trivial\n# confident land (P~0, y=0) and look artificially perfect. Stratifying by distance to\n# the GT boundary separates the confident bulk (should be near-diagonal) from the\n# sub-pixel-mixed edge (soft P meets a hard binary label) -- the honest test of whether\n# residual miscalibration is a model defect or a reference-granularity artefact (draft 3.5).\nimport numpy as np\nfrom scipy import ndimage\nimport matplotlib; matplotlib.use('Agg')\nimport matplotlib.pyplot as plt\n\nBOUND_TOL = 3          # px band each side of the GT water/land boundary (matches Boundary-F1 tol)\n\nP = (a[..., 0] if a.ndim == 3 else a).astype(np.float64) / 255.0\ny = ((b[..., 0] if b.ndim == 3 else b) > 127)\ntry:\n    dom = (c[..., 0] if c.ndim == 3 else c) > 127\nexcept Exception:\n    dom = np.ones(P.shape, bool)\ntry:\n    nb = int(round(float(e)))\nexcept Exception:\n    nb = 12\nnb = min(max(nb, 3), 50)\ntry:\n    sig = (d[..., 0] if d.ndim == 3 else d).astype(np.float64)\n    if sig.max() > 1.5: sig = sig / 255.0\n    U_src = 'ensemble_std'\nexcept Exception:\n    sig = P * (1.0 - P); U_src = 'bernoulli_var'\n\n# distance (px) to the nearest GT water/land boundary\nedt_in  = ndimage.distance_transform_edt(y)\nedt_out = ndimage.distance_transform_edt(~y)\ndist = np.where(y, edt_in, edt_out)\nboundary_zone = dist <= BOUND_TOL\ncore_zone = ~boundary_zone\n\nfinite = dom & np.isfinite(P)\nedges = np.linspace(0.0, 1.0, nb + 1)\ncenters = (edges[:-1] + edges[1:]) / 2\n\ndef _cal(sel):\n    mm = finite & sel\n    Pv = P[mm]; yv = y[mm].astype(np.float64)\n    nn = Pv.size\n    if nn < 30:\n        return None\n    brier = float(np.mean((Pv - yv) ** 2))\n    idx = np.clip(np.digitize(Pv, edges) - 1, 0, nb - 1)\n    conf = np.full(nb, np.nan); acc = np.full(nb, np.nan); cnt = np.zeros(nb)\n    for k in range(nb):\n        s = idx == k\n        cnt[k] = s.sum()\n        if cnt[k] > 0:\n            conf[k] = Pv[s].mean(); acc[k] = yv[s].mean()\n    ok = cnt > 0\n    ece = float(np.sum((cnt[ok] / nn) * np.abs(acc[ok] - conf[ok])))\n    mce = float(np.max(np.abs(acc[ok] - conf[ok]))) if ok.any() else float('nan')\n    Um = float(np.mean(sig[mm]))\n    return {'brier': round(brier, 4), 'ece': round(ece, 4), 'mce': round(mce, 4),\n            'mean_uncertainty': round(Um, 4), 'n_pixels': int(nn),\n            '_conf': conf, '_acc': acc, '_cnt': cnt, '_ok': ok}\n\nstrata = {'overall':  _cal(np.ones(P.shape, bool)),\n          'core':     _cal(core_zone),\n          'boundary': _cal(boundary_zone)}\n\ncolr = {'overall': 'tab:gray', 'core': 'tab:green', 'boundary': 'tab:red'}\nfig = plt.figure(figsize=(6.6, 6.8), dpi=110)\ngs = fig.add_gridspec(3, 1, height_ratios=[3, 1, 0.05], hspace=0.3)\naxr = fig.add_subplot(gs[0]); axh = fig.add_subplot(gs[1], sharex=axr)\naxr.plot([0, 1], [0, 1], ls='--', c='k', lw=1.0, label='perfect')\nfor name in ('overall', 'core', 'boundary'):\n    st = strata[name]\n    if st is None: continue\n    ok = st['_ok']\n    axr.plot(st['_conf'][ok], st['_acc'][ok], 'o-', color=colr[name], lw=1.6, ms=4,\n             label=f\"{name} (Brier {st['brier']:.3f}, ECE {st['ece']:.3f}, MCE {st['mce']:.3f})\")\naxr.set_ylabel('Empirical accuracy (fraction water)')\naxr.set_xlim(0, 1); axr.set_ylim(0, 1); axr.grid(alpha=0.3)\naxr.set_title(f'Boundary-stratified reliability -- MC P(water)  (tol {BOUND_TOL}px)')\naxr.legend(loc='lower right', fontsize=8)\nfor name in ('core', 'boundary'):\n    st = strata[name]\n    if st is None: continue\n    frac = st['_cnt'] / max(st['_cnt'].sum(), 1)\n    axh.plot(centers, frac, drawstyle='steps-mid', color=colr[name], lw=1.3, label=name)\naxh.set_ylabel('frac.'); axh.set_xlabel('Predicted P(water)'); axh.grid(alpha=0.3)\naxh.legend(fontsize=7, loc='upper center')\nfig.subplots_adjust(left=0.13, right=0.97, top=0.93, bottom=0.09)\nfig.canvas.draw()\n_w, _h = fig.canvas.get_width_height()\nout_reliability = np.frombuffer(fig.canvas.buffer_rgba(), dtype=np.uint8).reshape(_h, _w, 4)[..., :3].copy()\nplt.close(fig)\n\nbfrac = float(boundary_zone[finite].mean())\nout_cal = {'tolerance_px': BOUND_TOL, 'uncertainty_source': U_src, 'n_bins': nb,\n           'boundary_fraction': round(bfrac, 4)}\nfor name, st in strata.items():\n    out_cal[name] = None if st is None else {k: st[k] for k in\n        ('brier', 'ece', 'mce', 'mean_uncertainty', 'n_pixels')}\nprint('calibration (stratified):', out_cal)\n",
          "color_index": 3,
          "node_note": "Calibration boundary-stratifiee: core (>3px du bord GT) vs boundary band vs overall. Separe le bulk confiant du bord sous-pixel (soft P vs label binaire). tol=BOUND_TOL editable. a=P b=GT c=domaine(opt, def whole) d=sigma_P e=n_bins."
        },
        "ports": [
          {
            "id": "image__a",
            "color": "image",
            "label": "a = P"
          },
          {
            "id": "mask__b",
            "color": "mask",
            "label": "b = truth (GT)"
          },
          {
            "id": "mask__c",
            "color": "mask",
            "label": "c = domain (opt)"
          },
          {
            "id": "image__d",
            "color": "image",
            "label": "d = σ_P map (opt)"
          },
          {
            "id": "scalar__e",
            "color": "scalar",
            "label": "e = n_bins"
          }
        ],
        "outPorts": [
          {
            "id": "image__out_reliability",
            "color": "image",
            "label": "reliability diagram"
          },
          {
            "id": "any__out_cal",
            "color": "any",
            "label": "calibration stats"
          }
        ]
      },
