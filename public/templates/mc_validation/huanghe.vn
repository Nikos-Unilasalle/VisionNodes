    {
      "id": "adaptive_gate",
      "type": "logic_python",
      "position": {
        "x": 1480,
        "y": 200
      },
      "style": {},
      "data": {
        "label": "Python Node",
        "userLabel": "Adaptive Gate (p99 consensus)",
        "params": {
          "code": "# Adaptive reflectance gate — fidele a compute_adaptive_constraints + le gate de\n# decision_water. base = stack NON bruite, pert = stack bruite.\n#   Ordre CDSE B04,B03,B02,B08,B11,B12 = red,green,blue,nir,swir1,swir2.\n# Caps p99 derives des pixels consensus de la scene de BASE (figes sur tout le run,\n# plancher 2x cap fixe, repli caps fixes si < 500 px). Gate compare sur le BRUITE.\nimport numpy as np\n\nVOTE_K, PCT, MIN_PIX = 2, 99.0, 500\nNIR_MAX, SWIR1_MAX, SWIR2_MAX = 0.12, 0.06, 0.05   # SR L2A ; adaptatif p99 prend le relais si consensus>=500\nFLOOR_MULT, SIGNAL_MIN = 2.0, 0.003\nBAND_MIN, DEN_MIN = -0.002, 1e-6\n\ndef _b6(g):\n    a = np.asarray(g['bands'], dtype=np.float32)\n    # CDSE order B04,B03,B02,B08,B11,B12 = red,green,blue,nir,swir1,swir2\n    return a[2], a[1], a[0], a[3], a[4], a[5]   # blue green red nir swir1 swir2\n\ndef _nd(x, y):\n    den, num = x + y, x - y\n    o = np.full(x.shape, np.nan, np.float32)\n    v = (np.isfinite(x) & np.isfinite(y) & (np.abs(den) > DEN_MIN)\n         & (x > BAND_MIN) & (y > BAND_MIN))\n    o[v] = num[v] / den[v]\n    return np.clip(o, -1.0, 1.0)\n\ndef _votesum(bl, gr, rd, ni, s1, s2):\n    ndwi  = _nd(gr, ni)\n    mndwi = _nd(gr, s1)\n    awei  = bl + 2.5*gr - 1.5*(ni + s1) - 0.25*s2          # AWEIsh\n    mbwi  = 3.0*gr - (rd + ni + s1 + s2)                   # MBWI factor 3\n    return ((np.isfinite(ndwi)  & (ndwi  > 0)).astype(np.uint8)\n          + (np.isfinite(mndwi) & (mndwi > 0)).astype(np.uint8)\n          + (np.isfinite(awei)  & (awei  > 0)).astype(np.uint8)\n          + (np.isfinite(mbwi)  & (mbwi  > 0)).astype(np.uint8))\n\n# --- caps figes sur la scene de base (calcules une seule fois par run) ---\nbl, gr, rd, ni, s1, s2 = _b6(base)\nsig = (ni.shape, round(float(np.nansum(ni)), 3))\nif state.get('gate_sig') != sig or len(state.get('caps', ())) != 5:\n    valid = (np.isfinite(bl) & np.isfinite(gr) & np.isfinite(rd)\n             & np.isfinite(ni) & np.isfinite(s1) & np.isfinite(s2))\n    cons = valid & (_votesum(bl, gr, rd, ni, s1, s2) >= VOTE_K)\n    n = int(cons.sum())\n    if n >= MIN_PIX:\n        nc = max(float(np.nanpercentile(ni[cons], PCT)), NIR_MAX   * FLOOR_MULT)\n        c1 = max(float(np.nanpercentile(s1[cons], PCT)), SWIR1_MAX * FLOOR_MULT)\n        c2 = max(float(np.nanpercentile(s2[cons], PCT)), SWIR2_MAX * FLOOR_MULT)\n        adaptive = True\n    else:\n        nc, c1, c2, adaptive = NIR_MAX, SWIR1_MAX, SWIR2_MAX, False\n    state['gate_sig'] = sig\n    state['caps'] = (nc, c1, c2, adaptive, n)\nnc, c1, c2, adaptive, n = state['caps']\n\n# --- gate applique sur les bandes BRUITEES (caps figes) ---\npbl, pgr, prd, pni, ps1, ps2 = _b6(pert)\ngate = (np.isfinite(pbl) & np.isfinite(pgr) & np.isfinite(prd)\n        & np.isfinite(pni) & np.isfinite(ps1) & np.isfinite(ps2))\ngate &= pni < np.float32(nc)\ngate &= ps1 < np.float32(c1)\ngate &= ps2 < np.float32(c2)\n# SIGNAL_MIN floor removed: a brightness floor also deletes dark/pure open water\n# (NIR/SWIR ~ 0) which is the darkest target. Rely on NIR/SWIR upper caps + k-of-4 vote.\n\nout_mask = (gate.astype(np.uint8) * 255)\nout_caps = {'adaptive': bool(adaptive), 'n_consensus': int(n),\n            'nir_cap': round(float(nc), 4), 'swir1_cap': round(float(c1), 4),\n            'swir2_cap': round(float(c2), 4)}\nprint('gate caps', out_caps)\n",
          "node_note": "Gate de reflectance scene-adaptatif. base=CDSE L2A SR (non bruite), pert=noise (bruite). _b6 ordre CDSE B04,B03,B02,B08,B11,B12 -> blue,green,red,nir,swir1,swir2. Caps p99 auto-cales sur pixels consensus (repli fixe SR NIR<0.12 SWIR1<0.06 SWIR2<0.05 si <500 px).",
          "color_index": 1
        },
        "ports": [
          {
            "id": "geotiff__base",
            "color": "geotiff",
            "label": "base"
          },
          {
            "id": "geotiff__pert",
            "color": "geotiff",
            "label": "pert"
          }
        ],
        "outPorts": [
          {
            "id": "mask__out_mask",
            "color": "mask",
            "label": "gate"
          },
          {
            "id": "any__out_caps",
            "color": "any",
            "label": "caps"
          }
        ]
      },
      "width": 208,
      "height": 121,
      "selected": false,
      "dragging": false,
      "positionAbsolute": {
        "x": 1480,
        "y": 200
      }
    },
