    { "id": "e_s4_s5_p",      "source": "stack4",       "target": "stack5",      "sourceHandle": "geotiff__geotiff", "targetHandle": "geotiff__primary" },
    { "id": "e_swir2_s5_s",   "source": "swir2_reader", "target": "stack5",      "sourceHandle": "geotiff__geotiff", "targetHandle": "geotiff__secondary" },
    { "id": "e_s5_idx",       "source": "stack5",       "target": "spectral_idx","sourceHandle": "geotiff__geotiff", "targetHandle": "geotiff__geotiff" },
    { "id": "e_prob_py",      "source": "prob_reader",  "target": "sensitivity", "sourceHandle": "geotiff__geotiff", "targetHandle": "any__a" },
    { "id": "e_stack_py",     "source": "spectral_idx", "target": "sensitivity", "sourceHandle": "geotiff__stack",   "targetHandle": "any__b" },
    { "id": "e_py_disp",      "source": "sensitivity",  "target": "display",     "sourceHandle": "image__main",      "targetHandle": "image__main" }
  ],
  "ui": { "zoom": 0.55, "viewport": { "x": 20, "y": 200, "zoom": 0.55 } }
}
