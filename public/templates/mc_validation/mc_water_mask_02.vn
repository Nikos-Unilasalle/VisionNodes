    {
      "id": "nir_gate",
      "type": "geo_band_calc",
      "position": {
        "x": 1400,
        "y": 720
      },
      "width": 208,
      "height": 90,
      "data": {
        "userLabel": "NIR Gate (B4 < 0.01 sr⁻¹)",
        "params": {
          "expression": "B4 < 0.025",
          "clamp_min": 0,
          "clamp_max": 1,
          "colormap": "gray",
          "node_note": "NIR Rrs < 0.01 sr⁻¹ = physically water (near-complete NIR absorption by liquid water). Excludes sunlit urban/vegetation. Deep building shadows (NIR ≈ 0.002–0.005) are marginal — reduces urban cluster density significantly. Threshold is physically motivated, not scene-specific.",
          "preset": 0
        }
      },
      "selected": false,
      "dragging": false,
      "positionAbsolute": {
        "x": 1400,
        "y": 720
      }
    },
