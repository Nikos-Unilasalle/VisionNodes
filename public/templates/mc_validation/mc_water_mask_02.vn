    {
      "id": "noise",
      "type": "geo_raster_noise",
      "position": {
        "x": 680,
        "y": 420
      },
      "width": 208,
      "height": 90,
      "data": {
        "userLabel": "MC Sensor Perturbation",
        "params": {
          "sigma_abs": 0.005,
          "sigma_rel": 0.02,
          "clip_negative": false,
          "seed": 42,
          "node_note": "Stochastic — redraws each tick. Drives Monte-Carlo ensemble. ACOLITE Rrs may be slightly negative on dark water — keep clip_negative=false."
        }
      },
      "selected": false,
      "positionAbsolute": {
        "x": 680,
        "y": 420
      },
      "dragging": false
    },
    {
      "id": "idx",
      "type": "geo_spectral_indices",
      "position": {
        "x": 1030,
        "y": 360
      },
      "width": 208,
      "height": 345,
      "data": {
        "userLabel": "4 Water Indices",
        "params": {
          "sensor": 0,
          "nir_band": 4,
          "red_band": 3,
          "green_band": 2,
          "blue_band": 1,
          "swir_band": 5,
          "ndvi": false,
          "ndwi": true,
          "evi": false,
          "mndwi": true,
          "nbr": false,
          "bsi": false,
          "expr1_enable": true,
          "expr1_label": "AWEInsh",
          "expr1": "4*(GREEN - SWIR) - (0.25*NIR + 2.75*B6)",
          "expr2_enable": true,
          "expr2_label": "AWEIsh",
          "expr2": "BLUE + 2.5*GREEN - 1.5*(NIR + SWIR) - 0.25*B6",
          "colormap": 0,
          "clamp_min": -5,
          "clamp_max": 5,
          "node_note": "ACOLITE Rrs. Band order: B1=Blue(492) B2=Green(559) B3=Red(665) B4=NIR(833) B5=SWIR1(1610) B6=SWIR2(2186). SWIR=SWIR1(B5). Stack output = [NDWI, MNDWI, AWEInsh, AWEIsh]."
        }
      },
      "selected": false
    },
    {
      "id": "vote",
      "type": "geo_band_calc",
      "position": {
        "x": 1400,
        "y": 440
      },
      "width": 208,
      "height": 90,
      "data": {
        "userLabel": "Consensus Vote k=2 of 4",
        "params": {
          "expression": "(1*(B1>0)+1*(B2>0)+1*(B3>0)+1*(B4>0)) >= 2",
          "clamp_min": 0,
          "clamp_max": 1,
          "colormap": "gray"
        }
      },
      "selected": false,
      "dragging": false,
      "positionAbsolute": {
        "x": 1400,
        "y": 440
      }
    },
