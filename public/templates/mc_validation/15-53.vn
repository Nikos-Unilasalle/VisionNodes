    {
      "id": "noise",
      "type": "geo_raster_noise",
      "position": {
        "x": 700,
        "y": 440
      },
      "width": 208,
      "height": 121,
      "data": {
        "userLabel": "MC Sensor Perturbation",
        "params": {
          "sigma_abs": 0.001,
          "sigma_rel": 0.015,
          "clip_negative": false,
          "seed": 42,
          "node_note": "Stochastic — redraws each tick. Drives Monte-Carlo ensemble. ACOLITE Rrs may be slightly negative on dark water — keep clip_negative=false.",
          "max_ticks": 210,
          "reset": 0,
          "toggle_run": 0,
          "color_index": 0
        }
      },
      "selected": false,
      "dragging": false,
      "positionAbsolute": {
        "x": 700,
        "y": 440
      }
    },
    {
      "id": "idx",
      "type": "geo_spectral_indices",
      "position": {
        "x": 1040,
        "y": 360
      },
      "width": 208,
      "height": 345,
      "data": {
        "userLabel": "4 Water Indices",
        "params": {
          "sensor": 0,
          "nir_band": 4,
          "red_band": 3,
          "green_band": 2,
          "blue_band": 1,
          "swir_band": 5,
          "ndvi": false,
          "ndwi": true,
          "evi": false,
          "mndwi": true,
          "nbr": false,
          "bsi": false,
          "expr1_enable": true,
          "expr1_label": "AWEIsh",
          "expr1": "BLUE + 2.5*GREEN - 1.5*(NIR + SWIR) - 0.25*B6",
          "expr2_enable": true,
          "expr2_label": "MBWI",
          "expr2": "2*GREEN - RED - NIR - SWIR - B6",
          "colormap": 0,
          "clamp_min": -5,
          "clamp_max": 5,
          "node_note": "ACOLITE Rrs. B1=Blue B2=Green B3=Red B4=NIR B5=SWIR1 B6=SWIR2. SWIR=SWIR1(B5). Stack = [NDWI, MNDWI, AWEIsh, MBWI] — 4 max-independent water indices (paper set).",
          "color_index": 0
        }
      },
      "selected": false,
      "positionAbsolute": {
        "x": 1040,
        "y": 360
      },
      "dragging": false
    },
    {
      "id": "vote",
      "type": "geo_band_calc",
      "position": {
        "x": 1400,
        "y": 440
      },
      "width": 208,
      "height": 90,
      "data": {
        "userLabel": "Consensus Vote k=2 of 4",
        "params": {
          "expression": "(1*(B1>0)+1*(B2>0)+1*(B3>0)+1*(B4>0)) >= 2",
          "clamp_min": 0,
          "clamp_max": 1,
          "colormap": "gray",
          "color_index": 1
        },
        "minified": false
      },
      "selected": false,
      "positionAbsolute": {
        "x": 1400,
        "y": 440
      },
      "dragging": false,
      "style": {}
    },
