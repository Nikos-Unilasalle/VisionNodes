    {
      "id": "nir_gate",
      "type": "geo_band_calc",
      "position": {
        "x": 1400,
        "y": 720
      },
      "width": 208,
      "height": 90,
      "data": {
        "userLabel": "NIR Gate (B4 < 0.025 sr⁻¹)",
        "params": {
          "expression": "(B4 < 0.025) & (B5 < 0.018) & (B6 < 0.014) & (B2 > 0.002)",
          "clamp_min": 0,
          "clamp_max": 1,
          "colormap": "gray",
          "node_note": "Turbid-aware constraint. NIR<0.025 tolerates sediment; SWIR1<0.018 & SWIR2<0.014 are the real water discriminators; Green>0.002 = low-signal floor.",
          "preset": 0,
          "color_index": 1
        }
      },
      "selected": false,
      "dragging": false,
      "positionAbsolute": {
        "x": 1400,
        "y": 720
      }
    },
