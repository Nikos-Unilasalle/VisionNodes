  "edges": [
    { "id": "e_prob_mc_mask",   "source": "prob_reader",       "target": "mc_threshold_mask", "sourceHandle": "geotiff__geotiff", "targetHandle": "geotiff__geotiff" },
    { "id": "e_prob_with",      "source": "prob_reader",       "target": "with_bridges",      "sourceHandle": "geotiff__geotiff", "targetHandle": "geotiff__reference" },
    { "id": "e_prob_no",        "source": "prob_reader",       "target": "no_bridges",        "sourceHandle": "geotiff__geotiff", "targetHandle": "geotiff__reference" },
    { "id": "e_mndwi_s1_prim", "source": "mndwi_reader",      "target": "stack1",            "sourceHandle": "geotiff__geotiff", "targetHandle": "geotiff__primary" },
    { "id": "e_ndwi_s1_sec",   "source": "ndwi_reader",       "target": "stack1",            "sourceHandle": "geotiff__geotiff", "targetHandle": "geotiff__secondary" },
    { "id": "e_s1_s2_prim",    "source": "stack1",            "target": "stack2",            "sourceHandle": "geotiff__geotiff", "targetHandle": "geotiff__primary" },
    { "id": "e_awei_s2_sec",   "source": "awei_reader",       "target": "stack2",            "sourceHandle": "geotiff__geotiff", "targetHandle": "geotiff__secondary" },
    { "id": "e_s2_s3_prim",    "source": "stack2",            "target": "stack3",            "sourceHandle": "geotiff__geotiff", "targetHandle": "geotiff__primary" },
    { "id": "e_mbwi_s3_sec",   "source": "mbwi_reader",       "target": "stack3",            "sourceHandle": "geotiff__geotiff", "targetHandle": "geotiff__secondary" },
    { "id": "e_mc_mask_mno",   "source": "mc_threshold_mask", "target": "metrics_no",        "sourceHandle": "mask__mask",       "targetHandle": "mask__pred" },
    { "id": "e_mc_mask_mwith", "source": "mc_threshold_mask", "target": "metrics_with",      "sourceHandle": "mask__mask",       "targetHandle": "mask__pred" },
    { "id": "e_no_mno",        "source": "no_bridges",        "target": "metrics_no",        "sourceHandle": "mask__mask",       "targetHandle": "mask__truth" },
    { "id": "e_with_mwith",    "source": "with_bridges",      "target": "metrics_with",      "sourceHandle": "mask__mask",       "targetHandle": "mask__truth" },
    { "id": "e_prob_py_cdf",   "source": "prob_reader",       "target": "py_cdf",            "sourceHandle": "geotiff__geotiff", "targetHandle": "any__a" },
    { "id": "e_with_py_cdf",   "source": "with_bridges",      "target": "py_cdf",            "sourceHandle": "mask__mask",       "targetHandle": "any__b" },
    { "id": "e_no_py_cdf",     "source": "no_bridges",        "target": "py_cdf",            "sourceHandle": "mask__mask",       "targetHandle": "any__c" },
    { "id": "e_prob_py_idx",   "source": "prob_reader",       "target": "py_idx_compute",    "sourceHandle": "geotiff__geotiff", "targetHandle": "any__a" },
    { "id": "e_s3_py_idx",     "source": "stack3",            "target": "py_idx_compute",    "sourceHandle": "geotiff__geotiff", "targetHandle": "any__b" },
    { "id": "e_with_py_idx",   "source": "with_bridges",      "target": "py_idx_compute",    "sourceHandle": "mask__mask",       "targetHandle": "any__c" },
    { "id": "e_no_py_idx",     "source": "no_bridges",        "target": "py_idx_compute",    "sourceHandle": "mask__mask",       "targetHandle": "any__d" },
    { "id": "e_idx_no_bar",    "source": "py_idx_compute",    "target": "bar_no",            "sourceHandle": "any__out_a",       "targetHandle": "data__table" },
    { "id": "e_idx_with_bar",  "source": "py_idx_compute",    "target": "bar_with",          "sourceHandle": "any__out_b",       "targetHandle": "data__table" },
