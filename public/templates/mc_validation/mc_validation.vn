          "node_note": "Wider river polygon — includes bridge footprints. Defines river extent for all analysis."
        }
      }
    },
    {
      "id": "no_bridges",
      "type": "geo_shapefile_rasterizer",
      "position": { "x": 10, "y": 1280 },
