    {
      "id": "py_cdf",
      "type": "logic_python",
      "position": { "x": 1160, "y": 10 },
      "width": 340, "height": 220,
      "data": {
        "label": "CDF & Threshold Sweep",
        "params": {
          "code": "# CDF and threshold sweep: P(water) vs with/no-bridges references\n# a = MC probability geotiff\n# b = with_bridges mask (uint8 0/255, numpy array)\n# c = no_bridges mask   (uint8 0/255, numpy array)\nMC_THRESHOLD = 0.7\n\nif not (isinstance(a, dict) and 'bands' in a):\n    out_main = None\nelse:\n    import matplotlib\n    matplotlib.use('Agg')\n    import matplotlib.pyplot as plt\n\n    prob  = a['bands'][0].astype(np.float64)\n    valid = np.isfinite(prob)\n    with_m  = (b > 127) & valid if (b is not None and isinstance(b, np.ndarray)) else np.zeros_like(valid)\n    no_m    = (c > 127) & valid if (c is not None and isinstance(c, np.ndarray)) else np.zeros_like(valid)\n    bridge_m = with_m & ~no_m\n    p_w = prob[no_m];    n_w = len(p_w)\n    p_b = prob[bridge_m]; n_b = len(p_b)\n\n    fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(13, 5.5))\n    fig.patch.set_facecolor('#111111')\n    for ax in [ax1, ax2]:\n        ax.set_facecolor('#1a1a1a')\n        for sp in ax.spines.values(): sp.set_color('#444')\n        ax.tick_params(colors='#aaa')\n        ax.grid(True, color='#333', alpha=0.5)\n\n    # ── CDF ───────────────────────────────────────────────────────────────────\n    for arr, lbl, col in [(p_w, f'Open water (n={n_w:,})', '#0072B2'),\n                           (p_b, f'Bridge pixels (n={n_b:,})', '#D55E00')]:\n        if len(arr) >= 10:\n            xs = np.sort(arr)\n            ys = np.arange(1, len(xs)+1) / len(xs)\n            ax1.plot(xs, ys, color=col, lw=2.5, label=lbl)\n    ax1.axvline(MC_THRESHOLD, color='#aaaaaa', lw=1.4, ls='--', label=f'P = {MC_THRESHOLD}')\n    ax1.set_xlabel('P(water)', color='#ccc'); ax1.set_ylabel('CDF', color='#ccc')\n    sep = float(np.mean(p_w)) - float(np.mean(p_b)) if n_b > 0 else float('nan')\n    ax1.set_title(f'CDF  |  Δμ = {sep:.3f}', color='#eee', fontsize=12)\n    ax1.legend(facecolor='#222', edgecolor='#444', labelcolor='#ccc', fontsize=10)\n    ax1.set_xlim(-0.02, 1.02); ax1.set_ylim(-0.02, 1.02)\n\n    # ── Threshold sweep ────────────────────────────────────────────────────────\n    thresholds = np.round(np.arange(0.1, 1.0, 0.1), 2)\n    for ref, lbl, col, ls in [\n        (no_m,   'No bridges',   '#56B4E9', '-'),\n        (with_m, 'With bridges', '#CC79A7', '--')\n    ]:\n        f1s, ious = [], []\n        for t in thresholds:\n            pred = (prob >= t) & valid\n            tp  = int(np.sum(pred & ref))\n            fp  = int(np.sum(pred & ~ref))\n            fn  = int(np.sum(~pred & ref))\n            pr_ = tp/(tp+fp) if (tp+fp) > 0 else 0.0\n            rc_ = tp/(tp+fn) if (tp+fn) > 0 else 0.0\n            f1s.append(2*pr_*rc_/(pr_+rc_) if (pr_+rc_) > 0 else 0.0)\n            ious.append(tp/(tp+fp+fn) if (tp+fp+fn) > 0 else 0.0)\n        ax2.plot(thresholds, f1s,  color=col, ls=ls, lw=2,   marker='o', ms=4, label=f'F1 – {lbl}')\n        ax2.plot(thresholds, ious, color=col, ls=ls, lw=1.5, marker='s', ms=3, alpha=0.7, label=f'IoU – {lbl}')\n    ax2.axvline(MC_THRESHOLD, color='#aaaaaa', lw=1.2, ls='--')\n    ax2.set_xlabel('MC probability threshold', color='#ccc')\n    ax2.set_ylabel('Score', color='#ccc')\n    ax2.set_title('Threshold Sweep: F1 & IoU', color='#eee', fontsize=12)\n    ax2.legend(facecolor='#222', edgecolor='#444', labelcolor='#ccc', fontsize=8, ncol=2)\n    ax2.set_ylim(0, 1.05); ax2.set_xlim(0.08, 0.95)\n\n    fig.suptitle('MC Water Mask Validation', color='#eee', fontsize=14)\n    plt.tight_layout()\n    fig.canvas.draw()\n    buf = np.asarray(fig.canvas.buffer_rgba())\n    out_main = cv2.cvtColor(buf, cv2.COLOR_RGBA2BGR)\n    plt.close(fig)"
        }
      }
    },

    {
      "id": "py_idx_compute",
      "type": "logic_python",
      "position": { "x": 1160, "y": 740 },
      "width": 340, "height": 220,
      "data": {
        "label": "Index Metrics → DataFrames",
        "params": {
          "code": "# Compute F1 & IoU for MC and each spectral index vs both references.\n# Outputs long-format DataFrames for ml_bar_chart (one per reference).\n# a = MC probability geotiff (1-band float)\n# b = 4-band index stack geotiff (MNDWI, NDWI, AWEI, MBWI)\n# c = with_bridges mask (uint8 0/255)\n# d = no_bridges mask   (uint8 0/255)\nimport pandas as pd\nMC_THRESHOLD = 0.7\n\nif not (isinstance(a, dict) and 'bands' in a and isinstance(b, dict) and 'bands' in b):\n    out_a = None\n    out_b = None\nelse:\n    prob     = a['bands'][0].astype(np.float64)\n    valid    = np.isfinite(prob)\n    n_idx    = min(4, b['count'])\n    names    = (b.get('band_names') or ['MNDWI', 'NDWI', 'AWEI', 'MBWI'])[:n_idx]\n    idx_arrs = [b['bands'][i].astype(np.float64) for i in range(n_idx)]\n\n    with_m = (c > 127) & valid if (c is not None and isinstance(c, np.ndarray)) else np.zeros_like(valid)\n    no_m   = (d > 127) & valid if (d is not None and isinstance(d, np.ndarray)) else np.zeros_like(valid)\n\n    def get_f1_iou(pred, ref):\n        tp = int(np.sum(pred & ref))\n        fp = int(np.sum(pred & ~ref))\n        fn = int(np.sum(~pred & ref))\n        pr_ = tp / (tp + fp) if (tp + fp) > 0 else 0.0\n        rc_ = tp / (tp + fn) if (tp + fn) > 0 else 0.0\n        f1_ = 2 * pr_ * rc_ / (pr_ + rc_) if (pr_ + rc_) > 0 else 0.0\n        iou_ = tp / (tp + fp + fn) if (tp + fp + fn) > 0 else 0.0\n        return f1_, iou_\n\n    mc_pred = (prob >= MC_THRESHOLD) & valid\n    methods = [('MC', mc_pred)] + [\n        (names[i], (idx_arrs[i] >= 0.0) & np.isfinite(idx_arrs[i]) & valid)\n        for i in range(n_idx)\n    ]\n\n    rows_no, rows_with = [], []\n    for name, pred in methods:\n        f1_no, iou_no = get_f1_iou(pred, no_m)\n        f1_w,  iou_w  = get_f1_iou(pred, with_m)\n        rows_no  += [{'method': name, 'metric': 'F1',  'value': round(f1_no, 4)},\n                     {'method': name, 'metric': 'IoU', 'value': round(iou_no, 4)}]\n        rows_with += [{'method': name, 'metric': 'F1',  'value': round(f1_w, 4)},\n                      {'method': name, 'metric': 'IoU', 'value': round(iou_w, 4)}]\n    out_a = pd.DataFrame(rows_no)\n    out_b = pd.DataFrame(rows_with)"
        }
      }
    },

