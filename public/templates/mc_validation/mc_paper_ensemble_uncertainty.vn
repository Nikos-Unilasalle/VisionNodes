    {
      "id": "thr_sweep",
      "type": "logic_python",
      "position": {
        "x": 3860,
        "y": 1460
      },
      "style": {},
      "data": {
        "label": "Python Node",
        "userLabel": "Threshold Sweep (F1/IoU/Youden)",
        "params": {
          "code": "# Threshold sweep — find the P(water) cutoff that maximizes a chosen metric.\n#   a = P (acc_mean image, 0-255)   b = truth mask (aligned GT)\n#   c = domain mask (opt, restricts the evaluation universe)\n#   d = metric selector (opt, default 0): 0=F1  1=IoU  2=Youden's J  3=MCC\n#   e = threshold step (opt, default 0.02)\n#   f = bootstrap replicates for 95% CI band (opt, default 0 = off)\n#   g = semantic anchor threshold (opt, default 0.5 = MC majority vote)\n# Replaces an eyeballed cutoff (e.g. \"0.7\") with the value that actually\n# maximizes precision/recall trade-off against the ground truth. The optional\n# bootstrap band quantifies whether the \"best\" threshold is statistically\n# distinguishable from the rest of the curve, or the plateau is flat within noise.\nimport numpy as np\nimport matplotlib; matplotlib.use('Agg')\nimport matplotlib.pyplot as plt\n\nPw = (a[..., 0] if a.ndim == 3 else a).astype(np.float64) / 255.0\ntruth = (b[..., 0] if b.ndim == 3 else b) > 127\ntry:\n    domain = (c[..., 0] if c.ndim == 3 else c) > 127\nexcept Exception:\n    domain = np.ones(Pw.shape, bool)\ntry:\n    metric_sel = int(round(float(d)))\nexcept Exception:\n    metric_sel = 0\nmetric_sel = metric_sel if 0 <= metric_sel <= 3 else 0\ntry:\n    step = float(e)\nexcept Exception:\n    step = 0.02\nstep = min(max(step, 0.002), 0.5)\ntry:\n    anchor = float(g)\nexcept Exception:\n    anchor = 0.5                       # MC majority vote: P >= 0.5 = most realisations agree\nanchor = min(max(anchor, 0.0), 1.0)\n\nmetric_names = ['F1', 'IoU', \"Youden's J\", 'MCC']\n\ndef _metric_curve(tp, fp, fn, tn, sel):\n    \"\"\"Vectorized metric over an array of per-threshold confusion counts.\"\"\"\n    with np.errstate(divide='ignore', invalid='ignore'):\n        if sel == 1:                                   # IoU\n            den = tp + fp + fn\n            return np.where(den > 0, tp / den, 0.0)\n        if sel == 2:                                   # Youden's J = recall + specificity - 1\n            r = np.where((tp + fn) > 0, tp / (tp + fn), 0.0)\n            spec = np.where((tn + fp) > 0, tn / (tn + fp), 0.0)\n            return r + spec - 1.0\n        if sel == 3:                                   # Matthews correlation coefficient\n            den = np.sqrt((tp + fp) * (tp + fn) * (tn + fp) * (tn + fn))\n            return np.where(den > 0, (tp * tn - fp * fn) / den, 0.0)\n        p = np.where((tp + fp) > 0, tp / (tp + fp), 0.0)   # F1 (default)\n        r = np.where((tp + fn) > 0, tp / (tp + fn), 0.0)\n        return np.where((p + r) > 0, 2 * p * r / (p + r), 0.0)\n\ntruth_d = truth & domain\nthresholds = np.arange(0.0, 1.0 + step / 2, step)\nthresholds = thresholds[thresholds <= 1.0]\n\nprec, rec, f1, iou, youden, mcc = [], [], [], [], [], []\nfor t in thresholds:\n    pred = domain & (Pw >= t)\n    tp = float((pred & truth_d).sum())\n    fp = float((pred & ~truth_d).sum())\n    fn = float((~pred & truth_d).sum())\n    tn = float((domain & ~truth_d & ~pred).sum())\n    p = tp / (tp + fp) if (tp + fp) > 0 else 0.0\n    r = tp / (tp + fn) if (tp + fn) > 0 else 0.0\n    spec = tn / (tn + fp) if (tn + fp) > 0 else 0.0\n    prec.append(p); rec.append(r)\n    f1.append(2 * p * r / (p + r) if (p + r) > 0 else 0.0)\n    iou.append(tp / (tp + fp + fn) if (tp + fp + fn) > 0 else 0.0)\n    youden.append(r + spec - 1.0)\n    # Matthews Correlation Coefficient: unlike F1/IoU, uses all 4 confusion-matrix\n    # cells (incl. true negatives) — balanced measure, robust to class imbalance.\n    mcc_den = np.sqrt((tp + fp) * (tp + fn) * (tn + fp) * (tn + fn))\n    mcc.append((tp * tn - fp * fn) / mcc_den if mcc_den > 0 else 0.0)\n\nmetric_arrs = [f1, iou, youden, mcc]\ntarget = np.asarray(metric_arrs[metric_sel])\nraw_best_i = int(np.argmax(target))\n\n# Robust pick: on a near-flat curve, raw argmax lands on the first point right after a\n# sharp initial cliff (P is quasi-binary — almost the whole [eps, 1] range scores nearly\n# the same) — an artifact, not a meaningful cutoff. Picking the highest-t candidate\n# within tolerance is just as bad in the opposite direction: if the WHOLE range is\n# within tolerance (curve genuinely flat end-to-end), that degenerates to t≈1.0 (the\n# array boundary), an equally arbitrary and overly conservative extreme. The MEDIAN of\n# the tolerance-satisfying thresholds avoids both edges and centers the pick in\n# whatever plateau actually exists.\nTOL_FRAC = 0.99\nif target[raw_best_i] > 0:\n    cutoff = target[raw_best_i] * TOL_FRAC\n    candidates = np.flatnonzero(target >= cutoff)\nelse:\n    candidates = np.array([raw_best_i])\nplateau_frac = float(candidates.size) / max(len(thresholds), 1)\n\n# Pick rule. When the metric is broadly flat (wide plateau), a run-to-run-stable,\n# probabilistically meaningful cutoff (the semantic anchor = MC majority vote, 0.5) is\n# preferable to a GT-fitted argmax — PROVIDED the PRACTICAL cost of snapping to it is\n# small. Bootstrap \"distinguishability\" is NOT the criterion: with large pixel counts a\n# <1-point difference is statistically significant yet practically negligible. We snap\n# on absolute score cost and always report that cost, so the trade-off is explicit.\nANCHOR_COST_MAX = 0.03    # max metric drop (absolute) accepted to gain semantics/transferability\nanchor_i = int(np.argmin(np.abs(thresholds - anchor)))\n# Measure the cost against the value the rule would OTHERWISE pick (the plateau median),\n# not against raw_best_i. The raw argmax sits on the near-zero cliff and is the artifact\n# this rule exists to reject; costing the anchor against it inflates the gap and can\n# block a snap that should happen.\n_fallback_i = int(np.median(candidates).round()) if candidates.size else raw_best_i\nanchor_cost = float(target[_fallback_i] - target[anchor_i])\nanchor_cost_vs_raw_argmax = float(target[raw_best_i] - target[anchor_i])\nanchor_used = False\nif plateau_frac > 0.3 and anchor_cost <= ANCHOR_COST_MAX:\n    best_i = anchor_i; anchor_used = True\nelif candidates.size:\n    best_i = _fallback_i\nelse:\n    best_i = raw_best_i\nt_opt = float(thresholds[best_i])\nif plateau_frac > 0.3:\n    if anchor_used:\n        _msg = (f'snapped to semantic anchor t={anchor:g} (majority vote); '\n                f'cost vs data-optimum = {anchor_cost:.3f} {metric_names[metric_sel]} pts')\n    else:\n        _msg = (f'anchor t={anchor:g} costs {anchor_cost:.3f} pts (> {ANCHOR_COST_MAX}) '\n                f'— kept plateau median instead')\n    print(f'WARN: {metric_names[metric_sel]} within {TOL_FRAC:.0%} of max over '\n          f'{plateau_frac:.0%} of range — metric barely discriminates; {_msg}.')\n\n# ── Optional bootstrap 95% CI band on the selected metric ─────────────────────\n# Resamples domain pixels with replacement to put an uncertainty band around the\n# metric-vs-threshold curve. If the best threshold's CI overlaps most of the curve,\n# the \"optimal\" threshold is not statistically distinguishable (the plateau is flat\n# within sampling noise) — the honest answer to \"does this metric justify a cutoff?\".\ntry:\n    n_boot = int(round(float(f)))\nexcept Exception:\n    n_boot = 0\n_BOOT_MAX_PX = 40000   # subsample cap (perf only); CI width is set by class sizes, not this\nci_lo = ci_hi = None\nout_ci = None\nif n_boot > 0:\n    _dom_idx = np.flatnonzero(domain.ravel())\n    _Pv = Pw.ravel()[_dom_idx]\n    _Tv = truth.ravel()[_dom_idx]\n    _ok = np.isfinite(_Pv)\n    _Pv = _Pv[_ok]; _Tv = _Tv[_ok]\n    _n = _Pv.size\n    if _n > _BOOT_MAX_PX:\n        _sub = np.random.default_rng(0).choice(_n, _BOOT_MAX_PX, replace=False)\n        _Pv = _Pv[_sub]; _Tv = _Tv[_sub]; _n = _BOOT_MAX_PX\n    if _n >= 30:\n        _predmat = _Pv[:, None] >= thresholds[None, :]     # (n, T) computed once\n        _boot = np.empty((n_boot, thresholds.size), np.float64)\n        _rng_b = np.random.default_rng(12345)\n        for _bi in range(n_boot):\n            _s = _rng_b.integers(0, _n, _n)\n            _pm = _predmat[_s]; _tc = _Tv[_s][:, None]\n            _tp = (_pm & _tc).sum(0).astype(np.float64)\n            _fp = (_pm & ~_tc).sum(0).astype(np.float64)\n            _fn = (~_pm & _tc).sum(0).astype(np.float64)\n            _tn = (~_pm & ~_tc).sum(0).astype(np.float64)\n            _boot[_bi] = _metric_curve(_tp, _fp, _fn, _tn, metric_sel)\n        ci_lo = np.nanpercentile(_boot, 2.5, axis=0)\n        ci_hi = np.nanpercentile(_boot, 97.5, axis=0)\n        _blo, _bhi = float(ci_lo[best_i]), float(ci_hi[best_i])\n        # fraction of thresholds whose point estimate falls inside the best CI\n        _within = float(((target >= _blo) & (target <= _bhi)).mean())\n        out_ci = {'metric': metric_names[metric_sel], 'n_boot': n_boot,\n                  'ci95_at_topt': [round(_blo, 4), round(_bhi, 4)],\n                  'ci_width_at_topt': round(_bhi - _blo, 4),\n                  'frac_thresholds_within_best_CI': round(_within, 3),\n                  'threshold_statistically_distinguishable': bool(_within < 0.5)}\n        print('bootstrap CI:', out_ci)\n\n# Plot: skip the near-0 cliff (t < PLOT_MIN) so the flat trade-off is readable instead\n# of being visually crushed by the vertical transition.\nPLOT_MIN = 0.05\nvis = thresholds >= PLOT_MIN\nfig = plt.figure(figsize=(7.5, 4.8), dpi=110)\nax = fig.add_subplot(111)\nax.plot(thresholds[vis], np.asarray(prec)[vis], label='Precision', color='tab:blue', lw=1.3)\nax.plot(thresholds[vis], np.asarray(rec)[vis], label='Recall', color='tab:orange', lw=1.3)\nax.plot(thresholds[vis], np.asarray(f1)[vis], label='F1', color='tab:green', lw=1.8)\nax.plot(thresholds[vis], np.asarray(iou)[vis], label='IoU', color='tab:purple', lw=1.3, ls='--')\nax.plot(thresholds[vis], np.asarray(mcc)[vis], label='MCC (uses TN too)', color='tab:red', lw=1.3, ls='-.')\nif ci_lo is not None:\n    ax.fill_between(thresholds[vis], ci_lo[vis], ci_hi[vis], color='tab:gray', alpha=0.25,\n                    label=f'{metric_names[metric_sel]} 95% CI (bootstrap, n={n_boot})')\nax.axhline(0, c='gray', lw=0.6)\n_pick_tag = f'anchor {anchor:g}' if anchor_used else 'plateau median'\nax.axvline(t_opt, ls=':', c='k', lw=1.6,\n           label=f'chosen t = {t_opt:.3f} ({_pick_tag})  {metric_names[metric_sel]}={target[best_i]:.3f}, '\n                 f'plateau={plateau_frac:.0%}')\nax.set_xlabel(f'P(water) threshold  (t < {PLOT_MIN} clipped — near-0 cliff)'); ax.set_ylabel('Score')\n_flag = '  ⚠ flat metric' if plateau_frac > 0.3 else ''\n_pick_desc = f'semantic anchor {anchor:g}' if anchor_used else 'plateau median'\nax.set_title(f'Threshold sweep — optimizing {metric_names[metric_sel]} ({_pick_desc} pick){_flag}')\n_ymin = min(-0.05, float(np.min(mcc)) - 0.05)\nax.set_ylim(_ymin, 1.02); ax.grid(alpha=0.3); ax.legend(fontsize=8, loc='lower left')\nfig.tight_layout(); fig.canvas.draw()\n_w, _h = fig.canvas.get_width_height()\nout_curve = np.frombuffer(fig.canvas.buffer_rgba(), dtype=np.uint8).reshape(_h, _w, 4)[..., :3].copy()\nplt.close(fig)\n\nout_optimal_threshold = float(t_opt)\nout_optimal_threshold_255 = float(round(t_opt * 255))\nout_best = {'threshold': round(t_opt, 4), 'precision': round(prec[best_i], 4),\n            'recall': round(rec[best_i], 4), 'f1': round(f1[best_i], 4),\n            'iou': round(iou[best_i], 4), 'mcc': round(float(mcc[best_i]), 4),\n            'metric_used': metric_names[metric_sel],\n            'raw_argmax_threshold': round(float(thresholds[raw_best_i]), 4),\n            'plateau_fraction': round(plateau_frac, 3),\n            'semantic_anchor': anchor, 'anchor_used': bool(anchor_used),\n            'anchor_cost': round(anchor_cost, 4),\n            'anchor_cost_vs_raw_argmax': round(anchor_cost_vs_raw_argmax, 4)}\nif out_ci is not None:\n    out_best['bootstrap_ci'] = out_ci\nprint('threshold sweep best:', out_best)\n",
          "color_index": 3,
          "node_note": "Balaie P(water) 0->1, trouve le seuil optimal (metrique choisie via d). a=P(acc_mean), b=GT aligne (out_gt), c=domaine(opt), d=metrique(0=F1 1=IoU 2=Youden), e=step. c=domaine corridor BRANCHE (avant: scene entiere -> metriques gonflees)"
        },
        "ports": [
          {
            "id": "image__a",
            "color": "image",
            "label": "a = P"
          },
          {
            "id": "mask__b",
            "color": "mask",
            "label": "b = truth (GT)"
          },
          {
            "id": "mask__c",
            "color": "mask",
            "label": "c = domain (opt)"
          },
          {
            "id": "scalar__d",
            "color": "scalar",
            "label": "d = metric (0=F1 1=IoU 2=Youden)"
          },
          {
            "id": "scalar__e",
            "color": "scalar",
