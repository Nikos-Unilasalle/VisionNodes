    {
      "id": "mc_cal",
      "type": "logic_python",
      "position": {
        "x": 3180,
        "y": 2240
      },
      "style": {},
      "data": {
        "label": "Python Node",
        "userLabel": "MC Calibration (Brier/ECE/⟨U⟩)",
        "params": {
          "code": "# MC Calibration — Brier score, Expected/Maximum Calibration Error, mean uncertainty.\n#   a = P (acc_mean image, 0-255) = predicted water probability\n#   b = truth mask (aligned GT, water=1)\n#   c = domain mask (opt, restricts evaluation to the river corridor)\n#   d = MC uncertainty map σ_P (opt, from the std accumulator) — for ⟨U⟩ = ⟨σ_P⟩\n#   e = number of reliability bins (opt, default 12)\n# Checks whether P behaves as a calibrated probability (pixels at P≈q are water ~q of\n# the time), not merely a rank score. Reliability diagram + Brier + ECE/MCE + ⟨U⟩.\nimport numpy as np\nimport matplotlib; matplotlib.use('Agg')\nimport matplotlib.pyplot as plt\n\nP = (a[..., 0] if a.ndim == 3 else a).astype(np.float64) / 255.0\ny = ((b[..., 0] if b.ndim == 3 else b) > 127).astype(np.float64)\ntry:\n    dom = (c[..., 0] if c.ndim == 3 else c) > 127\nexcept Exception:\n    dom = np.ones(P.shape, bool)\ntry:\n    nb = int(round(float(e)))\nexcept Exception:\n    nb = 12\nnb = min(max(nb, 3), 50)\n\nm = dom & np.isfinite(P) & np.isfinite(y)\nPv = P[m]; yv = y[m]\nn = Pv.size\nassert n >= 30, f\"too few pixels in domain ({n})\"\n\n# Brier score = mean squared error between probability and binary outcome\nbrier = float(np.mean((Pv - yv) ** 2))\n\n# Reliability: bin by predicted probability, compare mean confidence vs empirical accuracy\nedges = np.linspace(0.0, 1.0, nb + 1)\nidx = np.clip(np.digitize(Pv, edges) - 1, 0, nb - 1)\nconf = np.full(nb, np.nan); acc = np.full(nb, np.nan); cnt = np.zeros(nb)\nfor k in range(nb):\n    s = idx == k\n    cnt[k] = s.sum()\n    if cnt[k] > 0:\n        conf[k] = Pv[s].mean()\n        acc[k] = yv[s].mean()\nw = cnt / n\nok = cnt > 0\nece = float(np.sum(w[ok] * np.abs(acc[ok] - conf[ok])))          # expected calibration error\nmce = float(np.max(np.abs(acc[ok] - conf[ok]))) if ok.any() else float('nan')  # maximum\n\n# Mean uncertainty ⟨U⟩: prefer the MC ensemble std map if provided, else Bernoulli\n# predictive variance P(1-P) (peaks at P=0.5 = maximal indecision).\n# sigma_P = main * scale / 255**2 (see the accumulator docstring). Without `scale`\n# the map is a RELATIVE std (max pinned to 255) and mean(sig) is not an uncertainty.\n# The Bernoulli fallback is sqrt(P(1-P)) — a standard deviation — so both branches\n# report the same quantity in the same units.\ntry:\n    SCALE_U = float(f)\nexcept Exception:\n    SCALE_U = None\ntry:\n    sig = (d[..., 0] if d.ndim == 3 else d).astype(np.float64)\n    if SCALE_U is None:\n        raise ValueError('acc_std.scale not wired into f: sigma map is relative')\n    sig = sig * SCALE_U / (255.0 ** 2)\n    U = float(np.mean(sig[m])); U_src = 'ensemble_std'\nexcept Exception as _err:\n    U = float(np.mean(np.sqrt(Pv * (1.0 - Pv)))); U_src = 'bernoulli_std'\n    print(f'WARN: falling back to Bernoulli std — {_err}')\n\n# ── Reliability diagram (+ bin-count histogram) ───────────────────────────────\nfig = plt.figure(figsize=(6.2, 6.6), dpi=110)\ngs = fig.add_gridspec(3, 1, height_ratios=[3, 1, 0.05], hspace=0.08)\naxr = fig.add_subplot(gs[0]); axh = fig.add_subplot(gs[1], sharex=axr)\naxr.plot([0, 1], [0, 1], ls='--', c='k', lw=1.0, label='perfect calibration')\naxr.plot(conf[ok], acc[ok], 'o-', color='tab:blue', lw=1.6, ms=5, label='observed')\naxr.set_ylabel('Empirical accuracy (fraction water)')\naxr.set_xlim(0, 1); axr.set_ylim(0, 1); axr.grid(alpha=0.3)\naxr.set_title('Reliability diagram — MC P(water)')\naxr.text(0.03, 0.97,\n         f'Brier = {brier:.4f}\\nECE = {ece:.4f}\\nMCE = {mce:.4f}\\n⟨U⟩ = {U:.4f} ({U_src})',\n         transform=axr.transAxes, va='top', fontsize=9,\n         bbox=dict(boxstyle='round,pad=0.35', fc='white', ec='0.7'))\naxr.legend(loc='lower right', fontsize=9)\naxh.bar((edges[:-1] + edges[1:]) / 2, w, width=(1.0 / nb) * 0.9,\n        color='tab:gray', alpha=0.6)\naxh.set_ylabel('frac.'); axh.set_xlabel('Predicted P(water)'); axh.grid(alpha=0.3)\nfig.subplots_adjust(left=0.13, right=0.97, top=0.93, bottom=0.09)\nfig.canvas.draw()\n_w, _h = fig.canvas.get_width_height()\nout_reliability = np.frombuffer(fig.canvas.buffer_rgba(), dtype=np.uint8).reshape(_h, _w, 4)[..., :3].copy()\nplt.close(fig)\n\n# Equal-width bins are dominated by whichever bins the mass happens to fall in, and ECE\n# is known to be binning-sensitive (Kumar 2019; Nixon 2019; Roelofs 2022). Recompute on\n# EQUAL-MASS bins so every bin carries the same weight, and report both: a large gap\n# between them means the number is an artefact of the binning, not of the model.\n_q = np.unique(np.quantile(Pv, np.linspace(0.0, 1.0, nb + 1)))\nif _q.size >= 3:\n    _idx = np.clip(np.digitize(Pv, _q[1:-1]), 0, _q.size - 2)\n    _nb2 = _q.size - 1\n    _acc = np.full(_nb2, np.nan); _conf = np.full(_nb2, np.nan); _cnt = np.zeros(_nb2)\n    for _k in range(_nb2):\n        _s = _idx == _k\n        _cnt[_k] = _s.sum()\n        if _cnt[_k] > 0:\n            _conf[_k] = Pv[_s].mean(); _acc[_k] = yv[_s].mean()\n    _ok2 = _cnt > 0\n    ece_em = float(np.sum((_cnt[_ok2] / n) * np.abs(_acc[_ok2] - _conf[_ok2])))\n    n_bins_em = int(_nb2)\nelse:\n    ece_em, n_bins_em = float('nan'), 0\n\nout_cal = {'brier': round(brier, 4), 'ece': round(ece, 4), 'mce': round(mce, 4),\n           'ece_equal_mass': (None if ece_em != ece_em else round(ece_em, 4)),\n           'ece_equal_mass_bins': n_bins_em,\n           'ece_binning_sensitive': (None if ece_em != ece_em\n                                     else bool(abs(ece_em - ece) > 0.5 * max(ece, 1e-9))),\n           'mean_uncertainty': round(U, 4), 'uncertainty_source': U_src,\n           'n_bins': nb, 'n_pixels': int(n)}\nprint('calibration:', out_cal)\n",
          "color_index": 3,
          "node_note": "Calibration de P: Brier, ECE/MCE, reliability diagram, <U>. a=P, b=GT aligne, c=domaine, d=sigma map (acc_std), e=n_bins, f=acc_std.scale (sinon <U> retombe sur sqrt(P(1-P))). c=domaine corridor BRANCHE (avant: scene entiere)"
        },
        "ports": [
          {
            "id": "image__a",
            "color": "image",
            "label": "a = P"
          },
          {
            "id": "mask__b",
            "color": "mask",
            "label": "b = truth (GT)"
          },
          {
            "id": "mask__c",
            "color": "mask",
            "label": "c = domain (opt)"
          },
          {
            "id": "image__d",
            "color": "image",
            "label": "d = σ_P map (opt)"
          },
          {
            "id": "scalar__e",
            "color": "scalar",
            "label": "e = n_bins"
          },
          {
            "id": "scalar__f",
            "color": "scalar",
            "label": "f = acc_std.scale"
          }
        ],
        "outPorts": [
          {
            "id": "image__out_reliability",
            "color": "image",
            "label": "reliability diagram"
          },
          {
            "id": "any__out_cal",
            "color": "any",
            "label": "calibration stats"
          }
        ]
      },
      "width": 208,
