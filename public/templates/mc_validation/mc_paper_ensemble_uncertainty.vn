    {
      "id": "ref_agree",
      "type": "logic_python",
      "position": {
        "x": 2240,
        "y": 3800
      },
      "width": 208,
      "height": 200,
      "selected": false,
      "dragging": false,
      "positionAbsolute": {
        "x": 2240,
        "y": 3800
      },
      "data": {
        "label": "Python Node",
        "userLabel": "Reference agreement (validation ceiling)",
        "params": {
          "code": "# Reference agreement — how much of the \"error\" is the reference, not the prediction?\n#   a = reference A mask (e.g. WorldCover 10 m, annual permanent water)\n#   b = reference B mask (e.g. GSW MonthlyHistory, dated, 30 m)\n#   c = validity mask of B (opt) — GSW code 0 means NOT OBSERVED, never \"land\"\n#   d = domain mask (opt)\n# Two independent references disagree. That disagreement is a CEILING on the validation:\n# a metric difference smaller than the reference-to-reference gap is not interpretable.\n# The node also separates the two causes of disagreement:\n#   * boundary placement / coarse sampling -> fixed by dilating the coarser reference\n#   * genuine class disagreement (seasonality, product error) -> persists in the CORES\nimport numpy as np\nimport cv2\nimport matplotlib; matplotlib.use('Agg')\nimport matplotlib.pyplot as plt\n\ndef _g(m):\n    if m is None: return None\n    x = m[..., 0] if m.ndim == 3 else m\n    return x > 127\n\nA, B = _g(a), _g(b)\nassert A is not None and B is not None, 'two reference masks required (a, b)'\nassert A.shape == B.shape, f'grid mismatch {A.shape} vs {B.shape}'\n\nvalid = _g(c)\nif valid is None:\n    valid = np.ones(A.shape, bool)\ndom = _g(d)\nif dom is not None:\n    valid = valid & dom\n\ndef _iou(x, y):\n    x, y = x & valid, y & valid\n    u = int((x | y).sum())\n    return float((x & y).sum()) / u if u else float('nan')\n\nCORE_PX = 3                      # 30 m = 3 Sentinel-2 pixels\n_k = cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (2 * CORE_PX + 1,) * 2)\n_dil = lambda m, p: (cv2.dilate(m.astype(np.uint8),\n                     cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (2*p+1,)*2)) > 0) if p else m\n_ero = lambda m: cv2.erode(m.astype(np.uint8), _k) > 0\n\nbase = _iou(A, B)\nsweep = {p * 10: _iou(A, _dil(B, p)) for p in range(0, 6)}\nbest_px = max(sweep, key=lambda k: sweep[k])\n\nA_core, B_core = _ero(A) & valid, _ero(B) & valid\ncore_b_in_a = float((B_core & A).sum()) / max(int(B_core.sum()), 1)\ncore_a_in_b = float((A_core & B).sum()) / max(int(A_core.sum()), 1)\n\nnA, nB = int((A & valid).sum()), int((B & valid).sum())\nonly_a = int((A & ~B & valid).sum())\nonly_b = int((B & ~A & valid).sum())\n\nfig = plt.figure(figsize=(12, 4.2), dpi=110)\n\nax1 = fig.add_subplot(131)\nks = sorted(sweep)\nax1.plot(ks, [sweep[k] for k in ks], '-o', ms=4, color='tab:blue')\nax1.axvline(best_px, ls=':', c='tab:green', lw=1.5, label=f'peak at +{best_px} m')\nax1.set_xlabel('dilation applied to reference B (m)'); ax1.set_ylabel('IoU(A, B)')\nax1.set_title('Is the gap just coarse sampling?')\nax1.grid(alpha=0.3); ax1.legend(fontsize=8)\n\nax2 = fig.add_subplot(132)\nax2.bar(['B core\\nin A', 'A core\\nin B'], [core_b_in_a, core_a_in_b],\n        color=['tab:blue', 'tab:orange'])\nfor i, v in enumerate((core_b_in_a, core_a_in_b)):\n    ax2.text(i, v + 0.01, f'{v:.4f}', ha='center', fontsize=9)\nax2.set_ylim(0, 1.08); ax2.set_ylabel('fraction of core inside the other reference')\nax2.set_title(f'Interior agreement (cores eroded {CORE_PX*10} m)\\nresidual here = real disagreement')\nax2.grid(axis='y', alpha=0.3)\n\nax3 = fig.add_subplot(133)\nrgb = np.zeros((*A.shape, 3), np.uint8)\nrgb[(A & B) & valid] = (90, 90, 90)\nrgb[(A & ~B) & valid] = (255, 140, 0)\nrgb[(B & ~A) & valid] = (0, 140, 255)\nrgb[~valid] = (60, 0, 60)\nax3.imshow(rgb); ax3.set_xticks([]); ax3.set_yticks([])\nax3.set_title('grey = agree · orange = A only · blue = B only\\npurple = B unobserved')\n\nfig.suptitle(f'Reference-to-reference agreement — IoU = {base:.4f} '\n             f'(validation ceiling)', fontsize=12)\nfig.tight_layout(rect=[0, 0, 1, 0.92])\nfig.canvas.draw()\n_w, _h = fig.canvas.get_width_height()\nout_fig = np.frombuffer(fig.canvas.buffer_rgba(), dtype=np.uint8).reshape(_h, _w, 4)[..., :3].copy()\nplt.close(fig)\n\nout_stats = {\n    'iou_A_vs_B': round(base, 4),\n    'disagreement_fraction_of_union': round(1.0 - base, 4),\n    'iou_sweep_by_dilation_m': {k: round(v, 4) for k, v in sweep.items()},\n    'best_dilation_m': best_px,\n    'iou_at_best_dilation': round(sweep[best_px], 4),\n    'core_B_inside_A': round(core_b_in_a, 4),\n    'core_A_inside_B': round(core_a_in_b, 4),\n    'n_A_px': nA, 'n_B_px': nB,\n    'area_ratio_B_over_A': round(nB / nA, 4) if nA else None,\n    'A_only_px': only_a, 'B_only_px': only_b,\n    'n_valid_px': int(valid.sum()),\n    'interpretation': (\n        'Metric differences smaller than the A/B gap are inside reference noise. '\n        'If IoU rises when B is dilated and the cores agree, the gap is boundary '\n        'sampling, not class disagreement — so B is unusable for boundary metrics '\n        'but fine for area, and A is unusable for temporal claims.'),\n}\nout_iou = float(base)\nprint('reference agreement:', out_stats)\n",
          "color_index": 4,
          "node_note": "Plafond de validation. Mesure IoU(WorldCover, GSW) et separe les deux causes du desaccord: balayage de dilatation (echantillonnage 30 m) vs accord des coeurs erodes (desaccord de classe reel). Mesure sur la Seine 2021-09: IoU=0.715, coeurs a 0.996/0.963 -> le desaccord est quasi exclusivement de la frontiere, pas de la saisonnalite. a=WorldCover, b=GSW, c=GSW valid, d=domaine."
        },
        "ports": [
          {
            "id": "mask__a",
            "color": "mask",
            "label": "a = ref A (WorldCover 10 m)"
          },
