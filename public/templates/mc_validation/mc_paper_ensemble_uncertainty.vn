    {
      "id": "mc_conv",
      "type": "logic_python",
      "position": {
        "x": 2400,
        "y": 1500
      },
      "style": {},
      "data": {
        "label": "Python Node",
        "userLabel": "MC Convergence",
        "params": {
          "code": "# MC Convergence monitor — scene-mean standard error of P vs number of MC steps.\n#   a = MC std map (acc_std 'main', 0-255)   b = frame_count N (scalar)\n#   c = domain mask (opt)   d = SE tolerance (opt, default 0.01)   e = min N before eval (opt, default 5)\n# SE(N) = mean_pixels(σ_P) / sqrt(N), σ_P = per-pixel ensemble std in P units.\n# Optimal N = first N (>= min_n) where SE < tolerance. Curve accumulates in `state` across ticks.\nimport numpy as np\nimport matplotlib; matplotlib.use('Agg')\nimport matplotlib.pyplot as plt\n\ntry: TOL = float(d)\nexcept Exception: TOL = 0.01        # SE target in P units (P stable to ~TOL)\ntry: MIN_N = int(round(float(e)))\nexcept Exception: MIN_N = 5         # ignore the noisy first ticks when picking optimal N\n\n# sigma recovery. The accumulator's `main` is uint8, so physical units require its\n# `scale` output:  value_in_input_units = main / 255 * scale.  Frames are 0/255 masks,\n# therefore  sigma_P = main * scale / 255**2.\n# With normalize=True the map is max-normalised (scale = sigma_max) AND its maximum is\n# re-pinned to 255 on every tick, so it cannot decrease as N grows: SE would then fall\n# as 1/sqrt(N) by arithmetic alone, wrong by an unreported 1/sigma_max factor.\ntry:\n    SCALE = float(f)\nexcept Exception:\n    SCALE = 255.0\n    print('WARN: acc_std.scale not wired into f — assuming scale=255. If the '\n          'accumulator runs with normalize=True, the SE below is a RELATIVE value, '\n          'not probability units.')\nsig = (a[..., 0] if a.ndim == 3 else a).astype(np.float64) * SCALE / (255.0 ** 2)\ntry:\n    N = int(round(float(b)))\nexcept Exception:\n    N = 0\ntry:\n    dom = (c[..., 0] if c.ndim == 3 else c) > 127\nexcept Exception:\n    dom = np.ones(sig.shape, bool)\nm = dom & np.isfinite(sig)\nsd = float(sig[m].mean()) if m.any() else float('nan')\nse = sd / np.sqrt(max(N, 1))\n\nhist = state.get('conv_hist')\nif hist is None or N < int(state.get('conv_lastN', 0)):   # new run → reset history\n    hist = []\nstate['conv_lastN'] = N\nif N >= 2 and np.isfinite(se):\n    if not hist or hist[-1][0] != N:                      # one point per distinct N\n        hist.append((N, se))\nstate['conv_hist'] = hist\n\nNs = [h[0] for h in hist]; SEs = [h[1] for h in hist]\nopt_N = -1\nfor nn, ss in hist:\n    if nn >= MIN_N and ss < TOL:\n        opt_N = nn; break\n\nfig = plt.figure(figsize=(7.0, 4.5), dpi=110)\nax = fig.add_subplot(111)\nif Ns:\n    ax.plot(Ns, SEs, '-o', ms=3, color='tab:blue', label='SE of P = σ/√N')\nax.axhline(TOL, ls='--', c='k', lw=0.8, label=f'tolerance = {TOL}')\nif opt_N > 0:\n    ax.axvline(opt_N, ls=':', c='tab:green', lw=1.6, label=f'optimal N ≈ {opt_N}')\nax.set_xlabel('MC steps (N)'); ax.set_ylabel('Scene-mean SE of P')\nax.set_title('Monte-Carlo convergence'); ax.grid(alpha=0.3)\nif len(SEs) >= 2 and min([s for s in SEs if s > 0] or [1]) > 0:\n    try: ax.set_yscale('log')\n    except Exception: pass\nax.legend(fontsize=8, loc='upper right')\nfig.tight_layout(); fig.canvas.draw()\n_w, _h = fig.canvas.get_width_height()\nout_curve = np.frombuffer(fig.canvas.buffer_rgba(), dtype=np.uint8).reshape(_h, _w, 4)[..., :3].copy()\nplt.close(fig)\n\nout_optimal_N = float(opt_N)\nout_se = float(se)\nprint(f'N={N}  SE={se:.4f}  optimal_N={opt_N}  (points={len(hist)})')\n",
          "color_index": 3,
          "node_note": "Courbe SE=sigma/sqrt(N) vs N. a=acc_std.main, b=frame_count, c=domaine, d=tol, e=minN, f=acc_std.scale (OBLIGATOIRE: sans lui sigma est relatif et la SE est fausse)."
        },
        "ports": [
          {
            "id": "image__a",
            "color": "image",
            "label": "a = σ map (acc_std)"
          },
          {
            "id": "scalar__b",
            "color": "scalar",
