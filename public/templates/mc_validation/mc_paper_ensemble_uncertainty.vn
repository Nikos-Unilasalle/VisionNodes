          {
            "id": "scalar__e",
            "color": "scalar",
            "label": "e = acc_std.scale"
          }
        ],
        "outPorts": [
          {
            "id": "image__out_fig",
            "color": "image",
            "label": "envelope diagnostic"
          },
          {
            "id": "any__out_stats",
            "color": "any",
            "label": "R² / residual stats"
          }
        ]
      }
    },
