    {
      "id": "node-1782710392200-fj2ugkk3u",
      "type": "logic_python",
      "position": {
        "x": 2680,
        "y": 200
      },
      "style": {},
      "data": {
        "label": "Python Node",
        "params": {
          "code": "# Index Correlation (threshold-independent validation)\n# Entrees positionnelles logic_python :\n#   a = MC P(water)  (image 0-255, acc_mean)\n#   b = idx.stack    (geotiff, N bandes = indices)\n#   c = open-water reference (mask, optionnel)\n#   d = river-extent reference (mask, optionnel)\n# Sorties : out_fig (image), out_stats (dict)\nimport numpy as np\nfrom scipy.stats import spearmanr\nimport matplotlib; matplotlib.use('Agg')\nimport matplotlib.pyplot as plt\n\ntry:\n    a; b\nexcept Exception:\n    raise RuntimeError(\"entrees requises: a = P (acc_mean), b = idx.stack\")\ntry: _c = c\nexcept Exception: _c = None\ntry: _d = d\nexcept Exception: _d = None\ntry: _e = e\nexcept Exception: _e = None\n\ndef _g(m):\n    if m is None: return None\n    x = m[..., 0] if m.ndim == 3 else m\n    return x > 127\n\nPw = (a[..., 0] if a.ndim == 3 else a).astype(np.float64) / 255.0\nprint(f'P stats: min={Pw.min():.3f} max={Pw.max():.3f} std={Pw.std():.4f}')\nif Pw.std() < 1e-9:\n    print('WARN: P constant (variance nulle) -> Spearman indefini. Lance le MC (noise run) pour accumuler P.')\n\nbands = np.asarray(b['bands'], dtype=np.float64)                  # (N,H,W)\nnames = list(b.get('band_names') or [f'idx{i}' for i in range(bands.shape[0])])\nassert bands.shape[1:] == Pw.shape, f\"grille P{Pw.shape} != indices{bands.shape[1:]}\"\n\nOCC_OW, OCC_EXT = 75.0, 10.0        # seuils occurrence JRC GSW (%) : open-water / river-extent\n\ndef _fit(m):                        # fallback: aligne un masque simple par ratio de dimensions\n    if m is None or m.shape == Pw.shape: return m\n    H, W = Pw.shape\n    yi = (np.arange(H) * m.shape[0] / H).astype(np.intp)\n    xi = (np.arange(W) * m.shape[1] / W).astype(np.intp)\n    return m[np.ix_(yi, xi)]\n\ndef _reproj(gj):                    # rechantillonne un geotiff sur la grille P via les transforms (georef exact, nearest)\n    occ = np.asarray(gj['bands'], dtype=np.float64)\n    occ = occ[0] if occ.ndim == 3 else occ\n    Ba, _, Bc_, _, Be, Bf = [float(v) for v in tuple(b['transform'])[:6]]\n    Ja, _, Jc_, _, Je, Jf = [float(v) for v in tuple(gj['transform'])[:6]]\n    H, W = Pw.shape\n    Xc = Bc_ + (np.arange(W) + 0.5) * Ba          # X monde des centres colonnes (grille P)\n    Yr = Bf + (np.arange(H) + 0.5) * Be           # Y monde des centres lignes (grille P)\n    jc = np.clip(np.round((Xc - Jc_) / Ja - 0.5).astype(np.intp), 0, occ.shape[1] - 1)\n    jr = np.clip(np.round((Yr - Jf) / Je - 0.5).astype(np.intp), 0, occ.shape[0] - 1)\n    return occ[np.ix_(jr, jc)]\n\nOCC_GT = 50.0                       # seuil \"verite terrain fiable\" pour les metrics\nif isinstance(_c, dict) and 'bands' in _c and _c.get('transform') is not None:\n    occ = _reproj(_c)               # occurrence JRC recalee sur la grille P (georef exact)\n    ext = occ >= OCC_EXT            # river extent : eau vue >= 10 %\n    ow  = occ >= OCC_OW             # open water   : eau quasi-permanente >= 75 %\n    gt  = occ >= OCC_GT             # GT fiable    : eau >= 50 % (pour metrics)\nelse:                               # GT deja alignee sur la grille S2 (ex. geo_land_cover -> mask)\n    mc = _fit(_g(_c)); md = _fit(_g(_d))\n    ow  = mc if mc is not None else md\n    ext = md if md is not None else mc     # une seule GT-mask -> reference unique (ext=ow)\n    gt  = ext\n\nif ext is None: ext = np.ones(Pw.shape, bool)\nif ow  is None: ow  = ext\nif gt  is None: gt  = ext\nprint(f'classes px: ext={int(ext.sum())} ow={int(ow.sum())} gt={int(gt.sum())}')\nif not ext.any():\n    print('WARN: extent vide (JRC non fetch ? occ=nan ?) -> fallback scene entiere pour \"All river\".')\n    ext = np.ones(Pw.shape, bool)\n    if not ow.any(): ow = ext\n    if not gt.any(): gt = ext\n\n# Domaine d'analyse = GT dilatee, fournie en entree e (node feat_morphology_adv Dilate).\n# \"All river\" = TOUS les pixels du domaine (eau + berges) -> teste P~0 berge / P~1 eau.\n# Sans e -> domaine = ext (pas de marge).\ndom_in = _fit(_g(_e))\ndomain = dom_in if dom_in is not None else np.ones(Pw.shape, bool)  # whole-image when e unconnected\nbridge = domain & ~ow   # no OSM: negative class = non-water land/sediment\nprint(f'domain (All river) px={int(domain.sum())}  ext px={int(ext.sum())}')\n\n# masques recales sur la grille P -> a brancher sur sci_mask_metrics.truth\nout_ow     = (ow.astype(np.uint8) * 255)\nout_ext    = (ext.astype(np.uint8) * 255)\nout_gt     = (gt.astype(np.uint8) * 255)\nout_domain = (domain.astype(np.uint8) * 255)\n\nclasses = [('All river', domain, 'gray'),\n           ('Open water', ow, 'tab:blue'),\n           ('Land', bridge, 'tab:orange')]\n\ndef _rho(iv, m):\n    mm = m & np.isfinite(iv) & np.isfinite(Pw)\n    if mm.sum() < 10: return np.nan\n    r = spearmanr(Pw[mm], iv[mm]).correlation\n    return float(r) if r == r else np.nan\n\nN = bands.shape[0]\nR = {cn: [_rho(bands[i], cm) for i in range(N)] for cn, cm, _ in classes}\n\nfig = plt.figure(figsize=(13, 9), dpi=110)\ngs = fig.add_gridspec(2, N, height_ratios=[1.1, 1.0], hspace=0.4, wspace=0.3)\n\naxb = fig.add_subplot(gs[0, :])\nx = np.arange(N); w = 0.26\nfor k, (cn, cm, cc) in enumerate(classes):\n    vals = R[cn]\n    bars = axb.bar(x + (k - 1) * w, [0 if v != v else v for v in vals], w, label=cn, color=cc)\n    for bar, v in zip(bars, vals):\n        if v == v:\n            axb.text(bar.get_x() + bar.get_width() / 2, v + 0.01, f'{v:.3f}',\n                     ha='center', va='bottom', fontsize=8)\naxb.set_xticks(x); axb.set_xticklabels(names)\naxb.set_ylabel('Spearman r'); axb.set_ylim(0, 1.05)\naxb.set_title('Spearman: MC P(water) vs spectral index by pixel class — threshold independent')\naxb.legend(loc='upper right'); axb.grid(axis='y', alpha=0.3)\n\nrng = np.random.default_rng(0)\nfor i in range(N):\n    ax = fig.add_subplot(gs[1, i])\n    for cn, cm, cc in classes[::-1]:\n        m = cm & np.isfinite(bands[i])\n        idxp = np.flatnonzero(m.ravel())\n        if idxp.size > 4000:\n            idxp = rng.choice(idxp, 4000, replace=False)\n        ax.scatter(bands[i].ravel()[idxp], Pw.ravel()[idxp], s=2, c=cc, alpha=0.35, linewidths=0)\n    ax.axhline(0.7, ls='--', c='k', lw=0.8, alpha=0.6)\n    ax.set_title(f'P(water) vs {names[i]}'); ax.set_xlabel(names[i])\n    if i == 0: ax.set_ylabel('MC P(water)')\n    ax.set_ylim(-0.02, 1.02)\n    r_all = R['All river'][i]\n    ax.text(0.03, 0.95, f'Spearman r = {r_all:.3f}', transform=ax.transAxes, va='top',\n            bbox=dict(boxstyle='round', fc='white', ec='0.7'), fontsize=8)\n\nfig.suptitle('MC P(water) — Correlation with Spectral Indices', fontsize=13)\nfig.canvas.draw()\nw_, h_ = fig.canvas.get_width_height()\nout_fig = np.frombuffer(fig.canvas.buffer_rgba(), dtype=np.uint8).reshape(h_, w_, 4)[..., :3].copy()\nplt.close(fig)\n\nout_stats = {names[i]: {cn: (None if R[cn][i] != R[cn][i] else round(R[cn][i], 4))\n                        for cn, _, _ in classes} for i in range(N)}\nprint('Spearman r:', out_stats)\n\n# ── Value distributions: Open Water vs Land per feature (Δμ / Cohen's d / Mann-Whitney U) ──\nfrom scipy.stats import mannwhitneyu as _mwu\n_MWU_MAX_N = 20000   # subsample cap per group — U-statistic ranking cost grows with n\n\ndef _subsample(v, cap, rng):\n    return v if v.size <= cap else v[rng.choice(v.size, cap, replace=False)]\n\n_rng_mwu = np.random.default_rng(0)\n_feats = [('MC prob', Pw)] + [(names[i], bands[i]) for i in range(N)]\n_dmu = {}; _cohen = {}; _mw = {}\nfigd = plt.figure(figsize=(4.0 * len(_feats), 3.4), dpi=110)\nfor j, (fn, fv) in enumerate(_feats):\n    axd = figd.add_subplot(1, len(_feats), j + 1)\n    vo = fv[ow & np.isfinite(fv)]\n    vb = fv[bridge & np.isfinite(fv)]\n    if vo.size >= 2 and vb.size >= 2:\n        lo = float(min(vo.min(), vb.min())); hi = float(max(vo.max(), vb.max()))\n        if hi <= lo: hi = lo + 1e-6\n        edges = np.linspace(lo, hi, 40)\n        axd.hist(vb, bins=edges, density=True, color='tab:orange', alpha=0.75, label='Land (non-water)')\n        axd.hist(vo, bins=edges, density=True, color='tab:blue', alpha=0.75, label='Open water')\n        dmu = float(vo.mean() - vb.mean()); _dmu[fn] = round(dmu, 4)\n        n1, n0 = vo.size, vb.size\n        pooled = np.sqrt(((n1 - 1) * vo.var(ddof=1) + (n0 - 1) * vb.var(ddof=1)) / max(n1 + n0 - 2, 1))\n        dcoh = float(dmu / (pooled + 1e-12)); _cohen[fn] = round(dcoh, 3)\n\n        # Mann-Whitney U (nonparametric, no normality assumption) + rank-biserial effect size\n        vo_s = _subsample(vo, _MWU_MAX_N, _rng_mwu); vb_s = _subsample(vb, _MWU_MAX_N, _rng_mwu)\n        try:\n            u_stat, u_p = _mwu(vo_s, vb_s, alternative='two-sided')\n            r_rb = float(1.0 - 2.0 * u_stat / (vo_s.size * vb_s.size))  # rank-biserial correlation\n        except Exception:\n            u_p, r_rb = float('nan'), float('nan')\n        _mw[fn] = {'p': (None if u_p != u_p else round(float(u_p), 6)),\n                   'rank_biserial': (None if r_rb != r_rb else round(r_rb, 3)),\n                   'n_open_water': int(vo_s.size), 'n_bridge': int(vb_s.size)}\n\n        axd.set_title(f'Δμ = {dmu:.3f}   d = {dcoh:.2f}\\nMWU p{\"<0.001\" if u_p < 0.001 else f\"={u_p:.3f}\"}  r={r_rb:.2f}',\n                      fontsize=8.5)\n    else:\n        _dmu[fn] = None; _cohen[fn] = None; _mw[fn] = None\n        axd.set_title('Δμ = n/a')\n    if fn == 'MC prob':\n        axd.axvline(0.7, ls='--', c='k', lw=0.9, label='t = 0.7')\n        axd.legend(loc='upper left', fontsize=7)\n        axd.set_ylabel('Density')\n    axd.set_xlabel(fn)\nfigd.suptitle('Value Distributions — Open Water vs Land Pixels\\n'\n              \"Δμ = mean gap (raw) · d = Cohen's d (σ-normalized) · MWU = Mann-Whitney U test \"\n              \"(p, rank-biserial r — nonparametric, no normality assumption)\", fontsize=10)\nfigd.tight_layout(rect=[0, 0, 1, 0.88])\nfigd.canvas.draw()\n_wd, _hd = figd.canvas.get_width_height()\nout_dist = np.frombuffer(figd.canvas.buffer_rgba(), dtype=np.uint8).reshape(_hd, _wd, 4)[..., :3].copy()\nplt.close(figd)\nout_stats['delta_mu'] = _dmu\nout_stats['cohen_d'] = _cohen\nout_stats['mann_whitney'] = _mw\nprint('delta_mu:', _dmu)\nprint('cohen_d :', _cohen)\nprint('mann_whitney:', _mw)\n\n# ── Independent discriminability: index vs GT water (AUROC, P-free) ────────────\n# Cible = GT (ow = WorldCover water) vs non-eau du corridor (domaine & ~ow).\n# N'utilise PAS P -> classement des indices non circulaire.\nfrom scipy.stats import rankdata as _rankdata\n\ndef _auroc(iv, pos, neg):\n    va = iv[pos & np.isfinite(iv)]; vb = iv[neg & np.isfinite(iv)]\n    na, nb = va.size, vb.size\n    if na < 1 or nb < 1:\n        return np.nan\n    r = _rankdata(np.concatenate([va, vb]))\n    return float((r[:na].sum() - na * (na + 1) / 2.0) / (na * nb))\n\n_neg_dom = domain & ~ow                      # non-eau dans le corridor (terre + ponts)\n_auc = {}\nfor i in range(N):\n    a = _auroc(bands[i], ow, _neg_dom)\n    _auc[names[i]] = None if a != a else round(max(a, 1.0 - a), 4)   # oriente >= 0.5\n\n_lab = list(_auc.keys())\n_val = [(_auc[k] if _auc[k] is not None else 0.5) for k in _lab]\n_ordr = np.argsort(_val)[::-1]\n_lab = [_lab[j] for j in _ordr]; _val = [_val[j] for j in _ordr]\n\nfiga = plt.figure(figsize=(6.5, 4.0), dpi=110)\naxa = figa.add_subplot(111)\n_bars = axa.bar(_lab, _val, color='tab:green')\nfor _b, _v in zip(_bars, _val):\n    axa.text(_b.get_x() + _b.get_width() / 2, _v + 0.005, f'{_v:.3f}', ha='center', va='bottom', fontsize=9)\naxa.axhline(0.5, ls='--', c='k', lw=0.8)\naxa.set_ylim(0.5, 1.02); axa.set_ylabel('AUROC (water vs non-water GT)')\naxa.set_title('Independent index discriminability vs ground truth (P-free)\\n'\n              'Higher = better water / non-water separation')\nfiga.tight_layout()\nfiga.canvas.draw()\n_wa, _ha = figa.canvas.get_width_height()\nout_auroc = np.frombuffer(figa.canvas.buffer_rgba(), dtype=np.uint8).reshape(_ha, _wa, 4)[..., :3].copy()\nplt.close(figa)\nout_stats['auroc_vs_gt'] = _auc\nprint('auroc_vs_gt:', _auc)\n",
          "color_index": 0,
          "node_note": "Validation. a=P, b=idx.stack, c=ow(WorldCover water), d=ext(water∪bridge). All river = ext DILATEE (ROI_DILATE_PX dans le code). Open water=c, Land=domain&~c (no OSM). Plans d'eau conserves. e=domaine corridor BRANCHE (avant: image entiere)"
        },
