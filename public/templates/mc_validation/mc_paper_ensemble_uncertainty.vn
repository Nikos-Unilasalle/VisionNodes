    {
      "id": "overall_acc",
      "type": "logic_python",
      "position": {
        "x": 3180,
        "y": 2560
      },
      "style": {},
      "data": {
        "label": "Python Node",
        "userLabel": "Overall Accuracy",
        "params": {
          "code": "# Overall Accuracy — pixel-classification accuracy of pred vs ground truth.\n#   a = predicted water mask (0/255)\n#   b = truth mask (GT water, 0/255)\n#   c = domain mask (opt) — restrict evaluation to this footprint (e.g. river corridor)\n# OA = (TP + TN) / (TP + TN + FP + FN). Water is rare, so OA is dominated by the\n# background (a mask that predicts \"no water\" everywhere already scores very high).\n# Balanced accuracy = mean(recall_water, recall_land) is reported alongside as the\n# imbalance-robust companion; F1/IoU live in the dedicated metrics node.\nimport numpy as np\n\npred  = (a[..., 0] if a.ndim == 3 else a) > 127\ntruth = (b[..., 0] if b.ndim == 3 else b) > 127\ntry:\n    dom = (c[..., 0] if c.ndim == 3 else c) > 127\nexcept Exception:\n    dom = None\n\n# Defensive crop to common shape (GT is aligned, but never assume).\nh = min(pred.shape[0], truth.shape[0]); w = min(pred.shape[1], truth.shape[1])\npred = pred[:h, :w]; truth = truth[:h, :w]\nif dom is None:\n    dom = np.ones((h, w), bool)\nelse:\n    dom = dom[:h, :w]\n\np = pred[dom]; t = truth[dom]\nn = int(p.size)\nassert n > 0, \"empty evaluation domain\"\n\nTP = int(np.sum(p & t))\nTN = int(np.sum(~p & ~t))\nFP = int(np.sum(p & ~t))\nFN = int(np.sum(~p & t))\n\noa   = (TP + TN) / n\ntpr  = TP / (TP + FN) if (TP + FN) else float('nan')   # recall on water\ntnr  = TN / (TN + FP) if (TN + FP) else float('nan')   # recall on land\nbacc = float(np.nanmean([tpr, tnr]))\n\nout_accuracy = float(oa)\nout_stats = {\n    'overall_accuracy':  round(oa, 4),\n    'balanced_accuracy': round(bacc, 4),\n    'recall_water':      round(tpr, 4),\n    'recall_land':       round(tnr, 4),\n    'TP': TP, 'TN': TN, 'FP': FP, 'FN': FN,\n    'n_pixels': n,\n    'domain_restricted': bool(np.any(~dom)),\n}\nprint('overall accuracy:', out_stats)\n",
          "color_index": 3,
          "node_note": "Overall pixel accuracy OA=(TP+TN)/N de pred vs GT. a=pred(seuil avance), b=GT(landcover), c=domaine(opt, corr_dilate). Balanced accuracy reportee car l'eau est rare (OA domine par le fond). Comparable entre version MC et bypass."
        },
        "ports": [
          {
            "id": "mask__a",
            "color": "mask",
            "label": "a = pred"
          },
          {
            "id": "mask__b",
            "color": "mask",
            "label": "b = truth (GT)"
          },
          {
            "id": "mask__c",
            "color": "mask",
            "label": "c = domain (opt)"
          }
        ],
        "outPorts": [
          {
            "id": "scalar__out_accuracy",
            "color": "scalar",
            "label": "overall accuracy"
          },
          {
            "id": "any__out_stats",
            "color": "any",
            "label": "accuracy stats"
          }
        ]
      },
