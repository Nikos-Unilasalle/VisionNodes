    {
      "id": "sigma_check",
      "type": "logic_python",
      "position": {
        "x": 3180,
        "y": 2900
      },
      "style": {},
      "width": 208,
      "height": 217,
      "selected": false,
      "positionAbsolute": {
        "x": 3180,
        "y": 2900
      },
      "dragging": false,
      "data": {
        "label": "Python Node",
        "userLabel": "σ_P vs Bernoulli envelope",
        "params": {
          "code": "# sigma_P vs the Bernoulli envelope — is the uncertainty map informative?\n#   a = P (acc_mean.main, 0-255)      b = sigma map (acc_std.main, 0-255)\n#   c = domain mask (opt)             d = N (acc_std.frame_count)\n#   e = acc_std.scale (required for physical units)\n#\n# For a Bernoulli outcome sampled N times the per-pixel ensemble std is fully\n# determined by P:      sigma_bern = sqrt(P*(1-P))\n# If the measured sigma_P lies on that curve, the Monte-Carlo uncertainty map carries\n# NO information beyond P itself — it could be written in closed form from a single\n# deterministic run, and the \"uncertainty product\" is a restatement of P.\n# The only mechanisms that can push sigma_P off the envelope are (i) spatially\n# correlated noise, which makes realisations differ in coherent shapes rather than\n# independently per pixel, and (ii) the frozen reflectance gate, which correlates\n# errors across realisations.\n# This node quantifies the departure: R^2 against the envelope, the residual\n# distribution, and a map of where the residual concentrates.\nimport numpy as np\nimport matplotlib; matplotlib.use('Agg')\nimport matplotlib.pyplot as plt\n\ntry:\n    SCALE = float(e)\nexcept Exception:\n    SCALE = 255.0\n    print('WARN: acc_std.scale not wired into e — assuming 255. If acc_std runs with '\n          'normalize=True this comparison is meaningless (sigma would be relative).')\n\nP = (a[..., 0] if a.ndim == 3 else a).astype(np.float64) / 255.0\nS = (b[..., 0] if b.ndim == 3 else b).astype(np.float64) * SCALE / (255.0 ** 2)\ntry:\n    dom = (c[..., 0] if c.ndim == 3 else c) > 127\nexcept Exception:\n    dom = np.ones(P.shape, bool)\ntry:\n    N = max(int(round(float(d))), 1)\nexcept Exception:\n    N = 1\n\nassert S.shape == P.shape, f'grid mismatch P{P.shape} vs sigma{S.shape}'\nm = dom & np.isfinite(P) & np.isfinite(S)\nassert m.sum() >= 100, f'too few pixels in domain ({int(m.sum())})'\n\nPv, Sv = P[m], S[m]\n\n# Population std of N Bernoulli draws, computed the same way the accumulator does\n# (ddof=0, so the finite-N ceiling is sqrt(k(N-k))/N for k successes).\nenv = np.sqrt(np.clip(Pv * (1.0 - Pv), 0.0, None))\nresid = Sv - env\nss_res = float(np.sum(resid ** 2))\nss_tot = float(np.sum((Sv - Sv.mean()) ** 2))\nr2 = 1.0 - ss_res / (ss_tot + 1e-12)          # R^2 of the envelope AS A PREDICTOR of sigma\nrmse = float(np.sqrt(np.mean(resid ** 2)))\nbias = float(np.mean(resid))\nrel = float(np.mean(np.abs(resid)) / (np.mean(env) + 1e-12))\n\n# Pearson r on the pair, plus the same on the non-degenerate subset: pixels with\n# P in (eps, 1-eps). Fully-saturated pixels sit at sigma=0=env trivially and inflate\n# any agreement statistic — the question is only interesting where P is graded.\nEPS = 0.02\ng = (Pv > EPS) & (Pv < 1.0 - EPS)\ndef _pearson(x, y):\n    if x.size < 3 or x.std() < 1e-12 or y.std() < 1e-12:\n        return float('nan')\n    return float(np.corrcoef(x, y)[0, 1])\nr_all = _pearson(Sv, env)\nr_graded = _pearson(Sv[g], env[g])\nfrac_graded = float(g.mean())\n\nfig = plt.figure(figsize=(14, 4.6), dpi=110)\n\n# -- panel 1: sigma vs P, with the analytic envelope ---------------------------\nax1 = fig.add_subplot(131)\nrng = np.random.default_rng(0)\nidx = np.flatnonzero(m.ravel())\nif idx.size > 20000:\n    idx = rng.choice(idx, 20000, replace=False)\nax1.scatter(P.ravel()[idx], S.ravel()[idx], s=2, alpha=0.25, c='tab:blue',\n            linewidths=0, label='pixels')\npp = np.linspace(0, 1, 401)\nax1.plot(pp, np.sqrt(pp * (1 - pp)), 'k-', lw=1.6, label=r'$\\sqrt{P(1-P)}$ (Bernoulli)')\nax1.plot(pp, np.sqrt(pp * (1 - pp)) / np.sqrt(N), 'k--', lw=1.0,\n         label=r'$\\sqrt{P(1-P)/N}$ (SE)')\nax1.set_xlabel('MC P(water)'); ax1.set_ylabel(r'measured $\\sigma_P$')\nax1.set_title('Uncertainty vs the analytic envelope')\nax1.legend(fontsize=7, loc='upper right'); ax1.grid(alpha=0.3)\n\n# -- panel 2: residual distribution -------------------------------------------\nax2 = fig.add_subplot(132)\nax2.hist(resid, bins=60, color='tab:orange', alpha=0.8, density=True)\nax2.axvline(0, c='k', lw=1.0)\nax2.set_xlabel(r'$\\sigma_P - \\sqrt{P(1-P)}$'); ax2.set_ylabel('Density')\nax2.set_title('Residual w.r.t. the envelope')\nverdict = ('REDUNDANT with P' if (r2 > 0.98 and rel < 0.05)\n           else 'INFORMATIVE beyond P' if rel > 0.15\n           else 'weakly informative')\nax2.text(0.03, 0.96,\n         f'$R^2$ = {r2:.4f}\\nRMSE = {rmse:.4f}\\nbias = {bias:+.4f}\\n'\n         f'rel. dev. = {rel:.3f}\\nr (all) = {r_all:.4f}\\n'\n         f'r (graded) = {r_graded:.4f}\\ngraded frac = {frac_graded:.3f}\\nN = {N}\\n'\n         f'→ {verdict}',\n         transform=ax2.transAxes, va='top', fontsize=8,\n         bbox=dict(boxstyle='round,pad=0.35', fc='white', ec='0.7'))\nax2.grid(alpha=0.3)\n\n# -- panel 3: where the residual lives ----------------------------------------\nax3 = fig.add_subplot(133)\nrmap = np.full(P.shape, np.nan)\nrmap[m] = resid\nlim = float(np.nanpercentile(np.abs(rmap), 99)) or 1e-3\nim = ax3.imshow(rmap, cmap='RdBu_r', vmin=-lim, vmax=lim)\nax3.set_title('Residual map (blue = less spread than Bernoulli)')\nax3.set_xticks([]); ax3.set_yticks([])\nfig.colorbar(im, ax=ax3, fraction=0.046)\n\nfig.suptitle('Is the MC uncertainty map informative, or a restatement of P?', fontsize=12)\nfig.tight_layout(rect=[0, 0, 1, 0.93])\nfig.canvas.draw()\n_w, _h = fig.canvas.get_width_height()\nout_fig = np.frombuffer(fig.canvas.buffer_rgba(), dtype=np.uint8).reshape(_h, _w, 4)[..., :3].copy()\nplt.close(fig)\n\nout_stats = {\n    'r2_vs_bernoulli_envelope': round(r2, 5),\n    'rmse': round(rmse, 5),\n    'mean_bias': round(bias, 5),\n    'relative_deviation': round(rel, 4),\n    'pearson_r_all': (None if r_all != r_all else round(r_all, 5)),\n    'pearson_r_graded_only': (None if r_graded != r_graded else round(r_graded, 5)),\n    'graded_pixel_fraction': round(frac_graded, 4),\n    'mean_sigma_P': round(float(Sv.mean()), 5),\n    'mean_envelope': round(float(env.mean()), 5),\n    'N': N, 'scale': SCALE, 'n_pixels': int(m.sum()),\n    'verdict': verdict,\n}\nprint('sigma vs Bernoulli:', out_stats)\n",
          "color_index": 3,
          "node_note": "Decide si la carte d'incertitude est une contribution ou une redite de P. sigma_bern=sqrt(P(1-P)) est entierement determine par P: si R2~1 et rel.dev<0.05 la carte n'apporte rien. a=P, b=acc_std.main, c=domaine, d=frame_count, e=acc_std.scale."
        },
        "ports": [
          {
            "id": "image__a",
            "color": "image",
            "label": "a = P (acc_mean)"
          },
          {
            "id": "image__b",
            "color": "image",
            "label": "b = σ map (acc_std)"
