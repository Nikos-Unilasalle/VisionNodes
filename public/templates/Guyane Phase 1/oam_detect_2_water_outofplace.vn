    {
      "id": "n-det",
      "type": "logic_python",
      "position": {
        "x": -1180,
        "y": 120
      },
      "data": {
        "label": "Détecteur eau hors-place",
        "params": {
          "code": "import numpy as np, cv2\ndef _num(x,dv):\n    try: return float(x) if isinstance(x,(int,float)) else dv\n    except: return dv\ndef _band(x,i=0):\n    if not isinstance(x,dict): return None\n    A=np.asarray(x['bands'],dtype=np.float32)\n    return (A[i] if A.shape[0]>i else A[0]) if A.ndim==3 else A\ndef _fit(x,H,W):\n    if x is None: return None\n    if x.shape[0]!=H or x.shape[1]!=W: x=cv2.resize(x,(W,H),interpolation=cv2.INTER_LINEAR)\n    return np.where(np.isfinite(x),x,0.0).astype(np.float32)\ndef _morph(m,k=3):\n    ker=cv2.getStructuringElement(cv2.MORPH_ELLIPSE,(k,k))\n    return cv2.morphologyEx(m.astype(np.uint8),cv2.MORPH_OPEN,ker)>0\n# a=S2 b=flow c=HAND  d=CHANNEL_ACC(Number) e=NIR_MAX(Number)\nCHANNEL_ACC=_num(d,0.15); NIR_MAX=_num(e,0.14)\nCLOUD_B=0.15      # bleu > 0.15 = nuage (anti-nuage)\nMILK_FLOOR=0.055  # G+B > seuil = eau laiteuse, pas ombre\nMORPH_K=3\ntry:\n    geo=a if isinstance(a,dict) else None\n    if geo is None: out_main=None; out_any=None; out_dict={'erreur':'a=S2 b=flow c=HAND'}\n    else:\n        bd=np.asarray(geo['bands'],dtype=np.float32)\n        if float(np.nanmax(bd))>10.0: bd=bd/10000.0\n        R,Gr,B,NIR,SWIR=bd[0],bd[1],bd[2],bd[3],bd[4]\n        H,W=Gr.shape; npx=H*W\n        cloud=B>CLOUD_B\n        milky=(Gr+B)>MILK_FLOOR\n        water=_morph((NIR<NIR_MAX)&milky&(~cloud),MORPH_K)\n        flow=_fit(_band(b),H,W)\n        fl=np.log1p(np.clip(flow,0,None)); fl=fl/(fl.max()+1e-9)\n        on_river=fl>CHANNEL_ACC\n        oop=_morph(water&(~on_river),MORPH_K)\n        turq=np.clip((Gr+B)*0.5-R*0.5,0,0.1)/0.1\n        det=np.where(oop,np.clip(0.4+turq*0.6,0,1),0.0).astype(np.float32)\n        u8=(np.clip(det,0,1)*255).astype(np.uint8)\n        prev=cv2.applyColorMap(u8,cv2.COLORMAP_MAGMA); prev[det<0.05]=[0,0,0]\n        out_main=prev\n        out_any={**geo,'bands':det[np.newaxis],'count':1,'dtype':'float32','band_names':['detection'],'_bands':['detection']}\n        out_dict={'CHANNEL_ACC':round(CHANNEL_ACC,3),'NIR_MAX':round(NIR_MAX,3),\n                  'cloud_pct':round(float(cloud.sum())/npx*100,2),\n                  'water_pct':round(float(water.sum())/npx*100,2),\n                  'on_river_pct':round(float((water&on_river).sum())/npx*100,2),\n                  'detect_pct':round(float(oop.sum())/npx*100,3),\n                  'NIR_p':[round(float(np.nanpercentile(NIR,q)),3) for q in (5,50,95)],\n                  'B_p':[round(float(np.nanpercentile(B,q)),3) for q in (5,50,95)],\n                  'raw_max':round(float(np.nanmax(bd)),3)}\nexcept Exception as _e:\n    out_main=None; out_any=None; out_dict={'exception':str(_e),'type':type(_e).__name__}\n",
          "node_note": "a=S2 b=flow c=HAND → détection"
        }
      },
      "width": 208,
      "height": 249
    },
