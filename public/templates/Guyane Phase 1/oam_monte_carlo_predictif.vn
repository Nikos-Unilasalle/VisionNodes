    {
      "id": "f-attr",
      "type": "canvas_frame",
      "position": { "x": -500, "y": 30 },
      "data": { "label": "Attractivité calibrée OAM", "params": {} },
      "style": { "width": 380, "height": 490 },
      "width": 380,
      "height": 490
    },
    {
      "id": "n-note-attr",
      "type": "canvas_note",
      "position": { "x": -480, "y": 40 },
      "data": {
        "label": "Note",
        "params": {
          "text": "attr = exp(-slope/8) × exp(-HAND/5) × (0.3 + 0.7 × flow_norm)\nslope > 12° ou HAND > 8m → attractivité = 0\nflow_accumulation : les criques/rivières = corridors prioritaires",
          "color_index": 2
        }
      },
      "width": 340,
      "height": 80
    },
    {
      "id": "n-attr",
      "type": "logic_python",
      "position": { "x": -480, "y": 140 },
      "data": {
        "label": "Attractivité (OAM calibrated)",
        "params": {
          "code": "# ── Attractivité calibrée OAM — sites alluviaux illégaux Guyane ─────────────\n# a = slope geotiff (degrés)\n# b = HAND geotiff (mètres)\n# c = flow_accumulation geotiff (cellules drainées)\n#\n# Logique : les mineurs naviguent par les criques/rivières.\n# Le flow_accumulation identifie les corridors fluviaux.\n# Zones sans accès fluvial = attractivité réduite même si terrain favorable.\n\nSLOPE_MAX = 12.0\nHAND_MAX  = 8.0\n\nif not isinstance(a, dict) or not isinstance(b, dict):\n    out_main = None\nelse:\n    slope = np.asarray(a['bands'], dtype=np.float32)\n    slope = slope[0] if slope.ndim == 3 else slope\n    hand  = np.asarray(b['bands'], dtype=np.float32)\n    hand  = hand[0] if hand.ndim == 3 else hand\n    H, W  = slope.shape\n\n    if hand.shape != (H, W):\n        hand = cv2.resize(hand, (W, H), interpolation=cv2.INTER_LINEAR)\n\n    slope = np.where(np.isfinite(slope), slope, SLOPE_MAX + 1.0)\n    hand  = np.where(np.isfinite(hand),  hand,  HAND_MAX  + 1.0)\n\n    # Corridor fluvial : flow_accumulation log-normalisé\n    if isinstance(c, dict):\n        flow = np.asarray(c['bands'], dtype=np.float32)\n        flow = flow[0] if flow.ndim == 3 else flow\n        if flow.shape != (H, W):\n            flow = cv2.resize(flow, (W, H), interpolation=cv2.INTER_LINEAR)\n        flow = np.where(np.isfinite(flow), flow, 0.0).clip(0)\n        flow_norm = np.log1p(flow)\n        fmax = flow_norm.max()\n        flow_norm = flow_norm / (fmax + 1e-9) if fmax > 0 else flow_norm\n    else:\n        # Sans flow : attractivité homogène (dégradé)\n        flow_norm = np.ones((H, W), dtype=np.float32) * 0.5\n\n    # Attractivité = terrain × accès fluvial\n    # 0.3 = valeur plancher (terrain accessible sans rivière directe)\n    # 0.7 × flow_norm = bonus corridors fluviaux (orpaillage alluvial)\n    attr = np.exp(-slope / 8.0) * np.exp(-hand / 5.0) * (0.3 + 0.7 * flow_norm)\n    attr[slope > SLOPE_MAX] = 0.0\n    attr[hand  > HAND_MAX]  = 0.0\n\n    attr_u8  = (attr * 255.0).clip(0, 255).astype(np.uint8)\n    out_main = cv2.cvtColor(attr_u8, cv2.COLOR_GRAY2BGR)",
          "node_note": "a=slope · b=HAND · c=flow_acc → image attractivité corridors fluviaux"
        }
      },
      "width": 360,
      "height": 370
    },
