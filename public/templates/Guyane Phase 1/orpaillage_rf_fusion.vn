    },
    {
      "id": "n-rf",
      "type": "geo_rf_classifier",
      "position": {
        "x": 960,
        "y": 80
      },
      "positionAbsolute": {
        "x": 960,
        "y": 80
      },
      "data": {
        "label": "RF Classifier",
        "params": {
          "band_names": "ndvi,ndwi,mndwi,bsi,slope_degrees,hand_m,twi,vv,vh,rvi,nrpb,pdi_db,delta_vh",
          "n_estimators": 200,
          "max_depth": 20,
          "max_samples_per_class": 3000,
          "test_fraction": 0.2,
          "cache_dir": "copernicus_cache",
          "node_note": "13 features · max_samples_per_class=3000 · érosion désactivée"
        }
