    {
      "id": "n-dvh",
      "type": "logic_python",
      "position": {
        "x": -240,
        "y": 740
      },
      "positionAbsolute": {
        "x": -240,
        "y": 740
      },
      "data": {
        "label": "Python Node",
        "params": {
          "code": "# ── Delta VH smoothed (feature pour RF) ─────────────────────────────────────\n# b = S1 T1 features  c = S1 T2 features\nkernel_size = 7\ndef _get(geo, name):\n    if not isinstance(geo, dict): return None\n    names = geo.get('band_names', [])\n    if isinstance(names, str): names = names.split(',')\n    names = [n.lower() for n in names]\n    arr = np.asarray(geo['bands'], dtype=np.float32)\n    return arr[names.index(name)] if name in names else None\ndef _sm(x): return cv2.blur(x, (kernel_size|1, kernel_size|1))\n\nif not isinstance(b, dict) or not isinstance(c, dict):\n    out_any = None; out_dict = {'erreur': 'Brancher b=S1 T1, c=S1 T2'}\nelse:\n    vh1 = _get(b, 'vh'); vh2 = _get(c, 'vh')\n    if vh1 is None or vh2 is None:\n        out_any = None; out_dict = {'erreur': 'VH non trouvé'}\n    else:\n        dvh = _sm(vh2) - _sm(vh1)\n        dvh -= float(np.median(dvh))\n        out_any = {**c, 'bands': dvh[np.newaxis], 'count':1,\n                   'dtype':'float32', 'band_names':['delta_vh']}\n        out_main = None\n        out_dict = {'delta_vh_mean': round(float(dvh.mean()),3)}",
          "node_note": "ΔVH = smooth(VH_T2) - smooth(VH_T1) médiane-normalisé"
        }
      },
      "width": 420,
      "height": 200,
      "selected": false,
      "dragging": false,
      "style": {
        "width": 420,
        "height": 200
      }
    },
