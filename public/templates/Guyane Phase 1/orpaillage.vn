          "label": "Spectral Indices",
          "category": "geography",
          "icon": "BarChart2",
          "description": "Multi-index spectral calculator. Select any combination of built-in indices (NDVI, NDWI, EVI, MNDWI, NBR, BSI) and/or write up to 2 custom expressions. Outputs a multi-band `stack` geo dict (use directly in geo_rf_classifier or geo_band_stack) plus individual colormapped images for each enabled index. Replace geo_spectral_index + geo_band_calc with this single node.",
          "inputs": [
            {
              "id": "geotiff",
              "color": "geotiff",
              "label": "Raster"
            }
