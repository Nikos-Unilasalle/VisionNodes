        "label": "Python Node",
        "params": {
          "code": "# ── Carte de changement 4 couleurs + masque nuages ───────────────────────────\n# a = geotiff stack T0  (bande 0: NDVI, bande 1: MNDWI)\n# b = geotiff stack T1  (bande 0: NDVI, bande 1: MNDWI)\n# c = cloud mask T0     (geotiff, bande 0: 1=valide  0=nuage)\n# d = cloud mask T1     (geotiff, bande 0: 1=valide  0=nuage)\n# ─────────────────────────────────────────────────────────────────────────────\nndvi_thr  = 0.5   # seuil forêt\nwater_thr = 0.0   # seuil eau/turbidité MNDWI\n\nt0 = a.get('bands') if isinstance(a, dict) else None\nt1 = b.get('bands') if isinstance(b, dict) else None\nif t0 is None or t1 is None:\n    out_main = None\nelse:\n    t0 = np.asarray(t0, dtype=np.float32)\n    t1 = np.asarray(t1, dtype=np.float32)\n    if t0.ndim == 2: t0 = t0[np.newaxis]\n    if t1.ndim == 2: t1 = t1[np.newaxis]\n    ndvi_t0  = t0[0]\n    ndvi_t1  = t1[0]\n    mndwi_t1 = t1[1] if t1.shape[0] > 1 else np.zeros_like(ndvi_t1)\n    H, W = ndvi_t0.shape\n    # Cloud masks (1=valid, 0=cloud) — graceful fallback if not connected\n    def _get_cm(x):\n        if not isinstance(x, dict): return np.ones((H, W), dtype=bool)\n        b = np.asarray(x['bands'], dtype=np.float32)\n        if b.ndim == 3: b = b[0]\n        return b > 0\n    valid_t0 = _get_cm(c)\n    valid_t1 = _get_cm(d)\n    # Classification\n    rgb = np.full((H, W, 3), 40, dtype=np.uint8)\n    water  = mndwi_t1 > water_thr\n    stable = (ndvi_t0 > ndvi_thr) & (ndvi_t1 > ndvi_thr)\n    regrow = (ndvi_t0 < ndvi_thr) & (ndvi_t1 > ndvi_thr)\n    defor  = (ndvi_t0 > ndvi_thr) & (ndvi_t1 < ndvi_thr) & ~water\n    rgb[stable] = (34, 100, 34)\n    rgb[regrow] = (100, 200, 100)\n    rgb[defor]  = (30, 80, 140)\n    norm = np.clip((mndwi_t1 - water_thr) / (1.0 - water_thr + 1e-9), 0, 1)\n    r_ch = (255 * (1 - norm)).astype(np.uint8)\n    b_ch = (255 * norm).astype(np.uint8)\n    wrgb = np.zeros((H, W, 3), dtype=np.uint8)\n    wrgb[:, :, 0] = r_ch\n    wrgb[:, :, 1] = 20\n    wrgb[:, :, 2] = b_ch\n    rgb[water] = wrgb[water]\n    # Masquer les nuages en dernier (écrase la classification)\n    rgb[~valid_t0 &  valid_t1] = (180, 180, 180)  # nuage T0 seulement : gris clair\n    rgb[ valid_t0 & ~valid_t1] = (100, 100, 100)  # nuage T1 seulement : gris foncé\n    rgb[~valid_t0 & ~valid_t1] = (60,  60,  60)   # nuage T0 + T1 : presque noir\n    out_main = rgb"
        }
      },
