    {
      "id": "p2-classif-script",
      "type": "logic_python",
      "position": {
        "x": 1640,
        "y": 560
      },
      "data": {
        "label": "Python Node",
        "params": {
          "code": "# ── Carte de changement robuste ── BSI + distance eau ────────────────────────\n# a = geotiff stack T0  (B0: NDVI, B1: MNDWI, B2: BSI)\n# b = geotiff stack T1  (B0: NDVI, B1: MNDWI, B2: BSI)\n# c = geotiff Copernicus T0 — bande 0 > 0 = valide (nodata=0 en CLOUD_FREE)\n# d = geotiff Copernicus T1 — bande 0 > 0 = valide (nodata=0 en CLOUD_FREE)\n# e = distance à l'eau T0 (geotiff, mètres) — optionnel\n# ─────────────────────────────────────────────────────────────────────────────\nndvi_thr  = 0.12    # seuil forêt\nwater_thr = 0.0     # seuil MNDWI — revenu à 0 (évite sur-détection zones humides côtières)\nbsi_delta = 0.05    # hausse min BSI (abaissé : orpaillage = sol humide/boueux)\ndist_max  = 250.0   # m — rayon max chantier/cours d'eau (optionnel si e branché)\n\nt0 = a.get('bands') if isinstance(a, dict) else None\nt1 = b.get('bands') if isinstance(b, dict) else None\nif t0 is None or t1 is None:\n    out_main = None\n    out_dict = {'erreur': 'a ou b non branché'}\nelse:\n    t0 = np.asarray(t0, dtype=np.float32)\n    t1 = np.asarray(t1, dtype=np.float32)\n    if t0.ndim == 2: t0 = t0[np.newaxis]\n    if t1.ndim == 2: t1 = t1[np.newaxis]\n    ndvi_t0  = t0[0]\n    ndvi_t1  = t1[0]\n    mndwi_t1 = t1[1] if t1.shape[0] > 1 else np.zeros_like(ndvi_t1)\n    bsi_t0   = t0[2] if t0.shape[0] > 2 else np.zeros_like(ndvi_t0)\n    bsi_t1   = t1[2] if t1.shape[0] > 2 else np.zeros_like(ndvi_t1)\n    H, W = ndvi_t0.shape\n    def _cm(x):\n        if not isinstance(x, dict): return np.ones((H, W), dtype=bool)\n        bnd = np.asarray(x['bands'], dtype=np.float32)\n        if bnd.ndim == 3: bnd = bnd[0]\n        return bnd > 0\n    v0 = _cm(c)\n    v1 = _cm(d)\n    water = mndwi_t1 > water_thr\n    ndvi_drop = (ndvi_t0 > ndvi_thr) & (ndvi_t1 < ndvi_thr)\n    bsi_rise  = (bsi_t1 - bsi_t0) > bsi_delta\n    defor_spectral = ndvi_drop & bsi_rise\n    if isinstance(e, dict) and 'bands' in e:\n        dist = np.asarray(e['bands'], dtype=np.float32)\n        if dist.ndim == 3: dist = dist[0]\n        near_water = dist < dist_max\n        defor = defor_spectral & near_water & ~water\n    else:\n        near_water = None\n        defor = defor_spectral & ~water\n    stable = (ndvi_t0 > ndvi_thr) & (ndvi_t1 > ndvi_thr)\n    regrow = (ndvi_t0 < ndvi_thr) & (ndvi_t1 > ndvi_thr)\n    rgb = np.full((H, W, 3), 40, dtype=np.uint8)\n    rgb[stable] = (34, 100, 34)\n    rgb[regrow] = (100, 200, 100)\n    rgb[defor]  = (255, 180, 0)\n    norm = np.clip((mndwi_t1 - water_thr) / (1.0 - water_thr + 1e-9), 0, 1)\n    r_ch = (255 * (1 - norm)).astype(np.uint8)\n    b_ch = (255 * norm).astype(np.uint8)\n    wrgb = np.zeros((H, W, 3), dtype=np.uint8)\n    wrgb[:, :, 0] = r_ch\n    wrgb[:, :, 1] = 20\n    wrgb[:, :, 2] = b_ch\n    rgb[water] = wrgb[water]\n    rgb[~v0 &  v1] = (180, 180, 180)\n    rgb[ v0 & ~v1] = (100, 100, 100)\n    rgb[~v0 & ~v1] = (60,  60,  60)\n    out_main = rgb\n    bsi_d = bsi_t1 - bsi_t0\n    out_dict = {\n        'stack_T0_bands': int(t0.shape[0]),\n        'stack_T1_bands': int(t1.shape[0]),\n        'BSI_actif': bool(t0.shape[0] > 2),\n        'dist_e_actif': near_water is not None,\n        'px_ndvi_drop': int(ndvi_drop.sum()),\n        'px_bsi_rise': int((ndvi_drop & bsi_rise).sum()),\n        'px_defor_final': int(defor.sum()),\n        'px_water': int(water.sum()),\n        'bsi_delta_moy': float(np.nanmean(bsi_d[ndvi_drop])) if ndvi_drop.any() else 0.0,\n    }"
        }
      },
      "width": 208,
      "height": 249,
      "selected": false,
      "positionAbsolute": {
        "x": 1640,
        "y": 560
      },
      "dragging": false
