    {
      "id": "n-change",
      "type": "logic_python",
      "position": { "x": 80, "y": 80 },
      "data": {
        "label": "Python Node",
        "params": {
          "code": "# ── Détection de changement SAR · log-ratio bi-temporel ─────────────────────\n# a = S1 features T1 (geotiff · bandes : VV VH RVI NRPB PDI)\n# b = S1 features T2 (geotiff · mêmes bandes)\n#\n# Log-ratio VH (dB) = VH_T2 - VH_T1\n#   < -2 dB : perte rétrodiffusion → défrichement / perturbation\n#   > +2 dB : gain → inondation / régénération\n# ΔRVI = RVI_T2 - RVI_T1 (proxy perte de canopée)\n# ─────────────────────────────────────────────────────────────────────────────\nth_change_db  = 2.0   # seuil absolu de changement significatif (dB)\nth_rvi_loss   = 0.1   # seuil perte RVI\n\ndef _get(geo, name):\n    \"\"\"Extraire une bande par son nom depuis un geotiff dict.\"\"\"\n    if not isinstance(geo, dict): return None\n    names = geo.get('band_names', [])\n    if isinstance(names, str): names = names.split(',')\n    arr = np.asarray(geo['bands'], dtype=np.float32)\n    if name in names:\n        return arr[names.index(name)]\n    return None\n\nif not isinstance(a, dict) or not isinstance(b, dict):\n    out_main = None\n    out_any  = None\n    out_dict = {'erreur': 'Brancher a=T1 features, b=T2 features'}\nelse:\n    vv1 = _get(a, 'vv');  vh1 = _get(a, 'vh');  rvi1 = _get(a, 'rvi')\n    vv2 = _get(b, 'vv');  vh2 = _get(b, 'vh');  rvi2 = _get(b, 'rvi')\n\n    if vv1 is None or vh1 is None:\n        out_main = None\n        out_any  = None\n        out_dict = {'erreur': 'Bandes VV/VH introuvables — vérifier output_db=True'}\n    else:\n        H, W = vv1.shape\n\n        delta_vv  = vv2  - vv1  if vv2  is not None else np.zeros((H,W), np.float32)\n        delta_vh  = vh2  - vh1  if vh2  is not None else np.zeros((H,W), np.float32)\n        delta_rvi = rvi2 - rvi1 if (rvi1 is not None and rvi2 is not None) else np.zeros((H,W), np.float32)\n\n        # Masques de changement\n        loss   = delta_vh < -th_change_db   # perte rétrodiffusion VH\n        gain   = delta_vh >  th_change_db   # gain rétrodiffusion VH\n        rvi_loss = delta_rvi < -th_rvi_loss  # perte végétation\n\n        # Changement fort = perte VH ET perte RVI (signe défrichement)\n        deforest = loss & rvi_loss\n\n        # Carte de changement\n        vis = np.zeros((H, W, 3), dtype=np.uint8)\n        vis[loss  & ~deforest] = (40, 80, 200)   # perte VH seule (bleu)\n        vis[gain]              = (40, 200, 40)    # gain VH (vert)\n        vis[deforest]          = (40, 40, 220)    # perte VH+RVI → défrichement (rouge)\n        out_main = vis\n\n        # Geotiff change : delta_VH (dB) aligné sur T2\n        out_any = {\n            **b,\n            'bands': delta_vh[np.newaxis],\n            'count': 1, 'dtype': 'float32',\n            'band_names': ['delta_vh_db'],\n        }\n\n        out_dict = {\n            'delta_vh_mean':  round(float(delta_vh.mean()), 3),\n            'delta_vv_mean':  round(float(delta_vv.mean()), 3),\n            'delta_rvi_mean': round(float(delta_rvi.mean()), 3),\n            'pct_loss_vh':    round(float(loss.mean()   * 100), 2),\n            'pct_gain_vh':    round(float(gain.mean()   * 100), 2),\n            'pct_deforest':   round(float(deforest.mean() * 100), 2),\n        }\n        out_scalar = round(float(deforest.mean() * 100), 2)",
          "node_note": "rouge=défrichement(ΔVH<−2dB & ΔRVI<−0.1) · bleu=perte VH · vert=gain"
        }
      },
      "width": 640, "height": 540,
      "selected": false, "dragging": false,
      "positionAbsolute": { "x": 80, "y": 80 },
      "style": { "width": 640, "height": 540 }
    },
