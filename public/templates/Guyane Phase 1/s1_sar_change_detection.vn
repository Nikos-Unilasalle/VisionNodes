    {
      "id": "n-change",
      "type": "logic_python",
      "position": {
        "x": 80,
        "y": 80
      },
      "data": {
        "label": "Python Node",
        "params": {
          "code": "# ── Détection de changement SAR · log-ratio bi-temporel ─────────────────────\n# a = S1 features T1  (geotiff · VV VH RVI NRPB PDI en dB)\n# b = S1 features T2  (même structure)\n#\n# Filtre boxcar appliqué en domaine dB AVANT calcul du delta → supprime speckle.\n# Log-ratio VH (dB) = boxcar(VH_T2) - boxcar(VH_T1)\n#   < -th : perte rétrodiffusion → défrichement / perturbation\n#   > +th : gain → inondation / régénération végétale\n# ─────────────────────────────────────────────────────────────────────────────\nth_change_db = 2.0    # seuil changement significatif (dB)\nth_rvi_loss  = 0.08   # seuil perte RVI\nkernel_size  = 7      # boxcar anti-speckle (px) — augmenter pour plus de lissage\n\ndef _get(geo, name):\n    if not isinstance(geo, dict): return None\n    names = geo.get('band_names', [])\n    if isinstance(names, str): names = names.split(',')\n    names = [n.lower() for n in names]\n    arr = np.asarray(geo['bands'], dtype=np.float32)\n    return arr[names.index(name)] if name in names else None\n\ndef _smooth(band):\n    \"\"\"Boxcar uniforme pour réduction du speckle SAR.\"\"\"    k = (kernel_size | 1)  # forcer impair\n    return cv2.blur(band, (k, k))\n\nif not isinstance(a, dict) or not isinstance(b, dict):\n    out_main = None\n    out_any  = None\n    out_dict = {'erreur': 'Brancher a=T1 features, b=T2 features'}\nelse:\n    vv1 = _get(a, 'vv');  vh1 = _get(a, 'vh');  rvi1 = _get(a, 'rvi')\n    vv2 = _get(b, 'vv');  vh2 = _get(b, 'vh');  rvi2 = _get(b, 'rvi')\n\n    if vv1 is None or vh1 is None:\n        out_main = None\n        out_any  = None\n        out_dict = {'erreur': 'Bandes VV/VH introuvables'}\n    else:\n        H, W = vv1.shape\n\n        # Filtrage anti-speckle (boxcar en domaine dB)\n        vv1s = _smooth(vv1);  vh1s = _smooth(vh1)\n        vv2s = _smooth(vv2) if vv2 is not None else vv1s\n        vh2s = _smooth(vh2) if vh2 is not None else vh1s\n\n        delta_vv  = vv2s - vv1s\n        delta_vh  = vh2s - vh1s\n        delta_rvi = (_smooth(rvi2) - _smooth(rvi1)) if (rvi1 is not None and rvi2 is not None)                     else np.zeros((H, W), np.float32)\n\n        loss      = delta_vh < -th_change_db\n        gain      = delta_vh >  th_change_db\n        rvi_loss  = delta_rvi < -th_rvi_loss\n        deforest  = loss & rvi_loss\n\n        vis = np.zeros((H, W, 3), dtype=np.uint8)\n        vis[loss & ~deforest] = (200, 80, 40)    # perte VH seule (bleu-gris)\n        vis[gain]             = (40, 200, 40)    # gain VH (vert)\n        vis[deforest]         = (40, 40, 220)    # défrichement (rouge)\n        out_main = vis\n\n        out_any = {\n            **b,\n            'bands': delta_vh[np.newaxis],\n            'count': 1, 'dtype': 'float32',\n            'band_names': ['delta_vh_db'],\n        }\n        out_scalar = round(float(deforest.mean() * 100), 2)\n        out_dict = {\n            'delta_vh_mean':  round(float(delta_vh.mean()), 3),\n            'delta_vv_mean':  round(float(delta_vv.mean()), 3),\n            'delta_rvi_mean': round(float(delta_rvi.mean()), 3),\n            'pct_loss_vh':    round(float(loss.mean()      * 100), 2),\n            'pct_gain_vh':    round(float(gain.mean()      * 100), 2),\n            'pct_deforest':   round(float(deforest.mean()  * 100), 2),\n        }",
          "node_note": "boxcar 7px anti-speckle · rouge=défrichement · vert=gain VH"
        }
      },
      "width": 640,
      "height": 540,
      "selected": false,
      "dragging": false,
      "positionAbsolute": {
        "x": 80,
        "y": 80
      },
      "style": {
        "width": 640,
        "height": 540
      }
    },
