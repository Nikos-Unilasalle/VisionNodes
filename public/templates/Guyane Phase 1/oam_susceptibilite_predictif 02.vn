    {
      "id": "n-combine",
      "type": "logic_python",
      "position": {
        "x": -420,
        "y": 240
      },
      "data": {
        "label": "Candidats (RF × Upstream)",
        "params": {
          "code": "\n# ── Étage 2 : candidats = profil RF × accessibilité upstream ─────────────────\n# a = RF classification (geotiff, classe 2 = présence prédite)\n# b = zone upstream (mask, 40km le long du fleuve)\n# c = RF confidence (image, optionnel — intensité du profil)\n# Croise \"bon profil\" (RF) ET \"atteignable par une équipe\" (upstream).\ndef _band(x):\n    if not isinstance(x, dict): return None\n    arr = np.asarray(x['bands'], dtype=np.float32)\n    return arr[0] if arr.ndim == 3 else arr\n\nrf_cls = _band(a)\nref = a if isinstance(a, dict) else None\nzone = b if not isinstance(b, dict) else _band(b)\n\nif rf_cls is None or ref is None:\n    out_main = None; out_any = None\n    out_dict = {'erreur': 'a=RF classification, b=zone upstream'}\nelse:\n    H, W = rf_cls.shape\n    profile = (rf_cls >= 2).astype(np.float32)   # classe présence prédite\n\n    if zone is not None:\n        if zone.ndim == 3: zone = zone[..., 0]\n        if zone.shape != (H, W):\n            zone = cv2.resize(zone, (W, H), interpolation=cv2.INTER_NEAREST)\n        accessible = (zone > 0).astype(np.float32)\n    else:\n        accessible = np.ones((H, W), dtype=np.float32)\n\n    # Modulation par la confiance RF si fournie\n    conf = c if isinstance(c, np.ndarray) else None\n    if conf is not None:\n        if conf.ndim == 3: conf = cv2.cvtColor(conf, cv2.COLOR_BGR2GRAY)\n        if conf.shape != (H, W):\n            conf = cv2.resize(conf, (W, H), interpolation=cv2.INTER_LINEAR)\n        conf = conf.astype(np.float32) / 255.0\n    else:\n        conf = np.ones((H, W), dtype=np.float32)\n\n    candidates = profile * accessible * conf      # 0-1\n    cand_u8 = (candidates * 255.0).clip(0, 255).astype(np.uint8)\n\n    prev = cv2.applyColorMap(cand_u8, cv2.COLORMAP_VIRIDIS)\n    prev[candidates < 0.05] = [0, 0, 0]\n\n    out_main = prev\n    out_any = {**ref, 'bands': candidates[np.newaxis], 'count': 1, 'dtype': 'float32',\n               'band_names': ['candidate_score'], '_bands': ['candidate_score']}\n    n_cand = int((candidates > 0.3).sum())\n    out_dict = {\n        'candidate_cells': n_cand,\n        'candidate_pct': round(n_cand / (H * W) * 100, 3),\n        'profile_cells': int(profile.sum()),\n        'accessible_cells': int(accessible.sum()),\n    }\n",
          "node_note": "a=RF class b=zone upstream c=RF confidence → candidats",
          "color_index": 4
        }
      },
      "width": 208,
      "height": 249,
      "selected": false,
      "positionAbsolute": {
        "x": -420,
        "y": 240
      },
      "dragging": false
