      }
    },
    {
      "id": "n-feat",
      "type": "logic_python",
      "position": {
        "x": -840,
        "y": -320
      },
      "data": {
        "label": "Feature Stack",
        "params": {
          "code": "# ── Feature stack — profil multi-critères élargi ─────────────────────────────\n# a=Slope(°)  b=HAND(m)  c=Flow acc  d=Stack spectral S2 (multi-bande)  e=Géologie(opt)\n# upstream EXCLU (réfuté + fuite de cible). Géologie = slot BRGM (optionnel).\ndef _band(x):\n    if not isinstance(x, dict): return None\n    arr = np.asarray(x['bands'], dtype=np.float32)\n    return arr[0] if arr.ndim == 3 else arr\n\nslope, hand, flow = _band(a), _band(b), _band(c)\nref = a if isinstance(a, dict) else None\n\nif ref is None or slope is None:\n    out_any = None\n    out_dict = {'erreur': 'Brancher Slope (a) + reference geotiff'}\nelse:\n    H, W = slope.shape\n    def fit(x):\n        if x is None: return np.zeros((H, W), dtype=np.float32)\n        if x.shape != (H, W):\n            x = cv2.resize(x, (W, H), interpolation=cv2.INTER_LINEAR)\n        return np.where(np.isfinite(x), x, 0.0).astype(np.float32)\n\n    bands = [fit(slope), fit(hand), fit(flow)]\n    names = ['slope', 'hand', 'flow_acc']\n\n    # Stack spectral S2 multi-bande (NDVI, NDWI, MNDWI, BSI…)\n    if isinstance(d, dict) and 'bands' in d:\n        sp = np.asarray(d['bands'], dtype=np.float32)\n        if sp.ndim == 2: sp = sp[np.newaxis]\n        sp_names = list(d.get('band_names', [f'spec_{i}' for i in range(sp.shape[0])]))\n        for i in range(sp.shape[0]):\n            bands.append(fit(sp[i]))\n            names.append(sp_names[i].lower() if i < len(sp_names) else f'spec_{i}')\n\n    # Géologie (optionnel — slot BRGM)\n    geo_b = _band(e)\n    if geo_b is not None:\n        bands.append(fit(geo_b))\n        names.append('geology')\n\n    stack = np.stack(bands, axis=0)\n    out_any = {**ref, 'bands': stack, 'count': len(bands), 'dtype': 'float32',\n               'band_names': names, '_bands': names}\n    out_dict = {'n_features': len(bands), 'features': names}\n",
          "node_note": "a=slope b=hand c=flow d=spectral_stack e=geology(opt) → stack RF",
          "color_index": 4
        }
      },
      "width": 208,
      "height": 249,
      "selected": false,
      "positionAbsolute": {
        "x": -840,
        "y": -320
      },
      "dragging": false
    },
    {
      "id": "n-labels",
      "type": "logic_python",
      "position": {
        "x": -1240,
        "y": -60
      },
      "data": {
        "label": "Labels (presence-background)",
        "params": {
          "code": "# ── Labels presence-background pour le RF ────────────────────────────────────\n# a = masque OAM (sites confirmés)  b = geotiff référence (grille)\n# Sortie : 2 = présence (OAM) · 1 = background aléatoire hors OAM · 0 = ignoré\ndef _band(x):\n    if not isinstance(x, dict): return None\n    arr = np.asarray(x['bands'], dtype=np.float32)\n    return arr[0] if arr.ndim == 3 else arr\n\noam = a if not isinstance(a, dict) else _band(a)\nref = b if isinstance(b, dict) else (a if isinstance(a, dict) else None)\n\nif oam is None or ref is None:\n    out_any = None\n    out_dict = {'erreur': 'Brancher a=masque OAM, b=geotiff référence'}\nelse:\n    if oam.ndim == 3: oam = oam[..., 0]\n    H, W = oam.shape\n    presence = oam > 0\n    labels = np.zeros((H, W), dtype=np.float32)\n    labels[presence] = 2.0\n\n    # Background : pixels tirés au hasard loin de tout site.\n    # Buffer adaptatif → garantit assez de candidats même si présence dense.\n    inv = (~presence).astype(np.uint8)\n    dist = cv2.distanceTransform(inv, cv2.DIST_L2, 5)\n    n_pos = int(presence.sum())\n    rng = np.random.default_rng(42)\n    buf = 10.0\n    cand = np.argwhere(dist > buf)\n    while len(cand) < n_pos * 3 and buf > 1.0:\n        buf /= 2.0\n        cand = np.argwhere(dist > buf)\n    if len(cand) == 0:\n        cand = np.argwhere(dist > 0)       # tout pixel hors présence\n    if len(cand) > 0 and n_pos > 0:\n        k = min(len(cand), n_pos * 3)      # ratio background:présence = 3:1\n        sel = rng.choice(len(cand), size=k, replace=False)\n        rr = cand[sel, 0]; cc = cand[sel, 1]\n        labels[rr, cc] = 1.0\n\n    out_any = {**ref, 'bands': labels[np.newaxis], 'count': 1, 'dtype': 'float32',\n               'band_names': ['label'], '_bands': ['label']}\n    out_dict = {'presence_px': n_pos, 'background_px': int((labels == 1).sum())}\n",
          "node_note": "a=OAM mask b=ref → out_any labels 1/2",
          "color_index": 4
        }
      },
      "width": 208,
      "height": 249,
      "selected": false,
      "positionAbsolute": {
        "x": -1240,
        "y": -60
      },
      "dragging": false
    },
