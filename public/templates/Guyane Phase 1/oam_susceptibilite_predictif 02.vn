    {
      "id": "n-validate-b",
      "type": "logic_python",
      "position": {
        "x": 780,
        "y": 200
      },
      "data": {
        "label": "Validation B (MCDA non-filtré)",
        "params": {
          "code": "\n# ── Validation temporelle : candidats 2022 vs sites apparus en 2023 ──────────\n# a = candidate_score (geotiff 0-1, modèle entraîné sur 2022)\n# b = OAM 2023 (mask, vérité terrain)   c = OAM 2022 (mask, sites déjà connus)\n# Test prédictif réel : les NOUVEAUX sites 2023 tombent-ils dans nos candidats ?\ndef _band(x):\n    if not isinstance(x, dict): return None\n    arr = np.asarray(x['bands'], dtype=np.float32)\n    return arr[0] if arr.ndim == 3 else arr\n\ncand = _band(a)\no23 = b if not isinstance(b, dict) else _band(b)\no22 = c if not isinstance(c, dict) else _band(c)\nzone = d if not isinstance(d, dict) else _band(d)   # zone upstream (atteignable 40km)\n\nif cand is None or o23 is None:\n    out_main = None; out_dict = {'erreur': 'a=candidat b=OAM2023 c=OAM2022 d=zone upstream'}\nelse:\n    H, W = cand.shape\n    def fitm(m):\n        if m is None: return np.zeros((H, W), dtype=bool)\n        if m.ndim == 3: m = m[..., 0]\n        if m.shape != (H, W):\n            m = cv2.resize(m, (W, H), interpolation=cv2.INTER_NEAREST)\n        return m > 0\n    s23, s22 = fitm(o23), fitm(o22)\n    reachable = fitm(zone) if zone is not None else np.ones((H, W), dtype=bool)\n    new_sites = s23 & ~s22              # sites émergés en 2023 (cible de prédiction)\n\n    eps = 1e-9\n    # Auto-échelle : candidat 0-1 OU susceptibilité 0-100\n    cmax = float(np.nanmax(cand)) if np.isfinite(cand).any() else 1.0\n    cand_n = cand / 100.0 if cmax > 1.5 else cand\n\n    n_new = int(new_sites.sum())\n    new_in_reach = int((new_sites & reachable).sum())\n    total = H * W\n    rate_base = n_new / (total + eps)\n\n    # ── Balayage de seuils : courbe recall / surface / enrichissement ──────────\n    # Révèle l'opérateur utile (ex : surveiller 5% du territoire, capter 50%).\n    sweep = {}\n    best = {'threshold': None, 'enrichment_x': 0.0}\n    for thr in [0.70, 0.72, 0.74, 0.76, 0.78, 0.80, 0.82, 0.85, 0.90]:\n        pr = cand_n >= thr\n        tp = int((pr & new_sites).sum())\n        area = int(pr.sum())\n        rec = tp / (n_new + eps)\n        area_pct = area / total * 100.0\n        rate_in = tp / (area + eps)\n        enr = rate_in / (rate_base + eps)\n        sweep[f'thr_{thr}'] = {\n            'recall': round(rec, 3),\n            'area_pct': round(area_pct, 2),\n            'enrichment_x': round(enr, 1),\n        }\n        if enr > best['enrichment_x'] and area_pct > 0.5:\n            best = {'threshold': thr, 'enrichment_x': round(enr, 1),\n                    'recall': round(rec, 3), 'area_pct': round(area_pct, 2)}\n\n    # Carte au meilleur seuil d'enrichissement\n    THR = best['threshold'] if best['threshold'] is not None else 0.7\n    pred = cand_n >= THR\n    TP = int((pred & new_sites).sum())\n    FN = int((~pred & new_sites).sum())\n    recall = TP / (n_new + eps)\n    missed = new_sites & ~pred\n    fn_out_reach = int((missed & ~reachable).sum())\n    fn_in_zone = int((missed & reachable).sum())\n    recall_reachable = TP / (new_in_reach + eps)\n    cand_pct = round(float(pred.sum()) / total * 100, 2)\n\n    out_dict = {\n        'new_sites_2023': n_new,\n        'best_operating_point': best,    # seuil au meilleur enrichissement\n        'sweep': sweep,                  # courbe complète recall/surface/enrichissement\n        'recall_at_best': round(recall, 3),\n        'FN_beyond_40km': fn_out_reach,\n        'FN_in_zone_low_score': fn_in_zone,\n    }\n",
          "node_note": "a=MCDA suscept b=OAM2023 c=OAM2022 (pas de gate upstream)",
          "color_index": 4
        }
      },
