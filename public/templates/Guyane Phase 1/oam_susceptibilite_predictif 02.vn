    {
      "id": "n-oam23",
      "type": "geo_oam_loader",
      "position": {
        "x": 340,
        "y": 160
      },
      "data": {
        "label": "OAM 2023 — Vérité terrain",
        "params": {
          "fetch": 0,
          "source": "WFS 2023",
          "file_path": "",
          "layer_name": "",
          "output_field": "binary",
          "legality": "Illegal (2)",
          "mining_type": "Alluvionnaire",
          "year_min": 2000,
          "year_max": 2023,
          "all_touched": false,
          "cache_dir": "copernicus_cache",
          "node_note": "Sites confirmés 2023 (test)",
          "color_index": 1
        }
      },
