    {
      "id": "n-note-mcda",
      "type": "canvas_note",
      "position": {
        "x": -120,
        "y": 1220
      },
      "data": {
        "label": "Note",
        "params": {
          "text": "Poids explicites, interprétable.\\nflow 0.30 · upstream 0.30 · slope 0.15 · hand 0.10 · veg 0.15",
          "color_index": 3
        }
      },
      "width": 576,
      "height": 65,
      "selected": false,
      "positionAbsolute": {
        "x": -120,
        "y": 1220
      },
      "dragging": false
    },
    {
      "id": "n-mcda",
      "type": "logic_python",
      "position": {
        "x": -840,
        "y": 400
      },
      "data": {
        "label": "MCDA Susceptibility",
        "params": {
          "code": "# ── Score MCDA pondéré — susceptibilité interprétable (0-100) ─────────────────\n# a=Slope  b=HAND  c=Flow acc  d=Upstream dist(m)  e=NDVI\n# Poids explicites ajustables. Complément lisible du RF (boîte noire).\nW_FLOW, W_UPSTREAM, W_SLOPE, W_HAND, W_VEG = 0.30, 0.30, 0.15, 0.10, 0.15\nSLOPE_MAX, HAND_MAX = 12.0, 8.0\nUPSTREAM_MAX_M = 40000.0\n\ndef _band(x):\n    if not isinstance(x, dict): return None\n    arr = np.asarray(x['bands'], dtype=np.float32)\n    return arr[0] if arr.ndim == 3 else arr\n\nslope, hand, flow = _band(a), _band(b), _band(c)\nup, ndvi = _band(d), _band(e)\nref = a if isinstance(a, dict) else None\n\nif ref is None or slope is None:\n    out_main = None; out_any = None\n    out_dict = {'erreur': 'Brancher Slope (a) minimum'}\nelse:\n    H, W = slope.shape\n    def fit(x, fill=0.0):\n        if x is None: return np.full((H, W), fill, dtype=np.float32)\n        if x.shape != (H, W):\n            x = cv2.resize(x, (W, H), interpolation=cv2.INTER_LINEAR)\n        return np.where(np.isfinite(x), x, fill).astype(np.float32)\n    slope, hand = fit(slope, SLOPE_MAX + 1), fit(hand, HAND_MAX + 1)\n    flow, up, ndvi = fit(flow), fit(up, 1e9), fit(ndvi)\n\n    # Scores partiels 0-1 (plus haut = plus favorable)\n    s_slope = np.exp(-slope / 8.0)\n    s_hand  = np.exp(-hand / 5.0)\n    fl = np.log1p(flow.clip(0)); s_flow = fl / (fl.max() + 1e-9)\n    s_up = np.clip(1.0 - up / UPSTREAM_MAX_M, 0.0, 1.0)   # proche amont = fort\n    s_veg = np.clip(ndvi, 0.0, 1.0)                        # forêt dense = cible\n\n    score = (W_FLOW*s_flow + W_UPSTREAM*s_up + W_SLOPE*s_slope +\n             W_HAND*s_hand + W_VEG*s_veg)\n    # Cutoffs durs terrain\n    score[slope > SLOPE_MAX] = 0.0\n    score[hand > HAND_MAX] = 0.0\n    score_pct = (score * 100.0).astype(np.float32)\n\n    out_any = {**ref, 'bands': score_pct[np.newaxis], 'count': 1, 'dtype': 'float32',\n               'band_names': ['susceptibility'], '_bands': ['susceptibility']}\n    sc_u8 = score_pct.clip(0, 100).astype(np.uint8) * 2  # 0-100 → 0-200 visible\n    prev = cv2.applyColorMap(sc_u8.clip(0, 255).astype(np.uint8), cv2.COLORMAP_INFERNO)\n    prev[score_pct < 1.0] = [0, 0, 0]\n    out_main = prev\n    out_dict = {\n        'suscept_high_pct': round(float((score_pct > 60).sum()) / (H*W) * 100, 2),\n        'suscept_med_pct':  round(float(((score_pct >= 30)&(score_pct <= 60)).sum()) / (H*W) * 100, 2),\n        'weights': {'flow': W_FLOW, 'upstream': W_UPSTREAM, 'slope': W_SLOPE,\n                    'hand': W_HAND, 'veg': W_VEG},\n    }\n",
          "node_note": "a=slope b=hand c=flow d=upstream e=ndvi → score 0-100",
          "color_index": 4
        }
      },
      "width": 208,
      "height": 249,
      "selected": false,
      "positionAbsolute": {
        "x": -840,
        "y": 400
      },
      "dragging": false
    },
