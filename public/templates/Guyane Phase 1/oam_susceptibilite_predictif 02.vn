      "type": "geo_wfs_loader",
      "position": {
        "x": -1980,
        "y": 140
      },
      "data": {
        "label": "Favorabilité aurifère BRGM 2001",
        "params": {
          "fetch": 0,
          "wfs_url": "https://www.guyane-sig.fr/geoserver/wfs",
          "type_name": "geologie:FAVORABILITE_AURIFERE_FORMATIONS_GEOLOGIQUES_BRGM_2001",
          "bbox_filter": true,
          "burn_field": "LEGENDE",
          "value_map": "{\"Volcanisme basique (amphibolites = métalaves)\": 3, \"Volcanites, volcano-sédiments et sédiments indifférenciés\": 3, \"Volcanisme calco-alcalin acide à intermédiaire\": 3, \"Volcanisme indifférencié\": 3, \"Pélites\": 2, \"Gabbronorites, gabbros\": 2, \"Gabbros (île de Cayenne)\": 2, \"Grès et quartzites d'âge plus jeune que 2115 ± 4 Ma\": 1, \"Grès et quartzites à niveaux conglomératiques\": 1, \"Grès et quartzites à intercalations pélitiques\": 1}",
          "default_value": 0,
          "all_touched": false,
          "cache_dir": "copernicus_cache",
          "node_note": "Fetch → favorabilité 3=volcanique 2=pélites/gabbros 1=grès (métallogénie bouclier guyanais)",
          "color_index": 3
        }
      },
