    },
    {
      "id": "n-turbidity",
      "type": "logic_python",
      "position": {
        "x": -1150,
        "y": 1280
      },
      "data": {
        "label": "Turbidité fluviale",
        "params": {
          "code": "# Turbidité fluviale — normalisation percentile sur pixels eau\n# a = stack spectral (geo_spectral_indices : NDVI=0 NDWI=1 MNDWI=2)\n# b = water mask (geo_water_mask_mndwi, optionnel)\n# Rivières amazoniennes toutes turbides → seuil fixe inutile → percentile\n\ndef _arr(x, i=0):\n    if not isinstance(x, dict): return None\n    arr = np.asarray(x['bands'], dtype=np.float32)\n    if arr.ndim == 3:\n        return arr[i] if arr.shape[0] > i else arr[0]\n    return arr\n\nref_geo = a if isinstance(a, dict) else None\nif ref_geo is None:\n    out_main = None; out_any = None\n    out_dict = {'erreur': 'Brancher stack spectral S2 (a)'}\nelse:\n    ndwi  = _arr(a, 1)\n    mndwi = _arr(a, 2)\n    H, W = ndwi.shape\n    if b is not None:\n        wm = np.asarray(b['bands'] if isinstance(b, dict) else b, dtype=np.float32)\n        if wm.ndim == 3: wm = wm[0]\n        if wm.shape != (H, W):\n            wm = cv2.resize(wm, (W, H), interpolation=cv2.INTER_NEAREST)\n        water = wm > 0\n    else:\n        water = (mndwi > -0.1) if mndwi is not None else np.zeros((H, W), dtype=bool)\n    ndwi_c = np.where(np.isfinite(ndwi), ndwi, np.nan)\n    ndwi_w = ndwi_c[water]\n    turb = np.zeros((H, W), dtype=np.float32)\n    if ndwi_w.size > 10:\n        # Percentile stretch DANS les pixels eau uniquement\n        # NDWI faible = eau turbide ; NDWI élevé = eau claire\n        p_lo = float(np.nanpercentile(ndwi_w, 5))   # le plus turbide\n        p_hi = float(np.nanpercentile(ndwi_w, 95))  # le plus clair\n        rng = max(p_hi - p_lo, 0.05)\n        score_w = np.clip((p_hi - ndwi_c) / rng * 100.0, 0.0, 100.0)\n        turb = np.where(water, score_w, 0.0).astype(np.float32)\n    out_any = {**ref_geo, 'bands': turb[np.newaxis], 'count': 1, 'dtype': 'float32',\n               'band_names': ['turbidity'], '_bands': ['turbidity']}\n    sc_u8 = turb.clip(0, 100).astype(np.uint8) * 2\n    prev = cv2.applyColorMap(sc_u8.clip(0, 255).astype(np.uint8), cv2.COLORMAP_COOL)\n    prev[~water] = [0, 0, 0]\n    out_main = prev\n    n_water = int(water.sum())\n    out_dict = {'water_pct': round(n_water / (H * W) * 100, 2),\n                'ndwi_p5': round(float(np.nanpercentile(ndwi_c[water], 5)) if n_water > 10 else 0, 3),\n                'ndwi_p95': round(float(np.nanpercentile(ndwi_c[water], 95)) if n_water > 10 else 0, 3),\n                'turbid_top25pct': round(float((turb > 75).sum()) / max(n_water, 1) * 100, 2)}",
          "node_note": "a=stack spectral b=masque eau → turb 0-100"
        }
      },
      "width": 208,
      "height": 249
    },
