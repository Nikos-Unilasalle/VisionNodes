    {
      "id": "n-watermask",
      "type": "geo_water_mask",
      "position": {
        "x": -1480,
        "y": 1540
      },
      "data": {
        "label": "Water Mask",
        "params": {
          "green_band": 2,
          "swir_band": 5,
          "threshold": 0.0,
          "scl_band": 0,
          "index": 1,
          "erode_px": 3
