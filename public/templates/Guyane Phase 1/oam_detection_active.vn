    {
      "id": "n-s1t1",
      "type": "geo_copernicus",
      "position": {
        "x": -1480,
        "y": 760
      },
      "data": {
        "label": "Sentinel-1 T1 — 2023 (détection)",
        "params": {
          "collection": "2",
          "bands": "VV",
          "resolution": "10",
          "cloud_max": "100",
          "date_start": "2023-01-01",
          "date_end": "2023-12-31",
          "cache_dir": "copernicus_cache",
          "mosaic_mode": "0",
          "fetch": 0,
          "node_note": "Fetch → S1 VV 2023 (détection)"
        }
      },
      "width": 208,
      "height": 293
    },
    {
      "id": "n-sar-change",
      "type": "logic_python",
      "position": {
        "x": -1150,
        "y": 760
      },
      "data": {
        "label": "SAR Change (VV delta)",
        "params": {
          "code": "# SAR Change Detection — Sentinel-1 VV T0→T1\nTHR_DB   = -5.0\nSCALE_DB = 13.0\ntry:\n    def _band(x):\n        if not isinstance(x, dict): return None\n        arr = np.asarray(x['bands'], dtype=np.float32)\n        if arr.ndim == 3: arr = arr[0]\n        elif arr.ndim == 2: pass\n        else: return None\n        return arr\n    vv0, vv1 = _band(a), _band(b)\n    ref = a if isinstance(a, dict) else None\n    if vv0 is None or vv1 is None or ref is None:\n        out_main = None; out_any = None\n        out_dict = {'erreur': 'données absentes', 'a_type': str(type(a)), 'b_type': str(type(b))}\n    else:\n        H, W = vv0.shape[-2], vv0.shape[-1] if vv0.ndim > 1 else (vv0.shape[0], 1)\n        H, W = int(vv0.shape[0]), int(vv0.shape[1])\n        def fit(x):\n            if x.shape[0] != H or x.shape[1] != W:\n                x = cv2.resize(x, (W, H), interpolation=cv2.INTER_LINEAR)\n            return np.where(np.isfinite(x), x, 0.0).astype(np.float32)\n        vv0f, vv1f = fit(vv0), fit(vv1)\n        delta = vv1f - vv0f\n        change_score = np.clip((-delta + THR_DB) / SCALE_DB * 100.0, 0.0, 100.0)\n        out_any = {**ref, 'bands': change_score[np.newaxis], 'count': 1, 'dtype': 'float32',\n                   'band_names': ['sar_change'], '_bands': ['sar_change']}\n        sc_u8 = (change_score.clip(0, 100) * 2).astype(np.uint8)\n        prev = cv2.applyColorMap(sc_u8, cv2.COLORMAP_HOT)\n        prev[change_score < 5.0] = [0, 0, 0]\n        out_main = prev\n        out_dict = {'changed_pct': round(float((change_score > 20).sum()) / (H * W) * 100, 2),\n                    'delta_mean_db': round(float(np.nanmean(delta)), 2),\n                    'vv0_shape': str(vv0.shape), 'vv1_shape': str(vv1.shape)}\nexcept Exception as _e:\n    out_main = None; out_any = None\n    out_dict = {'exception': str(_e), 'type': type(_e).__name__}",
          "node_note": "a=S1-T0 b=S1-T1 → delta VV score 0-100"
        }
      },
      "width": 208,
      "height": 249
    },
