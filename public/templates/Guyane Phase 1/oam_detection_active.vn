    {
      "id": "n-mcda",
      "type": "logic_python",
      "position": {
        "x": -900,
        "y": 200
      },
      "data": {
        "label": "MCDA Susceptibilité",
        "params": {
          "code": "# MCDA terrain susceptibility — orpaillage alluvial\n# a=Slope(°)  b=HAND(m)  c=Flow accumulation\n# Poids calés sur RF importance (colmatage fuites) : flow>slope>hand\nW_FLOW, W_SLOPE, W_HAND = 0.50, 0.30, 0.20\nSLOPE_MAX, HAND_MAX = 12.0, 8.0\n\ndef _band(x):\n    if not isinstance(x, dict): return None\n    arr = np.asarray(x['bands'], dtype=np.float32)\n    return arr[0] if arr.ndim == 3 else arr\n\nslope, hand, flow = _band(a), _band(b), _band(c)\nref = a if isinstance(a, dict) else None\nif ref is None or slope is None:\n    out_main = None; out_any = None\n    out_dict = {'erreur': 'Brancher Slope(a) HAND(b) Flow(c)'}\nelse:\n    H, W = slope.shape\n    def fit(x, fill=0.0):\n        if x is None: return np.full((H, W), fill, dtype=np.float32)\n        if x.shape != (H, W):\n            x = cv2.resize(x, (W, H), interpolation=cv2.INTER_LINEAR)\n        return np.where(np.isfinite(x), x, fill).astype(np.float32)\n    slope_f = fit(slope, SLOPE_MAX + 1)\n    hand_f  = fit(hand,  HAND_MAX + 1)\n    flow_f  = fit(flow)\n    fl = np.log1p(flow_f.clip(0)); s_flow = fl / (fl.max() + 1e-9)\n    s_slope = np.exp(-slope_f / 8.0)\n    s_hand  = np.exp(-hand_f  / 5.0)\n    score = W_FLOW * s_flow + W_SLOPE * s_slope + W_HAND * s_hand\n    score[slope_f > SLOPE_MAX] = 0.0\n    score[hand_f  > HAND_MAX]  = 0.0\n    score_pct = (score * 100.0).astype(np.float32)\n    out_any = {**ref, 'bands': score_pct[np.newaxis], 'count': 1, 'dtype': 'float32',\n               'band_names': ['susceptibility'], '_bands': ['susceptibility']}\n    sc_u8 = score_pct.clip(0, 100).astype(np.uint8) * 2\n    prev = cv2.applyColorMap(sc_u8.clip(0, 255).astype(np.uint8), cv2.COLORMAP_INFERNO)\n    prev[score_pct < 1.0] = [0, 0, 0]\n    out_main = prev\n    out_dict = {'high_pct': round(float((score_pct > 60).sum()) / (H * W) * 100, 2),\n                'weights': {'flow': W_FLOW, 'slope': W_SLOPE, 'hand': W_HAND}}",
          "node_note": "a=slope b=hand c=flow → suscept 0-100"
        }
      },
      "width": 208,
      "height": 249
    },
