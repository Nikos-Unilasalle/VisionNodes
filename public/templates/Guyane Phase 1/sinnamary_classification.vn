      "width": 2060, "height": 360
    },

    {
      "id": "n-s1-2024",
      "type": "geo_copernicus",
      "position": { "x": 40, "y": 200 },
      "data": {
        "params": {
          "node_note": "**S1 RTC 2024** — annual median, Sinnamary union BBOX. VV + VH in dB. Collection 5 = Sentinel-1 RTC (Planetary Computer, no auth). 20 m resolution.",
          "bbox": "-53.30,4.40,-52.60,5.50",
          "collection": 5,
          "date_start": "2024-01-01",
          "date_end": "2024-12-31",
          "resolution": 20,
          "stac_polarization": 0,
          "stac_orbit": 0,
          "stac_composite": 0,
          "stac_to_db": true,
          "stac_max_scenes": 30,
          "cache_dir": "copernicus_cache",
          "fetch": 0
        }
      },
      "width": 380, "height": 260
    },

    {
      "id": "n-s1-pol",
      "type": "s1_polarization_features",
      "position": { "x": 40, "y": 500 },
      "data": {
        "params": {
          "node_note": "**6 S1 radar features** — RVI (canopy density), NRPB (double-bounce / flooded trunks), PDI (trunk–water contrast), Span linear, Span dB, DPSVI (canopy volume). These 6 bands form the SAR half of the 9-band feature stack.",
          "rvi": true, "span": true, "span_db": true,
          "nrpb": true, "pdi": true, "pri": false, "dpsvi": true,
          "output_db": true, "cache_dir": "copernicus_cache"
        }
      },
      "width": 380, "height": 240
    },

    {
      "id": "n-s2-2024",
      "type": "geo_copernicus",
      "position": { "x": 500, "y": 200 },
      "data": {
        "params": {
          "node_note": "**S2 L2A 2024** — cloud-filtered composite (< 30 % cloud), Sinnamary union BBOX. Bands B04 B03 B02 B08 B11 = Red Green Blue NIR SWIR1. Band order matters for the spectral index nodes below.",
          "bbox": "-53.30,4.40,-52.60,5.50",
          "collection": 1,
          "date_start": "2024-01-01",
          "date_end": "2024-12-31",
          "resolution": 20,
          "bands": "B04,B03,B02,B08,B11",
          "cache_dir": "copernicus_cache",
          "fetch": 0
        }
      },
      "width": 500, "height": 240
    },

    {
      "id": "n-s2-idx",
      "type": "geo_spectral_indices",
      "position": { "x": 500, "y": 480 },
      "data": {
        "params": {
          "node_note": "**NDVI + MNDWI + EVI** — three indices in one node. `stack` output = 3-band geo dict used as the S2 half of the 9-band fusion. Individual `ndvi`/`mndwi`/`evi` image outputs available for visualization.",
          "sensor": 0,
          "nir_band": 4, "red_band": 1, "green_band": 2,
          "blue_band": 3, "swir_band": 5,
          "ndvi":  true,
          "ndwi":  false,
          "evi":   true,
          "mndwi": true,
          "nbr":   false,
          "bsi":   false,
          "expr1_enable": false,
          "expr2_enable": false,
          "colormap": "viridis",
          "clamp_min": -1.0,
          "clamp_max": 1.0
        }
      },
      "width": 480, "height": 300
    },

    {
      "id": "n-stack-final",
      "type": "geo_band_stack",
      "position": { "x": 1080, "y": 200 },
      "data": {
        "params": {
          "node_note": "**9-band fused stack** — S1 pol features (6 bands, primary reference grid at 20 m) + S2 index stack (3 bands, reprojected bilinear). Output is the feature input to the RF classifier.",
          "resampling": 0,
          "prefix_secondary": false,
          "cache_dir": "copernicus_cache"
        }
      },
      "width": 460, "height": 240
    },

    {
      "id": "n-wc-2021",
      "type": "geo_copernicus",
      "position": { "x": 1080, "y": 580 },
      "data": {
        "params": {
          "node_note": "**Ground truth labels** — ESA WorldCover 2021 (10 m → 20 m). Classes used for training: 95=Mangroves, 90=Herbaceous wetland, 10=Trees, 80=Water, 60=Bare/orpaillage. Connected to RF Classifier `labels` port.",
          "bbox": "-53.30,4.40,-52.60,5.50",
          "collection": 6,
          "date_start": "2021-01-01",
          "date_end": "2021-12-31",
          "resolution": 20,
          "cache_dir": "copernicus_cache",
          "fetch": 0
        }
      },
      "width": 460, "height": 200
    },

    {
      "id": "n-rf",
      "type": "geo_rf_classifier",
      "position": { "x": 1620, "y": 200 },
      "data": {
        "params": {
          "node_note": "**RF Pixel Classifier** — trains on 9-band S1+S2 features using ESA WorldCover 2021 as labels. Stratified sampling (max 5 000 px/class), 100 trees, 20 % hold-out test. Predicts every pixel → classification map + confidence + feature importance.",
          "band_names": "RVI,Span,Span_dB,NRPB,PDI,DPSVI,NDVI,MNDWI,EVI",
          "include_classes": "10,60,80,90,95",
          "n_estimators": 100,
          "max_depth": 0,
          "max_samples_per_class": 5000,
          "test_fraction": 0.2,
          "cache_dir": "copernicus_cache"
        }
      },
      "width": 440, "height": 340
    },

    {
      "id": "note-classes",
      "type": "canvas_note",
      "position": { "x": 1620, "y": 560 },
      "data": {
        "label": "WorldCover class reference",
        "params": {
          "text": "## WorldCover classes used\n\n| Value | Label | Training signal |\n|-------|-------|----------------|\n| **95** | Mangroves | primary target |\n| **90** | Herbaceous wetland | confused with mangrove |\n| **10** | Tree cover | inland forest |\n| **80** | Permanent water | river / estuary |\n| **60** | Bare/sparse | orpaillage, river bars |\n\n**`include_classes`** param on RF node: `10,60,80,90,95`\n\nLeave blank to use all non-zero classes (slower).",
          "width": 440,
          "height": 260,
          "fontSize": 11,
          "color_index": 6
        }
      },
      "width": 440,
      "height": 260
    },

    {
      "id": "n-cls-report",
      "type": "ml_classification_report",
      "position": { "x": 1620, "y": 860 },
      "data": {
        "params": {
          "node_note": "**Fig 5** — Normalized confusion matrix (5×5, recall on diagonal) + P/R/F1/support table. Targets: **95=Mangroves** (F1 > 0.85) and **60=Bare** (F1 > 0.75). Connect report_data + conf_matrix from RF node.",
          "class_target_a": "95",
          "class_target_b": "60",
          "f1_threshold_high": 0.85,
          "f1_threshold_low": 0.75,
          "class_labels": "10=Trees,60=Bare,80=Water,90=Wetland,95=Mangroves"
        }
      },
      "width": 440, "height": 220
    },

    {
      "id": "n-display",
      "type": "output_display",
      "position": { "x": 40, "y": 1000 },
      "data": {
        "params": {
          "node_note": "**RF Classification results.** 6 panels: classification map, confidence, feature importance, full classification report (fig 5), quick CM preview, S1 context RGB."
        },
        "ports": [
          { "id": "image__0_classmap",   "color": "image", "label": "Classification" },
          { "id": "image__1_confidence", "color": "image", "label": "Confidence" },
          { "id": "image__2_importance", "color": "image", "label": "Feature Importance" },
          { "id": "image__3_full_report","color": "image", "label": "Fig 5 — Full report" },
          { "id": "image__4_confmat",    "color": "image", "label": "CM preview" },
          { "id": "image__5_s1context",  "color": "image", "label": "S1 context RGB" }
        ],
        "minified": false
      },
      "width": 1400, "height": 240
    }
  ],

