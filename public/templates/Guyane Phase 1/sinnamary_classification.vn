      "position": { "x": 1060, "y": 500 },
      "style": { "width": 500, "height": 360, "zIndex": -1 },
      "data": { "label": "Frame", "params": { "color_index": 6, "title": "4 · Ground truth (ESA WorldCover 2021)" } },
      "width": 500, "height": 360
    },
