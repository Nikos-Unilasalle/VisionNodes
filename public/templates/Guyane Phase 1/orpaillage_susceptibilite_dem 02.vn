    },
    {
      "id": "n-suscept",
      "type": "logic_python",
      "position": {
        "x": 600,
        "y": 480
      },
      "data": {
        "label": "Susceptibilité (modèle)",
        "params": {
          "code": "# ── Susceptibilité orpaillage ALLUVIAL · modèle géomorphologique multi-facteurs ─\n# Prédit où de NOUVELLES exploitations illégales pourraient s'implanter,\n# d'après la seule géomorphologie du DEM (a priori, complément des détections S2).\n#\n#   a = Flow Accumulation (cellules)   b = Slope (°)   c = HAND (m)   d = TWI\n#\n# suscept = enveloppe_corridor × qualité_alluviale\n#   enveloppe_corridor = exp(-dist_au_réseau / decay), masquée au-delà de max_d\n#   qualité = 0.40·magnitude_crique + 0.25·pente_douce + 0.20·humidité + 0.15·fond_vallée\n# ──────────────────────────────────────────────────────────────────────────────\nflow_thr   = 5000.0   # cellules — seuil réseau de criques principales\ndecay_m    = 250.0    # m — décroissance corridor\nmax_d_m    = 600.0    # m — limite plaine d'inondation\nslope_max  = 12.0     # ° — au-delà = trop pentu pour placers\nhand_max   = 8.0      # m — au-delà = hors fond de vallée\ntwi_lo, twi_hi = 9.0, 16.0\nw_mag, w_slope, w_wet, w_hand = 0.40, 0.25, 0.20, 0.15\n\ndef _band(x):\n    if not isinstance(x, dict): return None\n    arr = np.asarray(x['bands'], dtype=np.float32)\n    return arr[0] if arr.ndim == 3 else arr\n\nflow  = _band(a)\nslope = _band(b)\nhand  = _band(c)\ntwi   = _band(d)\ngeo_ref = a if isinstance(a, dict) else {}\ntr = geo_ref.get('transform')\npx_m = abs(tr[0]) if tr is not None else 30.0\n\nif flow is None:\n    out_main = None\n    out_any  = None\n    out_dict = {'erreur': 'Flow Accumulation non branche (port a)'}\nelse:\n    H, W = flow.shape\n    ones = np.ones((H, W), dtype=np.float32)\n\n    # ── Réseau de criques + enveloppe corridor ──────────────────────────────\n    channel = (flow > flow_thr).astype(np.uint8)\n    if channel.sum() == 0:\n        channel[flow >= np.percentile(flow, 99.5)] = 1\n    dist = cv2.distanceTransform(1 - channel, cv2.DIST_L2, 5) * px_m\n    corridor = np.exp(-dist / decay_m)\n    corridor = np.where(dist < max_d_m, corridor, 0.0).astype(np.float32)\n\n    # ── Magnitude de la crique voisine (proxy ordre de Strahler) ────────────\n    # Moyenne locale du log-flux des criques, pondérée par proximité (blur).\n    log_flow = np.log1p(flow).astype(np.float32)\n    chan_f   = np.where(channel > 0, log_flow, 0.0).astype(np.float32)\n    sigma_px = max(1.0, decay_m / px_m)\n    k        = int(sigma_px * 4) | 1            # noyau impair\n    num = cv2.GaussianBlur(chan_f, (k, k), sigma_px)\n    den = cv2.GaussianBlur(channel.astype(np.float32), (k, k), sigma_px)\n    mag_field = num / (den + 1e-6)\n    lo, hi = np.log1p(flow_thr), float(log_flow.max())\n    f_mag  = np.clip((mag_field - lo) / (hi - lo + 1e-6), 0, 1)\n\n    # ── Facteurs géomorphologiques ──────────────────────────────────────────\n    f_slope = np.clip(1.0 - (slope / slope_max if slope is not None else 0.0 * ones), 0, 1)\n    f_wet   = np.clip((twi - twi_lo) / (twi_hi - twi_lo) if twi is not None else ones, 0, 1)\n    f_hand  = np.clip(1.0 - (hand / hand_max if hand is not None else 0.0 * ones), 0, 1)\n\n    quality = (w_mag * f_mag + w_slope * f_slope + w_wet * f_wet + w_hand * f_hand)\n    suscept = (corridor * quality).astype(np.float32)\n\n    # Renormalise sur le corridor pour exploiter toute la dynamique 0–1\n    m = float(suscept.max())\n    if m > 1e-6:\n        suscept = suscept / m\n\n    out_any = {**geo_ref, 'bands': suscept[np.newaxis],\n               'count': 1, 'band_names': ['susceptibilite'], 'dtype': 'float32'}\n\n    norm = (suscept * 255).clip(0, 255).astype(np.uint8)\n    out_main = cv2.applyColorMap(norm, cv2.COLORMAP_JET)\n\n    in_corr = suscept > 0\n    out_dict = {\n        'pct_reseau':     round(float(channel.mean() * 100), 2),\n        'pct_corridor':   round(float(in_corr.mean() * 100), 1),\n        'pct_hi':         round(float((suscept > 0.6).mean() * 100), 2),\n        'pct_moy':        round(float(((suscept > 0.3) & (suscept <= 0.6)).mean() * 100), 2),\n        'suscept_moy_corr': round(float(suscept[in_corr].mean()), 3) if in_corr.any() else 0,\n    }\n",
          "node_note": "Modèle multi-facteurs · corridor × (0.4 mag + 0.25 pente + 0.2 humid + 0.15 HAND)"
        }
      },
      "width": 260,
      "height": 340,
      "selected": false,
      "positionAbsolute": {
        "x": 600,
        "y": 480
      },
      "dragging": false,
      "style": {
        "width": 260,
        "height": 340
      }
    },
