    {
      "id": "n-note-suscept",
      "type": "canvas_note",
      "position": {
        "x": 590,
        "y": 410
      },
      "data": {
        "label": "Note",
        "params": {
          "text": "Indice composite : 0.5×HAND + 0.3×Pente + 0.2×TWI\nRouge = forte susceptibilité orpaillage"
        }
      },
      "width": 208,
      "height": 60,
      "selected": false,
      "positionAbsolute": {
        "x": 590,
        "y": 410
      },
      "dragging": false
    },
    {
      "id": "n-suscept",
      "type": "logic_python",
      "position": {
        "x": 590,
        "y": 480
      },
      "data": {
        "label": "Susceptibilité",
        "params": {
          "code": "# ── Susceptibilité orpaillage · HAND + Pente + TWI ───────────────────────────\n# a = HAND  (Height Above Nearest Drainage, mètres)\n# b = Slope (degrés)\n# c = TWI   (Topographic Wetness Index)\n#\n# out_any  → geotiff susceptibilité [0–1] masqué corridor → Colorizer\n# ─────────────────────────────────────────────────────────────────────────────\nhand_max  = 5.0   # m — limite corridor fluvial\nslope_max = 8.0   # °\ntwi_min   = 7.0\n\ndef _band(x):\n    if not isinstance(x, dict): return None\n    arr = np.asarray(x['bands'], dtype=np.float32)\n    return arr[0] if arr.ndim == 3 else arr\n\nhand  = _band(a)\nslope = _band(b)\ntwi   = _band(c)\n\nif hand is None:\n    out_main = None\n    out_any  = None\n    out_dict = {'erreur': 'HAND non branché (port a)'}\nelse:\n    H, W = hand.shape\n    ones = np.ones((H, W), dtype=np.float32)\n\n    in_corridor = hand <= hand_max\n\n    s_hand  = np.clip(1.0 - hand  / hand_max,  0, 1)\n    s_slope = np.clip(1.0 - (slope / slope_max if slope is not None else ones), 0, 1)\n    s_twi   = np.clip((twi - twi_min) / 6.0    if twi   is not None else ones, 0, 1)\n    suscept = 0.5 * s_hand + 0.3 * s_slope + 0.2 * s_twi\n\n    # Masque : hors corridor → 0 (nodata)\n    suscept_masked = np.where(in_corridor, suscept, 0.0).astype(np.float32)\n\n    # Geotiff brut → port out_any → Colorizer\n    geo_ref = a if isinstance(a, dict) else {}\n    out_any = {**geo_ref, 'bands': suscept_masked[np.newaxis],\n               'count': 1, 'band_names': ['susceptibilite'], 'dtype': 'float32'}\n\n    # Preview simple (niveaux de gris)\n    norm = (suscept_masked * 255).clip(0, 255).astype(np.uint8)\n    out_main = cv2.cvtColor(norm, cv2.COLOR_GRAY2BGR)\n\n    out_dict = {\n        'hand_max_m':    hand_max,\n        'px_corridor':   int(in_corridor.sum()),\n        'pct_corridor':  round(float(in_corridor.mean() * 100), 2),\n        'suscept_moy':   round(float(suscept[in_corridor].mean()), 3) if in_corridor.any() else 0,\n    }",
          "node_note": "Masque : HAND ≤ hand_max | JET dans corridor, sombre hors corridor"
        }
      },
      "width": 208,
      "height": 280,
      "selected": false,
      "positionAbsolute": {
        "x": 590,
        "y": 480
      },
      "dragging": false
    },
