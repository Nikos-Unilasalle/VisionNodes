    {
      "id": "n-ndvi",
      "type": "geo_spectral_indices",
      "position": {
        "x": 40,
        "y": 400
      },
      "data": {
        "params": {
          "node_note": "**NDVI** — (NIR−Red)/(NIR+Red). Separates dense mangrove canopy (+0.6–0.8) from bare orpaillage soil (~0) and open water (< 0). B08=NIR (band 4), B04=Red (band 1).",
          "sensor": 0,
          "nir_band": 4,
          "red_band": 1,
          "green_band": 2,
          "blue_band": 3,
          "swir_band": 5,
          "ndvi": true,
          "ndwi": false,
          "evi": false,
          "mndwi": false,
          "nbr": false,
          "bsi": false,
          "expr1_enable": false,
          "expr2_enable": false,
          "colormap": "viridis",
          "clamp_min": -1.0,
          "clamp_max": 1.0
        }
      },
      "width": 208,
      "height": 118,
      "selected": false,
      "positionAbsolute": {
        "x": 40,
        "y": 400
      },
      "dragging": false
    },
    {
      "id": "n-mndwi",
      "type": "geo_spectral_indices",
      "position": {
        "x": 40,
        "y": 520
      },
      "data": {
        "params": {
          "node_note": "**MNDWI** — (Green−SWIR1)/(Green+SWIR1). Turbidity-sensitive: high MNDWI = clear water, negative MNDWI = turbid / orpaillage-impacted water. B03=Green (band 2), B11=SWIR1 (band 5).",
          "sensor": 0,
          "nir_band": 4,
          "red_band": 1,
          "green_band": 2,
          "blue_band": 3,
          "swir_band": 5,
          "ndvi": false,
          "ndwi": false,
          "evi": false,
          "mndwi": true,
          "nbr": false,
          "bsi": false,
          "expr1_enable": false,
          "expr2_enable": false,
          "colormap": "viridis",
          "clamp_min": -1.0,
          "clamp_max": 1.0
        }
      },
      "width": 208,
