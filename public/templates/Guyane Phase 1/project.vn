      },
      "dragging": false
    },
    {
      "id": "n-evi",
      "type": "geo_spectral_indices",
      "position": {
        "x": 40,
        "y": 640
      },
      "data": {
        "params": {
          "node_note": "**EVI** — 2.5*(NIR−Red)/(NIR+6*Red−7.5*Blue+1). Saturates less than NDVI in dense canopy; captures mangrove LAI gradient from pioneer (low) to mature (high). B08 B04 B02 = NIR Red Blue.",
          "sensor": 0,
          "nir_band": 4,
          "red_band": 1,
          "green_band": 2,
          "blue_band": 3,
          "swir_band": 5,
          "ndvi": false,
