      "type": "geo_band_calc",
      "position": { "x": -500, "y": 1980 },
      "data": {
        "params": {
          "node_note": "**Fusion classe 20→30** — Shrubland (0 % recall) reclassifiée en Grassland. `np.where(B1==20, 30, B1)`",
