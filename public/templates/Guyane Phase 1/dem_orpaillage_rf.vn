      "position": { "x": -400, "y": -500 },
      "data": {
        "params": {
          "node_note": "**Δ Spectral 2021→2024** — delta NDVI (perte végétation) + delta BSI (gain sol nu). Signature orpaillage : NDVI↓ + BSI↑.",
          "rules": "NDVI<-0.1,BSI>0.1",
          "min_pixels": 10
        }
      },
      "width": 208, "height": 121
    },
    {
      "id": "n-s1",
      "type": "geo_copernicus",
      "position": { "x": -1350, "y": 1700 },
      "data": {
        "params": {
          "node_note": "**Sentinel-1 GRD (CDSE)** — VV + VH. Nécessite credentials CDSE. Eau turbide orpaillage visible radar sous nuages. ⚠ Si 0 % valid : S1 RTC Planetary ne couvre pas Guyane — passer à collection 'Sentinel-1 GRD' (index 2) avec Client ID/Secret.",
          "collection": "2",
          "bands": "VV,VH",
          "resolution": "20",
          "cache_dir": "copernicus_cache",
          "fetch": 0
        }
      },
      "width": 208, "height": 261
    },
    {
      "id": "n-flow-log",
      "type": "geo_band_calc",
      "position": { "x": -700, "y": 860 },
      "data": {
        "params": {
          "node_note": "**log₁₊(flow_acc)** — normalise l'accumulation hydrologique. Remplace SWIR (redondant avec BSI).",
          "expression": "np.log1p(B1)",
          "clamp_min": 0,
          "clamp_max": 15,
          "colormap": "0"
        }
      },
      "width": 208, "height": 90
    },
