    {
      "id": "n-turb-norm",
      "type": "geo_dn_normalize",
      "position": { "x": -300, "y": 2120 },
      "data": {
        "params": {
          "node_note": "**Échelle → réflectance** — S2 Planetary stocké en réflectance×1000 (eau rouge≈23 → ρ≈0.023). quantification=1000. ⚠ Si turbidité plancher (bleu) : essayer 100 ; si saturée (brun) : essayer 10000.",
          "quantification": 1000,
          "offset": 0,
          "clamp": true
        }
      },
      "width": 208, "height": 90
    },
    {
      "id": "n-turb-mask",
      "type": "geo_water_mask_mndwi",
      "position": { "x": 500, "y": 2120 },
      "data": {
        "params": {
          "node_note": "**Masque eau (MNDWI)** — vert=B03 (idx 2), SWIR=B11 (idx 5). Restreint la turbidité aux surfaces en eau.",
          "green_band": 2,
          "swir_band": 5,
          "threshold": 0.0,
          "erode_size": 3,
          "scl_band": 0
        }
      },
      "width": 208, "height": 153
    },
    {
      "id": "n-turbidity",
      "type": "geo_turbidity_nechad",
      "position": { "x": 900, "y": 2120 },
      "data": {
        "params": {
          "node_note": "**Turbidité Nechad (NTU)** — rouge=B04 (idx 1). NTU = A·ρ/(1−ρ/C)+B. Entrée = réflectance via dn_normalize (÷1000). max_ntu=15. Réservoir Petit-Saut ~6 NTU (eau claire) ; vrai signal turbide dans les affluents amont.",
          "red_band": 1,
          "max_ntu": 15,
          "gaussian": 3
        }
      },
      "width": 208, "height": 153
    },
    {
      "id": "n-turb-viz",
      "type": "geo_band_calc",
      "position": { "x": 1300, "y": 2380 },
      "data": {
        "params": {
          "node_note": "**Turbidité brute colorée (viridis)** — scène entière, sans masque eau. Les taches jaune-vert vif = forte réflectance rouge = **sol nu perturbé** (clairières, chantiers). Proxy orpaillage visible que le masque eau cachait.",
          "expression": "B1",
          "clamp_min": 0,
          "clamp_max": 50,
          "colormap": "viridis"
        }
      },
      "width": 208, "height": 90
    },
