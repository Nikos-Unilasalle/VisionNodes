    {
      "id": "n-seed",
      "type": "logic_python",
      "position": {
        "x": -750,
        "y": 450
      },
      "data": {
        "label": "Mine Seed Generator (T0)",
        "params": {
          "code": "# Génère une graine de mine active fictive au centre de l'image\nif not isinstance(a, dict):\n    out_any = None\nelse:\n    arr = a['bands'][0]\n    H, W = arr.shape\n    seed = np.zeros((H, W), dtype=np.float32)\n    # Graine active de 4x4 pixels au centre de la zone\n    seed[H//2-2:H//2+2, W//2-2:W//2+2] = 1.0\n    out_any = {\n        **a,\n        'bands': seed[np.newaxis],\n        'count': 1,\n        'dtype': 'float32',\n        'band_names': ['active']\n    }"
        }
      },
      "width": 260,
      "height": 340
    },
