    {
      "id": "n-glcm",
      "type": "geo_glcm_features",
      "position": {
        "x": -1500,
        "y": 120
      },
      "data": {
        "label": "GLCM Texture",
        "params": {
          "band_index": 3,
          "window_size": 9,
          "stride": 2,
          "levels": 64,
          "distances": "1,2",
          "contrast": true,
          "homogeneity": false,
          "energy": false,
