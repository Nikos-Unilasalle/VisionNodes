    },
    {
      "id": "n-det",
      "type": "logic_python",
      "position": {
        "x": -1180,
        "y": 120
      },
      "data": {
        "label": "Détecteur texture",
        "params": {
          "code": "import numpy as np, cv2\ndef _num(x,dv):\n    try: return float(x) if isinstance(x,(int,float)) else dv\n    except: return dv\ndef _band(x,i=0):\n    if not isinstance(x,dict): return None\n    A=np.asarray(x['bands'],dtype=np.float32)\n    return (A[i] if A.shape[0]>i else A[0]) if A.ndim==3 else A\ndef _morph(m,k=3):\n    ker=cv2.getStructuringElement(cv2.MORPH_ELLIPSE,(k,k))\n    return cv2.morphologyEx(m.astype(np.uint8),cv2.MORPH_OPEN,ker)>0\n# a=GLCM  b=CONTRAST_PCTL(Number)\nCONTRAST_PCTL=_num(b,92.0); MORPH_K=3\ntry:\n    geo=a if isinstance(a,dict) else None\n    if geo is None: out_main=None; out_any=None; out_dict={'erreur':'Brancher GLCM (a)'}\n    else:\n        contrast=_band(a,0); H,W=contrast.shape; npx=H*W\n        c=np.where(np.isfinite(contrast),contrast,0.0)\n        thr=float(np.percentile(c,CONTRAST_PCTL))\n        anom=_morph(c>thr,MORPH_K)\n        cn=np.clip((c-thr)/(c.max()-thr+1e-9),0,1)\n        det=np.where(anom,cn,0.0).astype(np.float32)\n        u8=(np.clip(det,0,1)*255).astype(np.uint8)\n        prev=cv2.applyColorMap(u8,cv2.COLORMAP_INFERNO); prev[det<0.05]=[0,0,0]\n        out_main=prev\n        out_any={**geo,'bands':det[np.newaxis],'count':1,'dtype':'float32','band_names':['detection'],'_bands':['detection']}\n        out_dict={'CONTRAST_PCTL':round(CONTRAST_PCTL,1),'thr':round(thr,3),\n                  'detect_pct':round(float((det>0.05).sum())/npx*100,3)}\nexcept Exception as _e:\n    out_main=None; out_any=None; out_dict={'exception':str(_e),'type':type(_e).__name__}\n",
          "node_note": "a=GLCM → détection"
        }
      },
      "width": 208,
      "height": 249
    },
