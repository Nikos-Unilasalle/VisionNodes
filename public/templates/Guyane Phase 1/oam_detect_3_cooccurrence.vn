      },
      "data": {
        "label": "Note",
        "params": {
          "text": "Détecteur ③ — Co-occurrence eau + sol nu\nSol nu seul ou eau seule = faux positifs. Les deux côte à côte, en forêt = quasi-certitude.\nExport → detect_3_cooccurrence.tif",
          "color_index": 1
        }
      },
      "width": 1000,
      "height": 65
    },
    {
      "id": "n-bbox",
      "type": "geo_bbox",
      "position": {
        "x": -2060,
