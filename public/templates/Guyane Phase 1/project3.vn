      "position": {
        "x": 1060,
        "y": 380
      },
      "data": {
        "params": {
          "node_note": "**RF Pixel Classifier (4-class)** — 12-band S1+S2 features, ESA WorldCover 2021 labels. Class 90 merged into 95 (CoastalVeg). Spatial block split 50 px. Per-class caps: CoastalVeg 15k, others 8k. 100 trees.",
          "band_names": "RVI,Span,Span_dB,NRPB,PDI,DPSVI,VV,VH,VV_VH_ratio,NDVI,MNDWI,EVI",
          "include_classes": "10,60,80,95",
          "class_merge": "90=95",
          "class_max_samples": "95=15000,80=8000,10=8000,60=8000",
          "split_mode": 1,
          "block_size_px": 50,
          "n_estimators": 100,
          "max_depth": 0,
          "max_samples_per_class": 5000,
          "test_fraction": 0.2,
          "cache_dir": "copernicus_cache",
          "color_index": 0
        }
      },
      "width": 208,
