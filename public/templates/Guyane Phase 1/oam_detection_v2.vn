    {
      "id": "n-turbidity",
      "type": "logic_python",
      "position": {
        "x": -760,
        "y": 1210
      },
      "data": {
        "label": "Turbidité (percentile dans eau)",
        "params": {
          "code": "# Turbidité — percentile NDWI dans pixels eau\n# a = stack spectral (NDVI=0 NDWI=1 MNDWI=2)   b = water mask\ndef _arr(x, i=0):\n    if not isinstance(x, dict): return None\n    arr = np.asarray(x['bands'], dtype=np.float32)\n    return arr[i] if arr.ndim == 3 and arr.shape[0] > i else arr\nref = a if isinstance(a, dict) else None\nif ref is None:\n    out_main = None; out_any = None; out_dict = {'erreur': 'Brancher stack S2 (a)'}\nelse:\n    ndwi = _arr(a, 1)\n    H, W = ndwi.shape\n    if b is not None:\n        wm = np.asarray(b['bands'] if isinstance(b, dict) else b, dtype=np.float32)\n        if wm.ndim == 3: wm = wm[0]\n        if wm.shape != (H, W): wm = cv2.resize(wm, (W, H), interpolation=cv2.INTER_NEAREST)\n        water = wm > 0\n    else:\n        mndwi = _arr(a, 2)\n        water = (mndwi > -0.1) if mndwi is not None else np.zeros((H, W), dtype=bool)\n    ndwi_c = np.where(np.isfinite(ndwi), ndwi, np.nan)\n    ndwi_w = ndwi_c[water]\n    turb = np.zeros((H, W), dtype=np.float32)\n    if ndwi_w.size > 10:\n        p_lo = float(np.nanpercentile(ndwi_w, 5))\n        p_hi = float(np.nanpercentile(ndwi_w, 95))\n        rng  = max(p_hi - p_lo, 0.05)\n        turb = np.where(water, np.clip((p_hi - ndwi_c) / rng, 0.0, 1.0), 0.0).astype(np.float32)\n    out_any = {**ref, 'bands': turb[np.newaxis], 'count': 1, 'dtype': 'float32',\n               'band_names': ['turbidity'], '_bands': ['turbidity']}\n    sc_u8 = (turb * 255).astype(np.uint8)\n    prev = cv2.applyColorMap(sc_u8, cv2.COLORMAP_COOL)\n    prev[~water] = [0, 0, 0]\n    out_main = prev\n    out_dict = {'water_pct': round(float(water.sum()) / (H * W) * 100, 2),\n                'ndwi_range': round(float(np.nanpercentile(ndwi_w, 95) - np.nanpercentile(ndwi_w, 5)) if ndwi_w.size > 10 else 0, 3)}",
          "node_note": "a=stack b=water → turb 0-1"
        }
      },
      "width": 208,
      "height": 249
    },
