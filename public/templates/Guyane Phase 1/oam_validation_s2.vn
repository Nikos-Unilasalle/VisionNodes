    {
      "id": "n-metrics",
      "type": "logic_python",
      "position": {
        "x": 1360,
        "y": 460
      },
      "data": {
        "label": "Python Node",
        "params": {
          "code": "# ── Validation binaire : détection S2 vs polygones OAM ────────────────────\n# a = détection  (geotiff float32, 1.0 = impact détecté)\n# b = OAM        (geotiff float32, 0=rien, 1=légal, 2=illégal, 3=hors titre)\n# Sortie : carte TP/FP/FN + métriques précision/rappel/F1/IoU\n# ─────────────────────────────────────────────────────────────────────────────\ndef _band(x):\n    if not isinstance(x, dict): return None\n    arr = np.asarray(x['bands'], dtype=np.float32)\n    return arr[0] if arr.ndim == 3 else arr\n\ndet = _band(a)   # détection binaire\noam = _band(b)   # OAM classes\n\nif det is None or oam is None:\n    out_main   = None\n    out_any    = None\n    out_scalar = 0.0\n    out_dict   = {'erreur': 'Brancher a=détection (out_any), b=OAM geotiff'}\nelse:\n    det_bin = (det > 0).astype(np.uint8)\n    oam_bin = (oam > 0).astype(np.uint8)\n\n    TP = float(np.sum((det_bin == 1) & (oam_bin == 1)))\n    FP = float(np.sum((det_bin == 1) & (oam_bin == 0)))\n    FN = float(np.sum((det_bin == 0) & (oam_bin == 1)))\n    TN = float(np.sum((det_bin == 0) & (oam_bin == 0)))\n\n    eps       = 1e-9\n    precision = TP / (TP + FP + eps)\n    recall    = TP / (TP + FN + eps)\n    f1        = 2 * precision * recall / (precision + recall + eps)\n    iou       = TP / (TP + FP + FN + eps)\n    accuracy  = (TP + TN) / (TP + FP + FN + TN + eps)\n\n    # Carte d'erreur spatiale\n    H, W = det_bin.shape\n    vis  = np.zeros((H, W, 3), dtype=np.uint8)\n    vis[(det_bin==1) & (oam_bin==1)] = (40, 200, 40)   # TP · vert\n    vis[(det_bin==1) & (oam_bin==0)] = (40, 140, 220)  # FP · orange\n    vis[(det_bin==0) & (oam_bin==1)] = (40,  40, 200)  # FN · rouge\n    # TN = noir (fond)\n    out_main   = vis\n    out_any    = None\n    out_scalar = round(f1, 3)\n    out_dict   = {\n        'precision': round(precision, 3),\n        'recall':    round(recall, 3),\n        'f1':        round(f1, 3),\n        'iou':       round(iou, 3),\n        'accuracy':  round(accuracy, 3),\n        'TP': int(TP), 'FP': int(FP), 'FN': int(FN), 'TN': int(TN),\n    }",
          "node_note": "Précision / Rappel / F1 / IoU · TP=vert FP=orange FN=rouge"
        }
      },
      "width": 560,
      "height": 520,
      "selected": false,
      "dragging": false,
      "positionAbsolute": {
        "x": 1360,
        "y": 460
      },
      "style": {
        "width": 560,
        "height": 520
      }
    },
