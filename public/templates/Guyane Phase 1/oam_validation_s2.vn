    {
      "id": "n-note-detect",
      "type": "canvas_note",
      "position": {
        "x": 60,
        "y": 52
      },
      "data": {
        "label": "Note",
        "params": {
          "text": "Seuillage multi-indices · BSI>−0.05 & NDVI<0.25 → sol nu (chantier)\nMNDWI>0.10 → eau turbide (bassin de décantation)\nAjuster les seuils selon la date et la couverture nuageuse",
          "color_index": 3
        }
      },
      "width": 560,
      "height": 60,
      "selected": false,
      "dragging": false,
      "positionAbsolute": {
        "x": 60,
        "y": 52
      }
    },
    {
      "id": "n-detect",
      "type": "logic_python",
      "position": {
        "x": 60,
        "y": 140
      },
      "data": {
        "label": "Python Node",
        "params": {
          "code": "# ── Détection orpaillage par seuillage multi-indices ────────────────────────\n# Entrée : a = geo_spectral_indices · stack (geotiff float32)\n# Stack order (indices activés dans l'ordre) :\n#   band 0 = NDVI   band 1 = NDWI   band 2 = MNDWI   band 3 = BSI\n# Seuils calibrés pour forêt tropicale dense guyanaise.\n# ─────────────────────────────────────────────────────────────────────────────\nndvi_thr  =  0.20   # < seuil → sol nu / dégradé (forêt dense Guyane ~ 0.7-0.9)\nbsi_thr   =  0.05   # > seuil → sol nu confirmé (valeur positive exigée)\nmndwi_thr =  0.15   # > seuil → eau turbide / bassin décantation\n\nif not isinstance(a, dict) or 'bands' not in a:\n    out_main = None\n    out_any  = None\n    out_dict = {'erreur': 'Brancher geo_spectral_indices · stack → a'}\nelse:\n    stk = np.asarray(a['bands'], dtype=np.float32)  # (N, H, W)\n    N, H, W = stk.shape\n\n    ndvi  = stk[0] if N > 0 else None\n    ndwi  = stk[1] if N > 1 else None\n    mndwi = stk[2] if N > 2 else None\n    bsi   = stk[3] if N > 3 else None\n\n    zeros = np.zeros((H, W), dtype=bool)\n    m_bare    = (bsi   > bsi_thr)   if bsi   is not None else zeros\n    m_low_veg = (ndvi  < ndvi_thr)  if ndvi  is not None else zeros\n    m_water   = (mndwi > mndwi_thr) if mndwi is not None else zeros\n\n    detected = (m_bare & m_low_veg) | m_water\n\n    # Nettoyage morphologique (ouverture 3×3 → supprime pixels isolés)\n    kernel  = cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (3, 3))\n    cleaned = cv2.morphologyEx(\n        detected.astype(np.uint8), cv2.MORPH_OPEN, kernel\n    ).astype(bool)\n\n    # Sortie geotiff binaire (1.0 = impact détecté)\n    out_any = {\n        **a,\n        'bands': cleaned.astype(np.float32)[np.newaxis],\n        'count': 1, 'dtype': 'float32',\n    }\n\n    vis = np.zeros((H, W, 3), dtype=np.uint8)\n    vis[cleaned] = (40, 40, 220)   # rouge BGR = impact\n    out_main = vis\n\n    out_dict = {\n        'pct_detecte': round(float(cleaned.mean() * 100), 2),\n        'n_pixels':    int(cleaned.sum()),\n    }",
          "node_note": "Seuillage BSI+NDVI+MNDWI → masque binaire impact minier · ajuster seuils selon image",
          "color_index": 3
        }
      },
      "width": 560,
      "height": 560,
      "selected": false,
      "dragging": false,
      "positionAbsolute": {
        "x": 60,
        "y": 140
      },
      "style": {
        "width": 560,
        "height": 560
      }
    },
