    {
      "id": "n-note-detect",
      "type": "canvas_note",
      "position": { "x": 60, "y": 52 },
      "data": {
        "label": "Note",
        "params": {
          "text": "Seuillage multi-indices · BSI>−0.05 & NDVI<0.25 → sol nu (chantier)\nMNDWI>0.10 → eau turbide (bassin de décantation)\nAjuster les seuils selon la date et la couverture nuageuse"
        }
      },
      "width": 560, "height": 60,
      "selected": false, "dragging": false,
      "positionAbsolute": { "x": 60, "y": 52 }
    },
    {
      "id": "n-detect",
      "type": "logic_python",
      "position": { "x": 60, "y": 140 },
      "data": {
        "label": "Détection (seuillage)",
        "params": {
          "code": "# ── Détection orpaillage par seuillage multi-indices ────────────────────────\n# Sol nu (BSI élevé) + végétation faible (NDVI bas)\n# + eau turbide optionnelle (MNDWI positif pour bassins de décantation)\n# Calibré pour forêt tropicale dense guyanaise.\n#\n# Entrées :\n#   a = NDWI  (geo_spectral_indices · ndwi)\n#   b = BSI   (geo_spectral_indices · bsi)\n#   c = NDVI  (geo_spectral_indices · ndvi)\n#   d = MNDWI (geo_spectral_indices · mndwi)\n# ─────────────────────────────────────────────────────────────────────────────\nndvi_thr  = 0.25    # < seuil → sol nu / végétation dégradée\nbsi_thr   = -0.05   # > seuil → sol nu exposé\nmndwi_thr =  0.10   # > seuil → eau turbide / bassin de décantation\n\ndef _band(x):\n    if not isinstance(x, dict): return None\n    arr = np.asarray(x['bands'], dtype=np.float32)\n    return arr[0] if arr.ndim == 3 else arr\n\nndwi  = _band(a)\nbsi   = _band(b)\nndvi  = _band(c)\nmndwi = _band(d)\ngeo_ref = a if isinstance(a, dict) else {}\n\nif ndvi is None and bsi is None:\n    out_main = None\n    out_any  = None\n    out_dict = {'erreur': 'Brancher a=NDWI, b=BSI, c=NDVI, d=MNDWI'}\nelse:\n    ref   = ndvi if ndvi is not None else bsi\n    H, W  = ref.shape\n\n    m_bare    = bsi   >  bsi_thr   if bsi   is not None else np.zeros((H,W), bool)\n    m_low_veg = ndvi  <  ndvi_thr  if ndvi  is not None else np.zeros((H,W), bool)\n    m_water   = mndwi >  mndwi_thr if mndwi is not None else np.zeros((H,W), bool)\n\n    detected = (m_bare & m_low_veg) | m_water\n\n    # Nettoyage morphologique (ouverture 3×3 → supprime pixels isolés)\n    kernel  = cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (3, 3))\n    cleaned = cv2.morphologyEx(\n        detected.astype(np.uint8), cv2.MORPH_OPEN, kernel\n    ).astype(bool)\n\n    # Sortie geotiff binaire alignée sur le référentiel S2\n    out_any = {\n        **geo_ref,\n        'bands': cleaned.astype(np.float32)[np.newaxis],\n        'count': 1, 'dtype': 'float32',\n    }\n\n    # Visualisation : rouge = impact détecté\n    vis = np.zeros((H, W, 3), dtype=np.uint8)\n    vis[cleaned] = (40, 40, 220)\n    out_main = vis\n\n    out_dict = {\n        'pct_detecte':  round(float(cleaned.mean() * 100), 2),\n        'n_pixels': int(cleaned.sum()),\n    }",
          "node_note": "Seuillage BSI + NDVI + MNDWI → masque binaire impact minier"
        }
      },
      "width": 560, "height": 560,
      "selected": false, "dragging": false,
      "positionAbsolute": { "x": 60, "y": 140 },
      "style": { "width": 560, "height": 560 }
    },
