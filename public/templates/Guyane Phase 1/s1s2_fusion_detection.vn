    {
      "id": "n-metrics",
      "type": "logic_python",
      "position": {
        "x": 1360,
        "y": 570
      },
      "data": {
        "label": "Python Node",
        "params": {
          "node_note": "P/R/F1/IoU · TP=vert FP=orange FN=rouge",
          "code": "# ── Validation binaire : fusion S1+S2 vs OAM ────────────────────────────\ndef _band(x):\n    if not isinstance(x, dict): return None\n    arr = np.asarray(x['bands'], dtype=np.float32)\n    return arr[0] if arr.ndim == 3 else arr\n\ndet = _band(a)\noam = _band(b)\n\nif det is None or oam is None:\n    out_main = None; out_scalar = 0.0\n    out_dict = {'erreur': 'Brancher a=fused (out_any), b=OAM geotiff'}\nelse:\n    det_bin = (det > 0).astype(np.uint8)\n    oam_bin = (oam > 0).astype(np.uint8)\n    TP = int(np.sum((det_bin==1) & (oam_bin==1)))\n    FP = int(np.sum((det_bin==1) & (oam_bin==0)))\n    FN = int(np.sum((det_bin==0) & (oam_bin==1)))\n    TN = int(np.sum((det_bin==0) & (oam_bin==0)))\n    eps = 1e-9\n    precision = TP / (TP + FP + eps)\n    recall    = TP / (TP + FN + eps)\n    f1        = 2 * precision * recall / (precision + recall + eps)\n    iou       = TP / (TP + FP + FN + eps)\n    H, W = det_bin.shape\n    vis  = np.zeros((H, W, 3), dtype=np.uint8)\n    vis[(det_bin==1) & (oam_bin==1)] = (40, 200, 40)\n    vis[(det_bin==1) & (oam_bin==0)] = (40, 140, 220)\n    vis[(det_bin==0) & (oam_bin==1)] = (40,  40, 200)\n    out_main = vis; out_any = None\n    out_scalar = round(float(f1), 3)\n    out_dict = {\n        'precision': round(float(precision), 3),\n        'recall':    round(float(recall), 3),\n        'f1':        round(float(f1), 3),\n        'iou':       round(float(iou), 3),\n        'TP': TP, 'FP': FP, 'FN': FN, 'TN': TN,\n    }"
        }
      },
      "width": 560,
      "height": 130,
      "selected": false,
      "dragging": false,
      "positionAbsolute": {
        "x": 1360,
        "y": 570
      },
      "style": {
        "width": 560,
        "height": 130
      }
    },
