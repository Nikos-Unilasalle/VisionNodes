    {
      "id": "n-fusion",
      "type": "logic_python",
      "position": {
        "x": 560,
        "y": 80
      },
      "data": {
        "label": "Python Node",
        "params": {
          "node_note": "OR logique S2 (BSI+NDVI) | S1 (ΔVH+ΔRVI) · fusion complémentaire",
          "code": "# ── Fusion S1+S2 · détection orpaillage ─────────────────────────────────────\n# a = S2 stack (geotiff · NDVI[0] NDWI[1] MNDWI[2] BSI[3])\n# b = S1 T1 features (geotiff · VV VH RVI NRPB PDI en dB)\n# c = S1 T2 features (même structure)\n#\n# Fusion OR : détecté SI (S2_bare AND S2_low_veg) OR (S1_delta_vh AND S1_delta_rvi)\n# Avantage : S2 aveugle sous nuages ↔ S1 cloud-proof\n# ─────────────────────────────────────────────────────────────────────────────\n# Seuils S2\nndvi_thr  =  0.20\nbsi_thr   =  0.05\nmndwi_thr =  0.15\n# Seuils S1\nth_vh_db  =  2.0\nth_rvi    =  0.08\n# Filtrage speckle\nkernel_size = 7\n\ndef _get_s2(geo, idx):\n    if not isinstance(geo, dict): return None\n    arr = np.asarray(geo['bands'], dtype=np.float32)\n    stk = arr if arr.ndim == 3 else arr[np.newaxis]\n    return stk[idx] if stk.shape[0] > idx else None\n\ndef _get_s1(geo, name):\n    if not isinstance(geo, dict): return None\n    names = geo.get('band_names', [])\n    if isinstance(names, str): names = names.split(',')\n    names = [n.lower() for n in names]\n    arr = np.asarray(geo['bands'], dtype=np.float32)\n    return arr[names.index(name)] if name in names else None\n\ndef _smooth(x):\n    k = (kernel_size | 1)\n    return cv2.blur(x, (k, k))\n\nif not isinstance(a, dict) or not isinstance(b, dict) or not isinstance(c, dict):\n    out_main = None; out_any = None; out_scalar = 0.0\n    out_dict = {'erreur': 'Brancher a=S2 stack, b=S1 T1, c=S1 T2'}\nelse:\n    # ── S2 features ──────────────────────────────────────────────────────────\n    ndvi  = _get_s2(a, 0); ndwi  = _get_s2(a, 1)\n    mndwi = _get_s2(a, 2); bsi   = _get_s2(a, 3)\n    geo_ref = a\n\n    H = (ndvi if ndvi is not None else bsi).shape[0]\n    W = (ndvi if ndvi is not None else bsi).shape[1]\n    zeros = np.zeros((H, W), bool)\n\n    s2_bare    = (bsi   > bsi_thr)   if bsi   is not None else zeros\n    s2_low_veg = (ndvi  < ndvi_thr)  if ndvi  is not None else zeros\n    s2_water   = (mndwi > mndwi_thr) if mndwi is not None else zeros\n    s2_detect  = (s2_bare & s2_low_veg) | s2_water\n    k3 = cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (3, 3))\n    s2_detect  = cv2.morphologyEx(s2_detect.astype(np.uint8), cv2.MORPH_OPEN, k3).astype(bool)\n\n    # ── S1 change features ───────────────────────────────────────────────────\n    vh1 = _get_s1(b, 'vh'); rvi1 = _get_s1(b, 'rvi')\n    vh2 = _get_s1(c, 'vh'); rvi2 = _get_s1(c, 'rvi')\n\n    if vh1 is not None and vh2 is not None:\n        delta_vh  = _smooth(vh2)  - _smooth(vh1)\n        delta_rvi = (_smooth(rvi2) - _smooth(rvi1)) if rvi1 is not None and rvi2 is not None \\\n                    else np.zeros((H, W), np.float32)\n        delta_vh  -= np.median(delta_vh)\n        delta_rvi -= np.median(delta_rvi)\n        s1_loss    = delta_vh  < -th_vh_db\n        s1_rvi_los = delta_rvi < -th_rvi\n        s1_detect  = cv2.morphologyEx((s1_loss & s1_rvi_los).astype(np.uint8),\n                                      cv2.MORPH_OPEN, k3).astype(bool)\n    else:\n        s1_detect = zeros\n\n    # ── Fusion OR ────────────────────────────────────────────────────────────\n    fused = s2_detect | s1_detect\n\n    # Visualisation : vert=S2 seul, bleu=S1 seul, blanc=S1+S2\n    vis = np.zeros((H, W, 3), dtype=np.uint8)\n    vis[s2_detect & ~s1_detect] = (40, 200, 40)    # S2 seul  (vert)\n    vis[s1_detect & ~s2_detect] = (200, 80, 40)    # S1 seul  (bleu)\n    vis[s2_detect &  s1_detect] = (220, 220, 220)  # les deux (blanc)\n    out_main = vis\n\n    out_any = {\n        **geo_ref,\n        'bands': fused.astype(np.float32)[np.newaxis],\n        'count': 1, 'dtype': 'float32', 'band_names': ['fused'],\n    }\n    out_scalar = round(float(fused.mean() * 100), 2)\n    out_dict = {\n        'pct_s2_detect':  round(float(s2_detect.mean() * 100), 2),\n        'pct_s1_detect':  round(float(s1_detect.mean() * 100), 2),\n        'pct_fused':      round(float(fused.mean()     * 100), 2),\n        'pct_s1_and_s2':  round(float((s2_detect & s1_detect).mean() * 100), 3),\n    }\n    out_e = None"
        }
      },
      "width": 640,
      "height": 560,
      "selected": false,
      "dragging": false,
      "positionAbsolute": {
        "x": 560,
        "y": 80
      },
      "style": {
        "width": 640,
        "height": 560
      }
    },
