    {
      "id": "nd",
      "type": "canvas_note",
      "position": {
        "x": -1500,
        "y": 40
      },
      "data": {
        "label": "Note",
        "params": {
          "text": "Signature de teinte : vert+bleu élevés, NIR faible, non-végétation.\nSeuils ajustables en tête de code.",
          "color_index": 2
        }
      },
      "width": 419,
      "height": 86,
      "selected": false
    },
    {
      "id": "n-det",
      "type": "logic_python",
      "position": {
        "x": -1500,
        "y": 120
      },
      "data": {
        "label": "Détecteur turquoise",
        "params": {
          "code": "import numpy as np, cv2\n# Détecteur ① turquoise — masque eau + clarté laiteuse (kaolinite)\nNIR_MAX=b      # eau = NIR faible (forêt NIR~0.32)\nP_LO,P_HI=30,98   # stretch percentile DANS l'eau\nMORPH_K=c\ndef _morph(m,k=3):\n    ker=cv2.getStructuringElement(cv2.MORPH_ELLIPSE,(k,k))\n    return cv2.morphologyEx(m.astype(np.uint8),cv2.MORPH_OPEN,ker)>0\ntry:\n    geo=a if isinstance(a,dict) else None\n    if geo is None:\n        out_main=None; out_any=None; out_dict={'erreur':'Brancher S2 (a)'}\n    else:\n        b=np.asarray(geo['bands'],dtype=np.float32)\n        if float(np.nanmax(b))>10.0: b=b/10000.0\n        R,Gr,B,NIR,SWIR=b[0],b[1],b[2],b[3],b[4]\n        H,W=R.shape; npx=H*W\n        water=_morph(NIR<NIR_MAX,MORPH_K)\n        # turquoise-ité = clarté vert+bleu au-dessus du rouge (laiteux, pas brun ni noir)\n        turq=((Gr+B)*0.5 - R*0.5)\n        det=np.zeros((H,W),dtype=np.float32)\n        tw=turq[water]\n        if tw.size>20:\n            lo=float(np.nanpercentile(tw,P_LO)); hi=float(np.nanpercentile(tw,P_HI))\n            rng=max(hi-lo,1e-4)\n            s=np.clip((turq-lo)/rng,0,1)\n            det=np.where(water,s,0.0).astype(np.float32)\n        u8=(np.clip(det,0,1)*255).astype(np.uint8)\n        prev=cv2.applyColorMap(u8,cv2.COLORMAP_OCEAN); prev[det<0.05]=[0,0,0]\n        out_main=prev\n        out_any={**geo,'bands':det[np.newaxis],'count':1,'dtype':'float32','band_names':['detection'],'_bands':['detection']}\n        out_dict={'water_pct':round(float(water.sum())/npx*100,2),\n                  'turq_lo':round(float(np.nanpercentile(turq[water],P_LO)) if water.sum()>20 else 0,3),\n                  'turq_hi':round(float(np.nanpercentile(turq[water],P_HI)) if water.sum()>20 else 0,3),\n                  'detect_pct':round(float((det>0.5).sum())/npx*100,3),'method':'turquoise_milkiness'}\nexcept Exception as _e:\n    out_main=None; out_any=None; out_dict={'exception':str(_e),'type':type(_e).__name__}\n",
          "node_note": "a=S2 → détection 0-1"
        }
      },
      "width": 208,
      "height": 249,
      "selected": false,
      "dragging": false
    },
