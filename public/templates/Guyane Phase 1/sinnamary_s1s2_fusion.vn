          "bbox": "-53.30,4.40,-52.60,5.50",
          "collection": 5,
          "date_start": "2024-01-01",
          "date_end": "2024-12-31",
          "resolution": 20,
          "stac_polarization": 0,
          "stac_orbit": 0,
          "stac_composite": 0,
          "stac_to_db": true,
          "stac_max_scenes": 30,
          "cache_dir": "copernicus_cache",
          "fetch": 0
        }
      },
      "width": 380, "height": 260
    },

