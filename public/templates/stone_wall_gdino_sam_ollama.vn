    {
      "id": "frame-llm",
      "type": "canvas_frame",
      "position": { "x": 880, "y": 200 },
      "style": { "width": 560, "height": 34, "zIndex": -1 },
      "data": { "label": "Frame", "params": { "collapsed": true, "savedHeight": 560, "color_index": 3, "title": "Classification Ollama (llava)" } },
      "width": 560, "height": 34
    },

    {
      "id": "img-1",
      "type": "input_image",
      "position": { "x": -220, "y": 280 },
      "data": {
        "label": "Stone Wall",
        "params": { "path": "samples/mixed-wall.jpg" }
      }
    },

    {
      "id": "gdino-1",
      "type": "grounding_dino_detector",
      "position": { "x": 100, "y": 280 },
      "data": {
        "label": "Grounding DINO",
        "params": {
          "hf_token": "",
          "text_prompt": "stone",
          "model": 0,
          "tile_mode": 2,
          "tile_overlap": 64,
          "box_threshold": 0.20,
          "text_threshold": 0.15,
          "nms_threshold": 0.5,
          "show_labels": true,
          "max_boxes": 0
        }
      }
    },
    {
      "id": "disp-gdino",
      "type": "output_display",
      "position": { "x": 100, "y": 580 },
      "data": { "label": "GDINO — Bboxes", "params": { "color_index": 5 } }
    },

    {
      "id": "sam-1",
      "type": "sam_segmenter",
      "position": { "x": 500, "y": 280 },
      "data": {
        "label": "SAM Segmenter",
        "params": {
          "hf_token": "",
          "model": 1,
          "prompt_mode": 3,
          "multimask": false,
          "mask_select": 0,
          "overlay_opacity": 55
        }
      }
    },
    {
      "id": "disp-sam",
      "type": "output_display",
      "position": { "x": 500, "y": 580 },
      "data": { "label": "SAM — Masques", "params": { "color_index": 4 } }
    },

    {
      "id": "llm-1",
      "type": "llm_inference",
      "position": { "x": 900, "y": 280 },
      "data": {
        "label": "Ollama — Classification pierres",
        "params": {
          "provider": 0,
          "model": "gemma4:e4b",
          "api_key": "",
          "base_url": "",
          "system_prompt": "You are an expert petrographer. You receive an image of a stone wall where each colored region is one individual stone segmented by AI. Analyze the visible stones and classify them by type based on color, texture, and morphology. Respond ONLY with valid JSON.",
          "user_prompt": "Classify the stone types visible in this segmented wall image. For each distinct stone type you can identify, give a name, visual description, and estimated count. Return JSON: {\"stone_types\": [{\"name\": \"...\", \"description\": \"...\", \"estimated_count\": N}], \"dominant_type\": \"...\", \"wall_notes\": \"...\"}",
          "json_mode": true,
          "temperature": 0.3,
          "max_tokens": 512,
          "timeout": 60
        }
      },
      "style": { "width": 300 },
      "width": 300
    },
    {
      "id": "insp-text",
      "type": "data_inspector",
      "position": { "x": 1260, "y": 280 },
      "data": { "label": "Résultat classification", "params": { "color_index": 3 } }
    },
    {
      "id": "insp-count",
      "type": "data_inspector",
      "position": { "x": 1260, "y": 500 },
      "data": { "label": "Nb pierres détectées", "params": {} }
    }
  ],
  "edges": [
    { "id": "e-img-gdino",       "source": "img-1",   "sourceHandle": "image__main",       "target": "gdino-1", "targetHandle": "image__image" },
    { "id": "e-img-sam",         "source": "img-1",   "sourceHandle": "image__main",       "target": "sam-1",   "targetHandle": "image__image" },
    { "id": "e-gdino-boxes-sam", "source": "gdino-1", "sourceHandle": "list__boxes_list",  "target": "sam-1",   "targetHandle": "any__boxes" },
    { "id": "e-gdino-disp",      "source": "gdino-1", "sourceHandle": "image__main",       "target": "disp-gdino", "targetHandle": "image__main" },
    { "id": "e-sam-disp",        "source": "sam-1",   "sourceHandle": "image__main",       "target": "disp-sam",   "targetHandle": "image__main" },
    { "id": "e-sam-llm-img",     "source": "sam-1",   "sourceHandle": "image__main",       "target": "llm-1",   "targetHandle": "image__image" },
    { "id": "e-llm-insp",        "source": "llm-1",   "sourceHandle": "dict__json_data",   "target": "insp-text",  "targetHandle": "any__data" },
    { "id": "e-sam-count",       "source": "sam-1",   "sourceHandle": "scalar__count",     "target": "insp-count", "targetHandle": "any__data" }
  ]
}
