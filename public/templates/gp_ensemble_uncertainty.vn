{
  "nodes": [
    {
      "id": "note_intro",
      "type": "canvas_note",
      "position": { "x": -40, "y": -340 },
      "data": {
        "label": "GP Ensemble — Uncertainty Quantification",
        "params": {
          "text": "# Turbidity : Symbolic Regression + Incertitude par Pixel\n\n**Innovation** : N modèles GP indépendants (bootstrap) → chaque pixel = μ (estimée) + σ (incertitude).\n\n## Pipeline\n🔵 **TRAINING** (gauche) : GLORIA CSV 295 matchups → GP Ensemble\n🟠 **INFÉRENCE** (droite) : Copernicus S2 → ACOLITE → NDWI mask → Bands→Table → Filter → Apply → Raster μ/σ\n\n▶ Cliquer **Train Ensemble** sur le node GP pour lancer l'évolution.",
          "width": 900,
          "height": 160,
          "fontSize": 13
        }
      },
      "width": 900,
      "height": 160
    },

    {
      "id": "csv_gloria",
      "type": "ml_csv_reader",
      "position": { "x": -40, "y": -140 },
      "data": {
        "label": "GLORIA CSV (295 matchups)",
        "params": {
          "path": "engine/plugins/copernicus_cache/gloria_turbidity.csv",
          "separator": 0,
          "max_rows": 0,
          "reload": 0
        }
      },
      "width": 280,
      "height": 220
    },

    {
      "id": "gp",
      "type": "ml_symbolic_regressor",
      "position": { "x": 280, "y": -140 },
      "data": {
        "label": "GP Symbolic Regressor (N=10)",
        "params": {
          "target_column": "label",
          "feature_columns": "Bleu,Vert,Rouge,NIR",
          "n_ensemble": 10,
          "population_size": 500,
          "generations": 20,
          "parsimony": 0.01,
          "test_size": 0.2,
          "log_transform": true,
          "use_log": true,
          "use_sqrt": true,
          "use_div": true,
          "seed": 42,
          "run": 0
        }
      },
      "width": 300,
      "height": 380
    },

    {
      "id": "copernicus",
      "type": "geo_copernicus",
      "position": { "x": 700, "y": -140 },
      "data": {
        "label": "Sentinel-2 L2A (CDSE)",
        "params": {}
      },
      "width": 300,
      "height": 320
    },

    {
      "id": "acolite",
      "type": "geo_acolite_simple",
      "position": { "x": 700, "y": 220 },
      "data": {
        "label": "ACOLITE (BOA → Rrs)",
        "params": {
          "auto_scale": true,
          "dos1": true,
          "dos_percentile": 1.0,
          "to_rrs": true,
          "clip_rrs_max": 0.12,
          "band_names": "Bleu,Vert,Rouge,NIR"
        }
      },
      "width": 280,
      "height": 280
    },

    {
      "id": "ndwi_mask",
      "type": "geo_ndwi_mask",
      "position": { "x": 700, "y": 540 },
      "data": {
        "label": "Water Mask (NDWI)",
        "params": {
          "green_band": 2,
          "nir_band": 4,
          "threshold": 0.05,
          "erode_px": 2
        }
      },
      "width": 260,
      "height": 220
    },

    {
      "id": "bands_table",
      "type": "geo_bands_to_table",
      "position": { "x": 1060, "y": 220 },
      "data": {
        "label": "Bands → Table",
        "params": {
          "band_names": "Bleu,Vert,Rouge,NIR",
          "filter_nodata": true
        }
      },
      "width": 260,
      "height": 200
    },

    {
      "id": "mask_filter",
      "type": "ml_table_mask_filter",
      "position": { "x": 1060, "y": 460 },
      "data": {
        "label": "Water Pixels Only",
        "params": {}
      },
      "width": 260,
      "height": 160
    },

    {
      "id": "apply",
      "type": "ml_ensemble_apply",
      "position": { "x": 1060, "y": 660 },
      "data": {
        "label": "Apply → μ + σ",
        "params": {
          "pred_column": "ntu",
          "clip_min": 0.0,
          "clip_max": 200.0
        }
      },
      "width": 280,
      "height": 200
    },

    {
      "id": "raster_mean",
      "type": "geo_table_to_raster",
      "position": { "x": 1420, "y": 220 },
      "data": {
        "label": "Mean NTU Raster (μ)",
        "params": {
          "column": "ntu",
          "colormap": 1,
          "nodata_val": -1.0,
          "class_0_label": "0 NTU",
          "class_1_label": "high NTU",
          "file_path": "ntu_mean.tif",
          "save": 0
        }
      },
      "width": 260,
      "height": 240
    },

    {
      "id": "raster_std",
      "type": "geo_table_to_raster",
      "position": { "x": 1420, "y": 500 },
      "data": {
        "label": "Uncertainty σ Raster",
        "params": {
          "column": "ntu",
          "colormap": 3,
          "nodata_val": -1.0,
          "class_0_label": "low σ",
          "class_1_label": "high σ",
          "file_path": "ntu_std.tif",
          "save": 0
        }
      },
      "width": 260,
      "height": 240
    },

    {
      "id": "d_csv",
      "type": "output_display",
      "position": { "x": -40, "y": 120 },
      "data": { "label": "GLORIA Preview", "params": {} },
      "width": 260,
      "height": 180
    },
    {
      "id": "d_gp",
      "type": "output_display",
      "position": { "x": 280, "y": 280 },
      "data": { "label": "GP Fitness + Formulas", "params": {} },
      "width": 300,
      "height": 260
    },
    {
      "id": "d_acolite",
      "type": "output_display",
      "position": { "x": 700, "y": 800 },
      "data": { "label": "ACOLITE histograms", "params": {} },
      "width": 280,
      "height": 220
    },
    {
      "id": "d_ndwi",
      "type": "output_display",
      "position": { "x": 1060, "y": -20 },
      "data": { "label": "NDWI Water Mask", "params": {} },
      "width": 260,
      "height": 200
    },
    {
      "id": "d_apply",
      "type": "output_display",
      "position": { "x": 1060, "y": 900 },
      "data": { "label": "Distribution μ vs σ (eau)", "params": {} },
      "width": 280,
      "height": 220
    },
    {
      "id": "d_mean",
      "type": "output_display",
      "position": { "x": 1740,  "y": 220 },
      "data": { "label": "NTU Map (μ) — eau seulement", "params": {} },
      "width": 300,
      "height": 280
    },
    {
      "id": "d_std",
      "type": "output_display",
      "position": { "x": 1740, "y": 520 },
      "data": { "label": "Uncertainty Map (σ) — eau seulement", "params": {} },
      "width": 300,
      "height": 280
    }
  ],
  "edges": [
    { "id": "e_csv_gp",        "source": "csv_gloria",  "sourceHandle": "data__table",       "target": "gp",          "targetHandle": "data__train_table" },
    { "id": "e_csv_prev",      "source": "csv_gloria",  "sourceHandle": "image__preview",    "target": "d_csv",       "targetHandle": "image__main" },
    { "id": "e_gp_prev",       "source": "gp",          "sourceHandle": "image__preview",    "target": "d_gp",        "targetHandle": "image__main" },
    { "id": "e_gp_models",     "source": "gp",          "sourceHandle": "dict__models",      "target": "apply",       "targetHandle": "dict__models" },

    { "id": "e_cop_acolite",   "source": "copernicus",  "sourceHandle": "geotiff__geotiff",  "target": "acolite",     "targetHandle": "geotiff__geotiff" },
    { "id": "e_acolite_bands", "source": "acolite",     "sourceHandle": "geotiff__geotiff",  "target": "bands_table", "targetHandle": "geotiff__geotiff" },
    { "id": "e_acolite_ndwi",  "source": "acolite",     "sourceHandle": "geotiff__geotiff",  "target": "ndwi_mask",   "targetHandle": "geotiff__geotiff" },
    { "id": "e_acolite_prev",  "source": "acolite",     "sourceHandle": "image__preview",    "target": "d_acolite",   "targetHandle": "image__main" },

    { "id": "e_bands_table",   "source": "bands_table", "sourceHandle": "data__table",       "target": "mask_filter", "targetHandle": "data__table" },
    { "id": "e_ndwi_filter",   "source": "ndwi_mask",   "sourceHandle": "mask__mask",        "target": "mask_filter", "targetHandle": "mask__mask" },
    { "id": "e_ndwi_prev",     "source": "ndwi_mask",   "sourceHandle": "image__ndwi_image", "target": "d_ndwi",      "targetHandle": "image__main" },

    { "id": "e_filter_apply",  "source": "mask_filter", "sourceHandle": "data__table",       "target": "apply",       "targetHandle": "data__table" },

    { "id": "e_bands_shape_m", "source": "bands_table", "sourceHandle": "list__shape",       "target": "raster_mean", "targetHandle": "list__shape" },
    { "id": "e_bands_shape_s", "source": "bands_table", "sourceHandle": "list__shape",       "target": "raster_std",  "targetHandle": "list__shape" },
    { "id": "e_bands_meta_m",  "source": "bands_table", "sourceHandle": "dict__geo_meta",    "target": "raster_mean", "targetHandle": "dict__geo_meta" },
    { "id": "e_bands_meta_s",  "source": "bands_table", "sourceHandle": "dict__geo_meta",    "target": "raster_std",  "targetHandle": "dict__geo_meta" },

    { "id": "e_apply_mean",    "source": "apply",       "sourceHandle": "data__mean_table",  "target": "raster_mean", "targetHandle": "data__table" },
    { "id": "e_apply_std",     "source": "apply",       "sourceHandle": "data__std_table",   "target": "raster_std",  "targetHandle": "data__table" },
    { "id": "e_apply_prev",    "source": "apply",       "sourceHandle": "image__preview",    "target": "d_apply",     "targetHandle": "image__main" },

    { "id": "e_mean_disp",     "source": "raster_mean", "sourceHandle": "image__main",       "target": "d_mean",      "targetHandle": "image__main" },
    { "id": "e_std_disp",      "source": "raster_std",  "sourceHandle": "image__main",       "target": "d_std",       "targetHandle": "image__main" }
  ]
}
