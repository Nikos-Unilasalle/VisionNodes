{
  "nodes": [
    {
      "id": "reader",
      "type": "geo_geotiff_reader",
      "position": { "x": 0, "y": 0 },
      "data": {
        "label": "L2 Surface Reflectance",
        "params": {
          "file_path": "engine/plugins/copernicus_cache/stac_8efc0e43a06338.tif",
          "r_band": 1,
          "g_band": 2,
          "b_band": 3
        }
      }
    },
    {
      "id": "dn",
      "type": "geo_dn_normalize",
      "position": { "x": 300, "y": 0 },
      "data": {
        "label": "DN → Reflectance [0,1]",
        "params": { "quantification": 10000, "offset": 0, "clamp": true }
      }
    },
    {
      "id": "noise",
      "type": "geo_raster_noise",
      "position": { "x": 600, "y": 0 },
      "data": {
        "label": "MC sensor perturbation",
        "params": {
          "sigma_abs": 0.01,
          "sigma_rel": 0.02,
          "clip_negative": true,
          "seed": 42,
          "node_note": "Stochastic/realtime: redraws each tick → drives the Monte-Carlo ensemble."
        }
      }
    },
    {
      "id": "idx",
      "type": "geo_spectral_indices",
      "position": { "x": 900, "y": 0 },
      "data": {
        "label": "4 water indices",
        "params": {
          "sensor": 0,
          "nir_band": 3, "red_band": 1, "green_band": 1, "blue_band": 2, "swir_band": 5,
          "ndvi": false, "ndwi": true, "evi": false, "mndwi": true, "nbr": false, "bsi": false,
          "expr1_enable": true, "expr1_label": "AWEInsh",
          "expr1": "4*(GREEN - SWIR) - (0.25*NIR + 2.75*B4)",
          "expr2_enable": true, "expr2_label": "AWEIsh",
          "expr2": "BLUE + 2.5*GREEN - 1.5*(NIR + SWIR) - 0.25*B4",
          "colormap": 0, "clamp_min": -5.0, "clamp_max": 5.0,
          "node_note": "Band order B03,B02,B08,B12,B11. SWIR=B11(band5)=SWIR1, B4=B12=SWIR2. Stack out = [NDWI, MNDWI, AWEInsh, AWEIsh]."
        }
      }
    },
    {
      "id": "vote",
      "type": "geo_band_calc",
      "position": { "x": 1200, "y": 0 },
      "data": {
        "label": "Consensus vote k=2 of 4",
        "params": {
          "expression": "(1*(B1>0)+1*(B2>0)+1*(B3>0)+1*(B4>0)) >= 2",
          "clamp_min": 0.0,
          "clamp_max": 1.0,
          "colormap": "gray"
        }
      }
    },
    {
      "id": "tomask",
      "type": "geotiff_to_mask",
      "position": { "x": 1500, "y": 0 },
      "data": {
        "label": "Vote → mask",
        "params": { "band_index": 0, "threshold": 0.5 }
      }
    },
    {
      "id": "acc_mean",
      "type": "sci_frame_accumulator",
      "position": { "x": 1800, "y": -160 },
      "data": {
        "label": "MC probability (mean)",
        "params": { "mode": 0, "window": 64, "reset": false }
      }
    },
    {
      "id": "acc_std",
      "type": "sci_frame_accumulator",
      "position": { "x": 1800, "y": 200 },
      "data": {
        "label": "MC uncertainty (std)",
        "params": { "mode": 3, "window": 64, "reset": false }
      }
    },
    {
      "id": "thr",
      "type": "filter_threshold",
      "position": { "x": 2100, "y": -160 },
      "data": {
        "label": "Binarize p ≥ 0.5",
        "params": { "threshold": 127 }
      }
    },
    {
      "id": "refine",
      "type": "mask_filter_area",
      "position": { "x": 2400, "y": -160 },
      "data": {
        "label": "Refine (fill + area filter)",
        "params": { "min_area_pct": 0.05, "min_area_px": 0, "fill_holes": true, "invert": false, "mode": 0 }
      }
    },
    {
      "id": "ref",
      "type": "geo_shapefile_rasterizer",
      "position": { "x": 1800, "y": 480 },
      "data": {
        "label": "Reference mask (optional — validation only)",
        "params": {
          "file_path": "<<OPTIONAL: reference water shapefile, only needed for metrics>>",
          "layer": "", "burn_field": "", "burn_value": 1.0,
          "all_touched": false, "background": 0.0,
          "cache_dir": "copernicus_cache"
        }
      }
    },
    {
      "id": "metrics",
      "type": "sci_mask_metrics",
      "position": { "x": 2700, "y": 0 },
      "data": {
        "label": "Precision / Recall / F1 / IoU",
        "params": { "show_overlay": true, "alpha": 0.45, "iou_thresh": 0.5 }
      }
    }
  ],
  "edges": [
    { "id": "e_reader_dn",     "source": "reader",   "target": "dn",       "sourceHandle": "geotiff", "targetHandle": "geotiff" },
    { "id": "e_dn_noise",      "source": "dn",       "target": "noise",    "sourceHandle": "geotiff", "targetHandle": "geotiff" },
    { "id": "e_noise_idx",     "source": "noise",    "target": "idx",      "sourceHandle": "geotiff", "targetHandle": "geotiff" },
    { "id": "e_idx_vote",      "source": "idx",      "target": "vote",     "sourceHandle": "stack",   "targetHandle": "geotiff" },
    { "id": "e_vote_tomask",   "source": "vote",     "target": "tomask",   "sourceHandle": "raw",     "targetHandle": "geotiff" },
    { "id": "e_tomask_mean",   "source": "tomask",   "target": "acc_mean", "sourceHandle": "mask",    "targetHandle": "image" },
    { "id": "e_tomask_std",    "source": "tomask",   "target": "acc_std",  "sourceHandle": "mask",    "targetHandle": "image" },
    { "id": "e_mean_thr",      "source": "acc_mean", "target": "thr",      "sourceHandle": "main",    "targetHandle": "image" },
    { "id": "e_thr_refine",    "source": "thr",      "target": "refine",   "sourceHandle": "mask",    "targetHandle": "mask" },
    { "id": "e_refine_metrics","source": "refine",   "target": "metrics",  "sourceHandle": "mask",    "targetHandle": "pred" },
    { "id": "e_ref_metrics",   "source": "ref",      "target": "metrics",  "sourceHandle": "mask",    "targetHandle": "truth" }
  ],
  "ui": { "zoom": 0.6, "viewport": { "x": 40, "y": 320, "zoom": 0.6 } }
}
