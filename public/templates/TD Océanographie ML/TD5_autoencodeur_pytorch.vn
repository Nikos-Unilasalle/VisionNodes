    {
      "id": "bilan_py",
      "type": "logic_python",
      "position": { "x": 1040, "y": 270 },
      "width": 260, "height": 153,
      "data": {
        "label": "Python Node",
        "params": {
          "node_note": "Exercice 5 — bilan ACP vs Autoencodeur",
          "code": "# TD5 : Bilan Comparatif ACP vs Autoencodeur\n# a = PSNR depuis viz_grid_compare (ACP)\n# b = MSE  depuis autoencodeur (logic_python out_scalar)\n\nimport math\npsnr_pca = a\nmse_ae   = b\n\nif psnr_pca is None or mse_ae is None:\n    out_dict = {'statut': 'Branchez les sorties PSNR et MSE'}\nelse:\n    psnr_ae = round(10 * math.log10(1.0 / (mse_ae + 1e-10)), 2)\n\n    out_dict = {\n        'PSNR_ACP_dB':          round(float(psnr_pca), 2),\n        'PSNR_Autoencodeur_dB': psnr_ae,\n        'gagnant':              'Autoencodeur' if psnr_ae > float(psnr_pca) else 'ACP',\n        'ecart_dB':             round(abs(psnr_ae - float(psnr_pca)), 2),\n    }\n    # Exercice :\n    # 1. Augmentez latent_dim -> MSE diminue, compression aussi\n    # 2. Qu'est-ce qui limite l'autoencodeur ?\n    # 3. Essayez d'augmenter n_epochs ou de changer le lr\n    # 4. Comparez le nb de parametres PyTorch vs nb de coefficients ACP"
        }
      }
    },
