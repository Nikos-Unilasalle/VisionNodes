    {
      "id": "pca_ref",
      "type": "ml_grid_pca",
      "position": { "x": 360, "y": 80 },
      "width": 240, "height": 153,
      "data": {
        "label": "Spatial PCA (EOF)",
        "params": {
          "n_components": 10,
          "standardize": true,
          "detrend": 1,
          "colormap": 3,
          "node_note": "Reference lineaire k=10 — a battre avec l'autoencodeur !"
        }
      }
    },
    {
      "id": "autoencoder_py",
      "type": "logic_python",
      "position": { "x": 360, "y": 530 },
      "width": 280, "height": 180,
      "data": {
        "label": "Python Node",
        "params": {
          "node_note": "Autoencodeur PyTorch — modifiez latent_dim et n_epochs. Premier run = entrainement (~30s).",
          "code": "# TD5 : Autoencodeur Lineaire (PyTorch)\n# Un autoencodeur apprend une representation compressee non-lineaire.\n# Encodeur : D dimensions -> couche cachee -> latent_dim\n# Decodeur : latent_dim  -> couche cachee -> D dimensions\n#\n# Entree a = grids (T x H x W)\n# Sorties : out_any = grids reconstruites, out_scalar = MSE, out_dict = metriques\n\ngrids = a\nif grids is None:\n    out_dict = {'statut': 'En attente des donnees...'}\nelse:\n    grids_id = id(grids)\n    if state.get('grids_id') == grids_id:\n        out_any    = state['recon']\n        out_scalar = state['mse']\n        out_dict   = state['metrics']\n    else:\n        import torch\n        import torch.nn as nn\n\n        T, H, W = grids.shape\n\n        # Pretraitement\n        X     = grids.reshape(T, H * W).astype('float32')\n        valid = ~np.isnan(X).any(axis=0)\n        Xv    = X[:, valid]\n        mu    = Xv.mean(axis=0)\n        sig   = Xv.std(axis=0) + 1e-6\n        Xn    = torch.tensor((Xv - mu) / sig)\n        D     = Xn.shape[1]\n\n        # Hyperparametres (modifiez !)\n        latent_dim = 10    # dimension de l'espace latent\n        hidden_dim = 64    # taille couche cachee\n        n_epochs   = 300   # iterations d'entrainement\n        lr         = 5e-3  # taux d'apprentissage\n\n        # Architecture\n        class AE(nn.Module):\n            def __init__(self):\n                super().__init__()\n                self.enc = nn.Sequential(\n                    nn.Linear(D, hidden_dim), nn.ReLU(),\n                    nn.Linear(hidden_dim, latent_dim)\n                )\n                self.dec = nn.Sequential(\n                    nn.Linear(latent_dim, hidden_dim), nn.ReLU(),\n                    nn.Linear(hidden_dim, D)\n                )\n            def forward(self, x):\n                return self.dec(self.enc(x))\n\n        model  = AE()\n        opt    = torch.optim.Adam(model.parameters(), lr=lr)\n        losses = []\n        for epoch in range(n_epochs):\n            opt.zero_grad()\n            loss = ((model(Xn) - Xn) ** 2).mean()\n            loss.backward()\n            opt.step()\n            if epoch % 50 == 0:\n                losses.append(round(float(loss), 6))\n\n        # Reconstruction\n        with torch.no_grad():\n            Xr = model(Xn).numpy() * sig + mu\n        recon = np.full((T, H * W), np.nan)\n        recon[:, valid] = Xr\n        recon = recon.reshape(T, H, W)\n        mse   = float(np.nanmean((grids - recon) ** 2))\n\n        state.update({\n            'grids_id': grids_id, 'recon': recon, 'mse': mse,\n            'metrics': {\n                'MSE_autoencodeur':  round(mse, 6),\n                'latent_dim':        latent_dim,\n                'taux_compression':  f'1:{round(D / latent_dim)}',\n                'courbe_loss':       losses,\n                'nb_parametres_PyTorch': sum(p.numel() for p in model.parameters()),\n            }\n        })\n        out_any    = state['recon']\n        out_scalar = state['mse']\n        out_dict   = state['metrics']"
        }
      }
    },
