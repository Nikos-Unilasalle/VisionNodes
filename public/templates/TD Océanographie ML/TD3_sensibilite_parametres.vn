    {
      "id": "bilan_py",
      "type": "logic_python",
      "position": { "x": 1020, "y": 270 },
      "width": 260, "height": 153,
      "data": {
        "label": "Python Node",
        "params": {
          "node_note": "Exercice 3 — bilan comparatif qualite vs compression",
          "code": "# TD3 : Comparaison Quantitative des Configurations ACP\n# a = MSE  avec k=3  (scalar depuis viz_grid_compare)\n# b = MSE  avec k=20 (scalar depuis viz_grid_compare)\n# c = meta (dict depuis geo_netcdf_reader)\n\nimport math\n\nmse_low  = a\nmse_high = b\nmeta     = c\n\nif mse_low is None or mse_high is None:\n    out_dict = {'statut': 'Branchez les sorties MSE des deux comparateurs'}\nelse:\n    psnr_low  = round(10 * math.log10(1.0 / (mse_low  + 1e-10)), 2)\n    psnr_high = round(10 * math.log10(1.0 / (mse_high + 1e-10)), 2)\n    gain      = round(psnr_high - psnr_low, 2)\n\n    shape = (meta or {}).get('shape', [0, 0, 0])\n    T, H, W = shape[0], shape[1], shape[2]\n    ratio_low  = round((T * H * W) / (T * 3  + 3  * H * W), 1) if T else 0\n    ratio_high = round((T * H * W) / (T * 20 + 20 * H * W), 1) if T else 0\n\n    out_dict = {\n        'PSNR_k3_dB':      psnr_low,\n        'PSNR_k20_dB':     psnr_high,\n        'gain_PSNR_dB':    gain,\n        'compression_k3':  f'1:{ratio_low}x',\n        'compression_k20': f'1:{ratio_high}x',\n    }\n    out_scalar = gain\n\n    # Exercice : tracez PSNR en fonction de k (de 1 a 50).\n    # Quelle valeur de k correspond au 'coude' de la courbe ?"
        }
      }
    },
    {
      "id": "bilan_inspect",
      "type": "data_inspector",
      "position": { "x": 1300, "y": 270 },
      "width": 240, "height": 200,
      "data": {
        "label": "Data Inspector",
        "params": { "node_note": "Lequel offre le meilleur compromis qualite/compression ?" }
      }
    },
    {
