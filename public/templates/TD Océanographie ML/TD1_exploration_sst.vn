    {
      "id": "stats_py",
      "type": "logic_python",
      "position": { "x": 680, "y": 280 },
      "width": 260, "height": 153,
      "data": {
        "label": "Python Node",
        "params": {
          "node_note": "Exercice 1 — completez le code pour calculer la variance temporelle",
          "code": "# TD1 : Statistiques Descriptives des SST\n# Entrees :\n#   a = grids  (numpy T x H x W  — temperatures en degres C)\n#   b = meta   (dict avec coordonnees geographiques)\n# Sorties :\n#   out_dict   -> connecter au Data Inspector\n#   out_scalar -> variance max (exercice)\n\ngrids = a\nmeta  = b\n\nif grids is None:\n    out_dict = {'statut': 'Chargez un fichier NetCDF...'}\nelse:\n    T, H, W    = grids.shape\n    frame0     = grids[0]\n    ocean_mask = ~np.isnan(frame0)\n    all_valid  = grids[~np.isnan(grids)]\n\n    out_dict = {\n        'nb_pas_de_temps_T': T,\n        'hauteur_H': H,\n        'largeur_W': W,\n        'pct_ocean': round(100.0 * float(ocean_mask.sum()) / (H * W), 1),\n        'T_min_C':   round(float(np.nanmin(all_valid)), 2),\n        'T_max_C':   round(float(np.nanmax(all_valid)), 2),\n        'T_moy_C':   round(float(np.nanmean(all_valid)), 2),\n        'T_std_C':   round(float(np.nanstd(all_valid)), 3),\n        'nb_pixels_NaN': int(np.sum(np.isnan(frame0))),\n    }\n\n    # Exercice 1 : calculez la carte de variance temporelle pixel par pixel.\n    # Quel pixel est le plus variable dans le temps ?\n    # Decommentez et completez :\n    # var_map    = np.nanvar(grids, axis=0)   # shape (H, W)\n    # out_scalar = float(np.nanmax(var_map))  # variance maximale\n\n    # Exercice 2 : calculez la tendance temporelle (warming/cooling) en deg C/an.\n    # Indice : utilisez np.polyfit sur la dimension temporelle."
        }
      }
    },
    {
      "id": "stats_inspect",
      "type": "data_inspector",
      "position": { "x": 990, "y": 280 },
      "width": 260, "height": 200,
      "data": {
