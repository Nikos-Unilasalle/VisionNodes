      "position": { "x": 120, "y": -80 },
      "width": 240,
      "height": 180,
      "data": {
        "label": "ACP Spatiale (référence)",
        "params": {
          "n_components": 10,
          "standardize": true,
          "detrend": 1,
          "cos_lat": false,
          "node_note": "Référence PCA (k=10) — comparaison avec U-Net"
        }
      }
    },
    {
      "id": "unet",
      "type": "ml_unet_grid",
      "position": { "x": 120, "y": 200 },
      "width": 260,
      "height": 220,
      "data": {
        "label": "U-Net Grid",
        "params": {
          "n_latent": 16,
          "n_levels": 3,
          "n_epochs": 30,
          "batch_size": 8,
          "learning_rate": 0.001,
          "val_split": 0.2,
          "colormap": 0,
          "node_note": "Cliquez 'Entraîner' puis observez les courbes de loss. Exercice 1 : comparez le PSNR obtenu avec PCA (k=10). Exercice 2 : augmentez n_levels à 4 — l'architecture est-elle meilleure ?"
        }
      }
    },
