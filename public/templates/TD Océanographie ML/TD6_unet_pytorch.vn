      "position": { "x": -160, "y": 100 },
      "width": 208,
      "height": 153,
      "data": {
        "label": "NetCDF Grid Reader",
        "params": {
          "path": "samples/ocean_temperature.nc",
          "variable": "thetao",
          "lat_range": "4.5,6.5",
          "lon_range": "-53.5,-51.5",
          "colormap": 0
        }
      }
    },
