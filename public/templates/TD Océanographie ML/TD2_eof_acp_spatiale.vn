      }
    },
    {
      "id": "compression_py",
      "type": "logic_python",
      "position": { "x": 1020, "y": 420 },
      "width": 260, "height": 153,
      "data": {
        "label": "Python Node",
        "params": {
          "node_note": "Exercice 2 — calcul du taux de compression PCA",
          "code": "# TD2 : Calcul du Taux de Compression PCA\n# Entree a = meta (dict depuis geo_netcdf_reader)\n\nmeta = a\n\n# Modifiez k pour qu'il corresponde a n_components du noeud PCA !\nk = 5\n\nif meta is None:\n    out_dict = {'statut': 'Branchez meta depuis le lecteur NetCDF'}\nelse:\n    shape = meta.get('shape', [0, 0, 0])  # [T, H, W]\n    T, H, W = shape[0], shape[1], shape[2]\n\n    # Taille originale\n    taille_orig = T * H * W\n\n    # Taille avec k composantes PCA\n    # On stocke : k scores temporels (T*k) + k cartes spatiales (k*H*W)\n    taille_pca = T * k + k * H * W\n\n    ratio = taille_orig / taille_pca if taille_pca > 0 else 0\n\n    out_dict = {\n        'original_T_x_H_x_W': f'{T} x {H} x {W} = {taille_orig:,}',\n        'stockage_PCA':        taille_pca,\n        'taux_compression':    f'1:{round(ratio, 1)}',\n        'reduction_pct':       f'{round((1 - 1/ratio) * 100, 1)} %',\n    }\n    out_scalar = round(ratio, 2)"
        }
      }
    },
    {
      "id": "ratio_inspect",
      "type": "data_inspector",
      "position": { "x": 1300, "y": 420 },
      "width": 240, "height": 180,
      "data": {
        "label": "Data Inspector",
        "params": { "node_note": "Rapport de compression vs qualite de reconstruction" }
      }
    }
  ],
