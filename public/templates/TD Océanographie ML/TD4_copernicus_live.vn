        "params": {
          "node_note": "Exercice 4 — copiez une bbox et re-telechargez pour comparer des regions",
          "code": "# TD4 : Regions Oceaniques Predefinies\n# Copiez une des bbox ci-dessous dans le noeud Copernicus Marine\n# puis cliquez Telecharger.\n\nregions = {\n    'Guyane (defaut)':        '-53.5,4.5,-51.5,6.5',\n    'Atlantique tropical N':  '-35.0,0.0,-15.0,20.0',\n    'Mediterranee occ.':      '0.0,36.0,10.0,44.0',\n    'Mer des Caraibes':       '-80.0,10.0,-60.0,25.0',\n    'Pacifique El Nino':      '-170.0,-5.0,-120.0,5.0',\n    'Ocean Indien NW':        '50.0,5.0,70.0,25.0',\n}\n\nout_dict = regions\n\n# Exercice :\n# 1. Telechargez deux regions differentes\n# 2. Comparez leur k_opt (nb de composantes pour PSNR > 30 dB)\n# 3. Quelle region est la plus 'compressible' ? Pourquoi ?\n#    (Indice : pensez a la complexite spatiale des structures oceaniques)"
        }
      }
    }
