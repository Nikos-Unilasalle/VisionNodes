      "data": {
        "label": "Note",
        "id": "nD_inst",
        "params": {
          "text": "EXERCICE 2 — Feature Engineering\n\nCréez 3 nouvelles features pour le dataset Wine :\n\n1. 'qualite' : catégorie basée sur l'alcool\n   alcool < 12  → 'faible'\n   alcool 12-13 → 'moyen'\n   alcool > 13  → 'élevé'\n   INDICE : pd.cut()\n\n2. 'ratio_mg_ca' : ratio magnésium/calcium\n   (si présent dans le dataset)\n\n3. 'alcool_carre' : alcool au carré\n   (feature non-linéaire)\n\nout_data = df enrichi avec les 3 colonnes",
          "bg_color": "#fef9c3",
          "text_color": "#713f12"
        }
      },
      "width": 540,
      "height": 430,
      "selected": false
    },
    {
