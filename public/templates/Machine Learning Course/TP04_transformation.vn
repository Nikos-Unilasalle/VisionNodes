    {
      "id": "pyD",
      "type": "logic_python",
      "position": {
        "x": 770,
        "y": 1460
      },
      "data": {
        "label": "Python — Feature Eng.",
        "params": {
          "code": "# TP04 — Exercice 2 : Feature Engineering\n# 'a' = DataFrame Wine\n# ─────────────────────────────────────────\n\nimport pandas as pd, numpy as np\n\ndf = a.copy()\n\n# TODO 1 : Catégoriser l'alcool\ndf['qualite'] = pd.cut(\n    df['alcohol'],\n    bins=[0, 12, 13, 20],\n    labels=['faible', 'moyen', 'eleve']\n).astype(str)\n\n# TODO 2 : Ratio magnesium / ash\ndf['ratio_mg_ash'] = (df['magnesium'] / df['ash']).round(3)\n\n# TODO 3 : Feature non-linéaire\ndf['alcool_carre'] = (df['alcohol'] ** 2).round(4)\n\n# Vérification\nnouvelles = ['qualite', 'ratio_mg_ash', 'alcool_carre']\nout_data   = df[nouvelles + ['alcohol', 'target']]\nout_scalar = float(df['alcool_carre'].mean())\n"
        }
      },
      "width": 430,
      "height": 430,
      "selected": false
    },
