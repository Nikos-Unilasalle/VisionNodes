      "height": 153,
      "selected": false
    },
    {
      "id": "pyC",
      "type": "logic_python",
      "position": {
        "x": 770,
        "y": 910
      },
      "data": {
        "label": "Python — Normalisation",
        "params": {
          "code": "# TP04 — Exercice 1 : Normalisation\n# 'a' = DataFrame Iris\n# ─────────────────────────────────────\n\nimport pandas as pd\n\ncols_num = [c for c in a.columns if c != 'target']\n\n# TODO 1 : Normalisation Min-Max\ndf_minmax = a.copy()\nfor col in cols_num:\n    mn = a[col].min()\n    mx = a[col].max()\n    df_minmax[col] = (a[col] - mn) / (mx - mn)\n\n# TODO 2 : Normalisation Z-score (pour comparaison)\ndf_zscore = a.copy()\nfor col in cols_num:\n    df_zscore[col] = (a[col] - a[col].mean()) / a[col].std()\n\n# Vérification : min et max du df normalisé Min-Max\nassert df_minmax[cols_num].min().min() >= -0.001\nassert df_minmax[cols_num].max().max() <=  1.001\n\nout_data   = df_minmax\nout_scalar = float(df_zscore[cols_num].std().mean())\n"
        }
      },
      "width": 430,
      "height": 430,
      "selected": false
    },
