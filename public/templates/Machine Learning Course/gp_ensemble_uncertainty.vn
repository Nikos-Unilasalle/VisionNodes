    {
      "id": "node-1779818401075-rbm8j7gc5",
      "type": "logic_python",
      "position": {
        "x": 700,
        "y": -360
      },
      "style": {},
      "data": {
        "label": "Python Node",
        "params": {
          "code": "import pandas as pd\nimport numpy as np\n\ndf = a # ou le nom que tu as donné au port\n\n# Paramètres de rééquilibrage\nTARGET_COL    = 'label'\nCLEAR_MAX     = 5.0       # seuil \"Clear\" (NTU)\nKEEP_FRAC     = 0.30      # garder 30% de la classe Clear\nRANDOM_SEED   = 42\n\n# Sépare classes\nclear_mask = df[TARGET_COL] < CLEAR_MAX\ndf_clear   = df[clear_mask]\ndf_turbid  = df[~clear_mask]\n\n# Sous-échantillonne Clear\nn_keep   = max(50, int(len(df_clear) * KEEP_FRAC))\ndf_clear_sub = df_clear.sample(n=min(n_keep, len(df_clear)),\n                                random_state=RANDOM_SEED)\n\n# Recombine + shuffle\ndf_bal = pd.concat([df_clear_sub, df_turbid], ignore_index=True)\ndf_bal = df_bal.sample(frac=1, random_state=RANDOM_SEED).reset_index(drop=True)\n\nprint(f\"Avant : {len(df)}  (Clear={clear_mask.sum()}, Turbid={(~clear_mask).sum()})\")\nprint(f\"Après : {len(df_bal)}  (Clear={(df_bal[TARGET_COL]<CLEAR_MAX).sum()}, Turbid={(df_bal[TARGET_COL]>=CLEAR_MAX).sum()})\")\n\nout_data = df_bal"
        }
      },
      "width": 208,
      "height": 249,
      "selected": false,
      "dragging": false
    },
