      "position": {
        "x": 1520,
        "y": 340
      },
      "data": {
        "label": "",
        "params": {
          "text": "## 🟠 INFÉRENCE\nCopernicus L1C (date d'intérêt) → ACOLITE → masque eau NDWI\n→ Bands→Table → Filtre pixels eau → Apply Ensemble → Rasters μ/σ\n⚡ ACOLITE : bouton Run après téléchargement du .SAFE (~30-120s)",
          "width": 520,
          "height": 110,
          "fontSize": 12
        }
      },
      "width": 448,
      "height": 150,
      "selected": false,
      "positionAbsolute": {
        "x": 1520,
        "y": 340
      },
      "dragging": false
    },
