    },
    {
      "id": "pyD",
      "type": "logic_python",
      "position": {
        "x": 780,
        "y": 1430
      },
      "data": {
        "label": "Python — Filtrage avancé",
        "params": {
          "code": "# TP02 — Exercice 2 : Filtrage avancé\n# 'a' contient le DataFrame Iris complet\n# ─────────────────────────────────────────\n\n# TODO 1 : Garder uniquement l'espèce Versicolor (target == 1)\nversicolor = a[a['target'] == 1]\n\n# TODO 2 : Calculer Q1 de sepal length\nq1 = versicolor['sepal length (cm)'].quantile(0.25)\n\n# Garder les iris sous le Q1\nsous_q1 = versicolor[versicolor['sepal length (cm)'] <= q1]\n\n# TODO 3 : Calculer la moyenne de petal length\nmoy_petal = sous_q1['petal length (cm)'].mean()\n\nout_data = sous_q1\nout_scalar = float(moy_petal) if not __import__('math').isnan(moy_petal) else 0.0\n"
        }
      },
      "width": 420,
      "height": 430,
      "selected": false
    },
