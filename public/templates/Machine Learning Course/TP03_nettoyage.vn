      },
      "data": {
        "label": "Frame",
        "params": {
          "title": "C — Exercice 1 : Auditer et nettoyer un dataset",
          "color_index": 4
        }
      },
      "width": 1860,
      "height": 500,
      "selected": false
    },
    {
      "id": "nC_inst",
      "type": "canvas_note",
      "position": {
        "x": -90,
        "y": 920
      },
      "style": {
        "width": 540,
        "height": 400
      },
      "data": {
        "label": "Note",
        "id": "nC_inst",
        "params": {
          "text": "EXERCICE 1 — Audit complet\n\nComplétez le Python Node pour :\n\n1. Compter les NaN par colonne\n   INDICE : df.isna().sum()\n\n2. Calculer le pourcentage de NaN\n   INDICE : (nb_nan / len(df)) * 100\n\n3. Compter les lignes dupliquées\n   INDICE : df.duplicated().sum()\n\n4. Créer un rapport de qualité\n   sous forme de DataFrame\n\nout_data   = rapport de qualité (DataFrame)\nout_scalar = % de données manquantes (total)",
          "bg_color": "#fef9c3",
          "text_color": "#713f12"
        }
      },
      "width": 540,
      "height": 400,
      "selected": false
    },
    {
      "id": "dsC",
      "type": "ml_sklearn_dataset",
      "position": {
        "x": 490,
        "y": 930
      },
      "data": {
        "label": "Diabetes Ex1",
        "params": {
          "dataset": 3
        }
      },
      "width": 220,
      "height": 153,
      "selected": false
    },
    {
      "id": "pyC",
      "type": "logic_python",
      "position": {
        "x": 770,
        "y": 920
      },
      "data": {
        "label": "Python — Audit qualité",
        "params": {
          "code": "# TP03 — Exercice 1 : Audit qualité\n# 'a' = DataFrame à auditer\n# ─────────────────────────────────────\n\nimport pandas as pd\n\n# TODO 1 : Compter les NaN par colonne\nnan_count = a.isna().sum()\n\n# TODO 2 : Pourcentage de NaN par colonne\nnan_pct = (nan_count / len(a) * 100).round(2)\n\n# TODO 3 : Lignes dupliquées\nn_doublons = int(a.duplicated().sum())\n\n# Rapport de qualité\nrapport = pd.DataFrame({\n    'NaN_count': nan_count,\n    'NaN_%': nan_pct,\n    'dtype': a.dtypes\n})\n\n# TODO 4 : Calculer le % global de données manquantes\ntotal_vals = a.size\ntotal_nan  = int(a.isna().sum().sum())\npct_global = round(total_nan / total_vals * 100, 2)\n\nout_data   = rapport\nout_scalar = float(pct_global)\n"
        }
      },
      "width": 430,
      "height": 420,
      "selected": false
    },
