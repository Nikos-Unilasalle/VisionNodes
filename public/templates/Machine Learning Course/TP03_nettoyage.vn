      "data": {
        "label": "Note",
        "id": "nD_inst",
        "params": {
          "text": "EXERCICE 2 — Imputation\n\nComparez 3 stratégies pour gérer les NaN :\n\nPipeline A : Remplacer NaN par la MOYENNE\nPipeline B : Remplacer NaN par la MÉDIANE\nPipeline C : Supprimer les lignes avec NaN\n\nPour chaque pipeline :\n1. Connectez le dataset\n2. Utilisez df_fillna avec la bonne stratégie\n3. Observez l'impact sur describe()\n\nQUESTION : Quelle stratégie préserve\nle mieux la distribution originale ?",
          "bg_color": "#fef9c3",
          "text_color": "#713f12"
        }
      },
      "width": 540,
      "height": 430,
      "selected": false
