    },
    {
      "id": "nC_inst",
      "type": "canvas_note",
      "position": {
        "x": -90,
        "y": 900
      },
      "style": {
        "width": 540,
        "height": 430
      },
      "data": {
        "label": "Note",
        "id": "nC_inst",
        "params": {
          "text": "EXERCICE 1 — Groupby avancé\n\nAnalysez le dataset Wine par classe :\n\n1. Calculer pour chaque classe (0,1,2) :\n   • Moyenne d'alcool\n   • Écart-type d'alcool\n   • Nombre d'observations\n   → df.groupby('target').agg(...)\n\n2. Ajouter une colonne 'cv' (coefficient\n   de variation = std / mean * 100)\n\n3. Quelle classe est la plus homogène ?\n   (cv le plus faible)\n\nout_data   = DataFrame d'agrégation\nout_scalar = cv de la classe la + homogène",
          "bg_color": "#fef9c3",
          "text_color": "#713f12"
        }
      },
      "width": 540,
      "height": 430,
      "selected": false
    },
    {
      "id": "dsC",
      "type": "ml_sklearn_dataset",
      "position": {
        "x": 490,
        "y": 920
      },
      "data": {
        "label": "Sklearn Dataset",
        "params": {
          "dataset": 1,
          "node_note": "Wine Ex1"
        }
      },
      "width": 220,
      "height": 153,
      "selected": false
    },
    {
      "id": "pyC",
      "type": "logic_python",
      "position": {
        "x": 770,
        "y": 910
      },
      "data": {
        "label": "Python Node",
        "params": {
          "code": "# TP05 — Exercice 1 : Groupby multi-agrégation\n# 'a' = DataFrame Wine\n# target est une chaîne : 'class_0', 'class_1', 'class_2'\n# ─────────────────────────────────────────────\n\nimport pandas as pd\n\n# TODO 1 : Agrégation multi-colonnes\nagg = a.groupby('target').agg(\n    moy_alcool=('alcohol', 'mean'),\n    std_alcool=('alcohol', 'std'),\n    n=('alcohol', 'count')\n).round(3)\n\n# TODO 2 : Coefficient de variation\nagg['cv'] = (agg['std_alcool'] / agg['moy_alcool'] * 100).round(2)\n\n# TODO 3 : Trouver la classe la plus homogène\n# idxmin() retourne le nom de la classe (chaîne), pas un entier\nclasse_homo = str(agg['cv'].idxmin())\ncv_min      = float(agg['cv'].min())\n\nout_data   = agg.reset_index()\nout_scalar = cv_min\n",
          "node_note": "Python — Groupby avancé"
        }
      },
      "width": 430,
      "height": 430,
      "selected": false
    },
