    },
    {
      "id": "nA1",
      "type": "canvas_note",
      "position": {
        "x": -90,
        "y": -60
      },
      "style": {
        "width": 560,
        "height": 350
      },
      "data": {
        "label": "Note",
        "id": "nA1",
        "params": {
          "text": "groupby — Principe Split-Apply-Combine :\n\ndf.groupby('col')['val'].mean()\ndf.groupby('col').agg({'v': 'mean'})\ndf.groupby('col').agg(\n    moy=('val', 'mean'),\n    maxi=('val', 'max'),\n    compte=('val', 'count')\n)\n\nFonctions d'agrégation :\nmean, sum, min, max, count, std, var, median",
          "bg_color": "#dbeafe",
          "text_color": "#1e40af"
        }
      },
      "width": 560,
      "height": 350,
      "selected": false
    },
    {
      "id": "nA2",
      "type": "canvas_note",
      "position": {
        "x": 500,
        "y": -60
      },
      "style": {
        "width": 560,
        "height": 350
      },
      "data": {
        "label": "Note",
        "id": "nA2",
        "params": {
          "text": "Exemples pratiques :\n\n# Ventes par région\ndf.groupby('region')['ventes'].sum()\n\n# Prix moyen par catégorie\ndf.groupby('cat')['prix'].mean()\n\n# Multi-niveaux\ndf.groupby(['annee','mois']).agg(...)\n\n# Reset index après groupby\ndf.groupby('col').mean().reset_index()\n\n# transform() : aligne avec l'original\ndf['moy_groupe'] = df.groupby('cat')['v'].transform('mean')",
          "bg_color": "#1e293b",
          "text_color": "#94a3b8"
        }
      },
      "width": 560,
      "height": 350,
      "selected": false
    },
    {
      "id": "nA3",
      "type": "canvas_note",
      "position": {
        "x": 1090,
        "y": -60
      },
      "style": {
        "width": 560,
        "height": 350
      },
      "data": {
        "label": "Note",
        "id": "nA3",
        "params": {
          "text": "Pivot Tables :\n\npd.pivot_table(\n    df,\n    values='ventes',\n    index='region',\n    columns='trimestre',\n    aggfunc='sum',\n    fill_value=0\n)\n\n→ Croise deux variables catégorielles\n→ Équivalent du tableau croisé Excel\n→ Idéal pour heatmaps de corrélation",
          "bg_color": "#1e293b",
          "text_color": "#94a3b8"
        }
      },
      "width": 560,
      "height": 350,
      "selected": false
    },
