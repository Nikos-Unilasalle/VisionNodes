    {
      "id": "report",
      "type": "dict_report_panel",
      "position": {
        "x": 1530,
        "y": 4000
      },
      "data": {
        "label": "Report Panel",
        "params": {
          "title": "Anatomy Report",
          "groups": "Measured vs Projected: section_measured_%, cortex_measured_%, stele_measured_%, cells_measured, #CC_measured, #CC_projected, #CC, #CC_low, #CC_high | Cross-Section: RXSA, XSCWA, LA, TSA:RXSA | Cortex: TCA, CCWA, CCA, %CCA, #CC, #CF | Aerenchyma: AA, %A, #Lac | Cell Size by Zone: CSic, CSmc, CSoc | Stele: TSA, SCWA, XVA, #MX, large_peripheral_stele_cells, TSA:TCA | Layers & Quality: EA, ExA, px_per_mm, quality_score | Uncertainty: stele_edge_contrast, zones",
          "digits": 4,
          "color_index": 0,
          "node_note": "Same variables as Root Anatomy Analysis (RootScan Table 1), areas in mm². First group: how much of each tissue was MEASURED (cells closed by a real wall) and how many cortical cells were PROJECTED over the unresolved rest, with the 95 % interval of the total. Outlines (RXSA, TCA, TSA, AA, XVA, #MX) are measured; wall areas are measured in the resolved cells and applied to the whole tissue; #CC, #CF and CS = measured + projected. stele_edge_contrast: how sharp the stele outline was (below ~1.2, check it on the map)."
        }
      }
    },
