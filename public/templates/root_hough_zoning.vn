    {
      "id": "n_cf",
      "type": "math_expr",
      "position": {
        "x": 1030,
        "y": 4270
      },
      "data": {
        "label": "Math Expression",
        "params": {
          "expression": "(sqrt(a / pi) - sqrt(b / pi)) / max(2 * sqrt(c / max(d, 1) / pi), 1e-9)",
