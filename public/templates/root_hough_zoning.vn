          "c": 0,
          "adaptive_method": 1,
          "invert": false,
          "color_index": 3,
          "node_note": "Walls seen as pixels darker than their surroundings: good on small dark-walled cells."
        }
      }
    },
    {
      "id": "cells",
      "type": "seg_cells_from_walls",
      "position": {
        "x": 2640,
        "y": 70
      },
      "data": {
        "label": "Cells from Walls",
        "params": {
          "min_area": 12,
          "max_area": 6000,
          "min_solidity": 0.82,
          "overlap": 0.1,
          "footprint": 2,
          "min_contrast": 10,
          "color_index": 3,
          "node_note": "Adds the cells that the wall-to-wall test left out (small cells of the stele ring, cells beside vessels): spaces enclosed by the walls of either detector. Cells already resolved by Cell Tessellation are kept as they are; a new lumen must be 10 grey levels brighter than its wall (dark gaps between thick walls are no cells). Everything coloured on the map comes from here."
        }
      }
    },
    {
      "id": "radial0",
      "type": "geom_radial_coords",
      "position": {
        "x": 3010,
        "y": 70
      },
      "data": {
        "label": "Radial Coordinates",
        "params": {
          "smooth": 3.0,
          "ignore_border": true,
          "color_index": 4,
          "node_note": "First pass: centre = centroid of the section (wrong when the frame cuts the section)."
        }
      }
    },
    {
      "id": "zoning0",
      "type": "sci_profile_zoning",
      "position": {
        "x": 3260,
        "y": 70
      },
      "data": {
        "label": "Profile Zoning",
        "params": {
          "position_key": "rho",
          "value_key": "radius",
          "weight_key": "score",
          "log_values": true,
          "zones": 0,
          "max_zones": 6,
          "outlier_mad": 3.0,
          "outlier_side": 1,
          "min_items": 12,
          "core_rule": 1,
          "n_boot": 0,
          "seed": 0,
          "color_index": 4,
          "node_note": "First pass, only to find the core (stele) and re-centre on it."
        }
      }
    },
    {
      "id": "radial",
      "type": "geom_radial_coords",
      "position": {
        "x": 3010,
        "y": 610
      },
      "data": {
        "label": "Radial Coordinates",
        "params": {
          "smooth": 3.0,
          "ignore_border": true,
          "color_index": 4,
          "node_note": "ρ = 0 at the centre of the core found in the first pass, 1 on the section outline, along each ray."
        }
      }
    },
    {
      "id": "zoning",
      "type": "sci_profile_zoning",
      "position": {
        "x": 3260,
        "y": 610
      },
      "data": {
        "label": "Profile Zoning",
        "params": {
          "position_key": "rho",
          "value_key": "radius",
          "weight_key": "score",
          "log_values": true,
          "zones": 0,
          "max_zones": 6,
          "outlier_mad": 3.0,
          "outlier_side": 1,
          "min_items": 12,
          "core_rule": 1,
          "n_boot": 50,
          "seed": 0,
          "color_index": 4,
          "node_note": "Zones = stretches of ρ where cell size is homogeneous; number chosen by BIC. Core = everything inside the largest rise of cell size before the cortex (small stele cells → larger cortical cells) = the stele. Cells much larger than their neighbours (vessels) are set aside as outliers."
        }
      }
    },
    {
