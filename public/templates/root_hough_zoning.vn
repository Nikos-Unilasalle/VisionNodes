    {
      "id": "ridge",
      "type": "filter_ridge",
      "position": {
        "x": 1770,
        "y": 70
      },
      "data": {
        "label": "Ridge Filter",
        "params": {
          "method": 0,
          "polarity": 0,
          "sigma_min": 1.0,
          "sigma_max": 4.0,
          "n_scales": 4,
          "norm_radius": 15,
          "floor_pct": 40,
          "color_index": 2,
          "node_note": "Cell walls = dark lines, 2 to 8 px thick (σ 1–4). Local normalisation makes the faint walls of pale or blurred tissue (pith, inner cortex) count as much as the dark ones."
        }
      }
    },
    {
      "id": "tess",
      "type": "seg_cell_tessellation",
      "position": {
        "x": 2140,
        "y": 70
      },
      "data": {
        "label": "Cell Tessellation",
        "params": {
          "smooth": 1.0,
          "depth": 0.3,
          "wall_level": 0.7,
          "wall_ratio": 3.0,
          "min_closure": 0.8,
          "min_solidity": 0.85,
          "min_area": 15,
          "max_area": 0,
          "color_index": 3,
          "node_note": "Every cell rebuilt from wall to wall. A cell counts as MEASURED only if a real wall closes it; elsewhere the tissue is UNRESOLVED (hatched) and its cells are projected in Step 8."
        }
      }
    },
    {
      "id": "walls_a",
      "type": "cv_adaptive_threshold",
