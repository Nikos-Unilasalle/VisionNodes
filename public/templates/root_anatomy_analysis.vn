          "bar_length": 500.0,
          "unit": 0,
          "fallback_px_per_mm": 784.0,
          "color_index": 0,
          "node_note": "Enter the length printed next to the scale bar (500 µm on the bright-field samples, 200 µm on root_section.png, 100 µm on root_section_lateral.png). Fallback used if no bar is found."
        },
        "userLabel": "Scale Bar → px/mm"
