{
  "nodes": [
    {
      "id": "meta",
      "type": "bpa_metadata_reader",
      "position": { "x": 60, "y": 300 },
      "data": { "label": "BPA Metadata", "params": { "dataset_path": "", "sample_id": "HP_50" } },
      "width": 250, "height": 480
    },
    {
      "id": "loader",
      "type": "bpa_image_loader",
      "position": { "x": 580, "y": 180 },
      "data": { "label": "BPA Image Loader", "params": { "load_scale": 0.2, "path_override": "" } },
      "width": 250, "height": 300
    },
    {
      "id": "detector",
      "type": "bpa_stain_detector",
      "position": { "x": 1110, "y": 140 },
      "data": {
        "label": "BPA Stain Detector",
        "params": {
          "a_threshold": 5, "val_max": 230, "blur_r": 3,
          "min_stain_mm": 1.5, "max_stain_mm": 30.0, "min_aspect": 0.1,
          "filter_outliers": true,
          "show_ellipses": true, "show_angles": true, "show_centers": true
        }
      },
      "width": 270, "height": 420
    },
    {
      "id": "reconstructor",
      "type": "bpa_origin_reconstructor",
      "position": { "x": 1660, "y": 300 },
      "data": { "label": "BPA Origin Reconstructor", "params": { "residual_cutoff": 30.0, "min_stains": 3 } },
      "width": 270, "height": 380
    },
    {
      "id": "stringing",
      "type": "bpa_stringing_overlay",
      "position": { "x": 1660, "y": 760 },
      "data": {
        "label": "Stringing Overlay",
        "params": {
          "line_alpha": 0.45, "line_thick": 1,
          "show_origin": true, "show_gt": true,
          "show_convergence": true, "darken_bg": false
        }
      },
      "width": 270, "height": 360
    },
    {
      "id": "convergence",
      "type": "bpa_convergence_map",
      "position": { "x": 2220, "y": 760 },
      "data": {
        "label": "Convergence Map",
        "params": { "blur_sigma": 8.0, "blend_alpha": 0.65, "threshold_pct": 85, "show_peak_marker": true }
      },
      "width": 270, "height": 300
    },
    {
      "id": "topdown",
      "type": "bpa_topdown_view",
      "position": { "x": 2220, "y": 260 },
      "data": {
        "label": "Top-Down View",
        "params": { "n_rays": 30, "fig_w": 700, "fig_h": 520, "dark_theme": true }
      },
      "width": 270, "height": 300
    },
    {
      "id": "scene3d",
      "type": "bpa_3d_scene",
      "position": { "x": 2780, "y": 260 },
      "data": {
        "label": "3D Scene",
        "params": { "n_rays": 40, "elev": 25, "azim": -60, "fig_w": 700, "fig_h": 560, "dark_theme": true }
      },
      "width": 270, "height": 340
    },
    {
      "id": "display",
